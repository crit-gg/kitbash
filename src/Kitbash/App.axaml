<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kitbash.ViewModels"
             xmlns:views="clr-namespace:Kitbash.Views"
             x:Class="Kitbash.App"
             RequestedThemeVariant="Dark">

    <!-- The look is added in code rather than here. Parsing it is the slowest thing the
         launcher does before any window exists, and the splash needs none of it, so it is
         loaded after the splash is already on screen. App.axaml.cs has the order. -->


    <!-- The settings window draws an app supplied editor as content, so its template is
         registered here rather than in the window. -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:ToolRepositoriesEditor">
            <views:ToolRepositoriesEditorView />
        </DataTemplate>
        <DataTemplate DataType="vm:CustomToolsEditor">
            <views:CustomToolsEditorView />
        </DataTemplate>
        <DataTemplate DataType="vm:ToolActionsEditor">
            <views:ToolActionsEditorView />
        </DataTemplate>
        <DataTemplate DataType="vm:WorkspaceLinksEditor">
            <views:WorkspaceLinksEditorView />
        </DataTemplate>
        <DataTemplate DataType="vm:HiddenToolsEditor">
            <views:HiddenToolsEditorView />
        </DataTemplate>
    </Application.DataTemplates>

</Application>

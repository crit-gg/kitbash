<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Both are Windows resources. Linux reads the icon from a .desktop entry and macOS
       from the bundle, and naming them for another runtime only produces a warning. An
       empty identifier is a plain build and keeps them. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../icons/icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Core rather than the meta package. The meta package carries a satellite assembly
         per language and nothing here is translated. -->
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <!-- The launcher installs and updates itself. Neither library takes this, since a
         tool never checks for its own update. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked rather than copied, so icons/ stays the one source for the app mark
         and for packaging later. -->
    <AvaloniaResource Include="../../icons/icon_*.png" Link="Assets/Icons/%(Filename)%(Extension)" />

    <!-- Brand marks for the Open in menu. Recursive, so a new subfolder needs no line here. -->
    <AvaloniaResource Include="Assets/ExternalTools/**/*.png" />
  </ItemGroup>

  <!-- What puts the default engine on PATH as godot.exe. A Windows program, so other
       runtimes leave it out. The release pack signs it with the rest of the package. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))">
    <None Include="../../vendor/scoop-better-shimexe/shim.exe"
          Link="shims/shim.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kitbash.Core\Kitbash.Core.csproj" />
    <ProjectReference Include="..\Kitbash.Ui\Kitbash.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\NewWorkspaceDialog.axaml.cs">
      <DependentUpon>NewWorkspaceDialog.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>

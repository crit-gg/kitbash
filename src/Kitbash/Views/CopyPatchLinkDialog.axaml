<ui:DialogWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="clr-namespace:Kitbash.ViewModels"
                 xmlns:ui="clr-namespace:Kitbash.Ui.Controls;assembly=Kitbash.Ui"
                 x:Class="Kitbash.Views.CopyPatchLinkDialog"
                 x:DataType="vm:CopyPatchLinkViewModel"
                 Title="Copy patch link"
                 Width="484" SizeToContent="Height"
                 FontFamily="{StaticResource FontFamilyUi}"
                 FontSize="{StaticResource FontSizeBody}">

    <Window.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="TextBlock.fieldNote">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <ui:WindowTitleBar Grid.Row="0" Title="Copy patch link" />

        <StackPanel Grid.Row="1" Margin="16,16,16,14" Spacing="18">
            <StackPanel Spacing="7">
                <TextBlock Classes="fieldLabel" Text="Patch address" />

                <TextBox Name="AddressBox"
                         Text="{Binding Address}"
                         Classes.error="{Binding HasAddressProblem}"
                         ui:Dialog.TakesFocus="True"
                         PlaceholderText="https://example.com/fix.patch" />

                <ui:Alert Form="Inline" Tier="Error"
                          Title="{Binding AddressProblem}"
                          IsOpen="{Binding HasAddressProblem}" />

                <TextBlock Classes="fieldNote"
                           Text="An https address that downloads a file from git format-patch." />
            </StackPanel>

            <StackPanel Spacing="7">
                <TextBlock Classes="fieldLabel" Text="Workspace" />

                <TextBlock Classes="fieldNote" Text="{Binding Workspace}" />

                <TextBlock Name="CommitNote" Classes="fieldNote"
                           Foreground="{DynamicResource InkMuted}"
                           Text="Named by its first commit, since nothing else names it."
                           IsVisible="{Binding IsNamedByCommit}" />
            </StackPanel>

            <ui:Alert Name="NoName" Tier="Error"
                      Title="This workspace has nothing a link can name it by."
                      Description="Add a workspace.name to its team config, or commit to its repository."
                      IsOpen="{Binding !HasLinkName}" />

            <StackPanel Spacing="7" IsVisible="{Binding HasLink}">
                <TextBlock Classes="fieldLabel" Text="Link" />

                <Border Padding="10,8"
                        Background="{DynamicResource SurfaceWell}"
                        BorderBrush="{DynamicResource LineSeam}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusControl}">
                    <SelectableTextBlock Name="LinkText"
                                         Text="{Binding Link}"
                                         FontFamily="{DynamicResource FontFamilyMono}"
                                         FontSize="{DynamicResource FontSizeSmall}"
                                         LineHeight="17"
                                         Foreground="{DynamicResource InkSecondary}"
                                         TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </StackPanel>

        <ui:DialogFooter Grid.Row="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" ui:Dialog.Role="Cancel" />

                <Button Name="CopyButton" Classes="primary" Content="Copy link" IsDefault="True"
                        IsEnabled="{Binding CanCopy}"
                        Click="OnCopyClick" />
            </StackPanel>
        </ui:DialogFooter>
    </Grid>
</ui:DialogWindow>

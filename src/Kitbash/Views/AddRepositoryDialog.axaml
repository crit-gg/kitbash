<ui:DialogWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:Kitbash.Ui.Controls;assembly=Kitbash.Ui"
                 x:Class="Kitbash.Views.AddRepositoryDialog"
                 Title="Add tool repository"
                 Width="428" SizeToContent="Height"
                 FontFamily="{StaticResource FontFamilyUi}"
                 FontSize="{StaticResource FontSizeBody}">

    <Grid RowDefinitions="Auto,*,Auto">
        <ui:WindowTitleBar Grid.Row="0" Name="Bar" Title="Add tool repository" />

        <StackPanel Grid.Row="1" Margin="16,16,16,14">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="11">
                <ui:Icon Grid.Column="0" Glyph="AlertCircle" Size="20"
                         Foreground="{DynamicResource Warn}"
                         VerticalAlignment="Top" />

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Name="Heading"
                               FontSize="{DynamicResource FontSizeSubhead}"
                               FontWeight="{DynamicResource FontWeightStrong}"
                               Foreground="{DynamicResource InkPrimary}"
                               TextWrapping="Wrap" />

                    <TextBlock Name="Body"
                               Text="A link asked for this. Kitbash will offer whatever tools it publishes, and installing one runs a program from it, so add it only if you trust whoever owns it."
                               FontSize="{DynamicResource FontSizeControl}"
                               LineHeight="19"
                               Foreground="{DynamicResource InkSecondary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- The address as evidence, so what the link really named shows itself here. -->
            <Border Margin="31,12,0,0" Padding="10,8"
                    Background="{DynamicResource SurfaceWell}"
                    BorderBrush="{DynamicResource LineSeam}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusControl}">
                <TextBlock Name="Address"
                           FontFamily="{DynamicResource FontFamilyMono}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           FontWeight="{DynamicResource FontWeightMedium}"
                           Foreground="{DynamicResource InkPrimary}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <ui:DialogFooter Grid.Row="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" ui:Dialog.Role="Cancel" />
                <Button Name="Primary" Content="Add repository" Classes="primary" ui:Dialog.Role="Accept" />
            </StackPanel>
        </ui:DialogFooter>
    </Grid>
</ui:DialogWindow>

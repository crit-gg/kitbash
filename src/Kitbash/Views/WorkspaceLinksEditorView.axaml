<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kitbash.ViewModels"
             xmlns:ui="clr-namespace:Kitbash.Ui.Controls;assembly=Kitbash.Ui"
             x:Class="Kitbash.Views.WorkspaceLinksEditorView"
             x:DataType="vm:WorkspaceLinksEditor"
             x:CompileBindings="True">

    <!-- A list already on a page, so the grid drops the rule, the stripe and the header
         fill. Double click a cell to change it, Escape puts the row back. -->
    <ui:DataGrid Classes="plain"
                 MaxHeight="220"
                 ItemsSource="{Binding Grid}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}">
        <ui:DataGrid.Toolbar>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Button Theme="{StaticResource CompactButton}"
                        Command="{Binding AddCommand}"
                        IsEnabled="{Binding IsPageWritable}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:Icon Glyph="Plus" Size="{DynamicResource IconSizeStatus}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Add link" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Theme="{StaticResource CompactButton}"
                        Command="{Binding RemoveCommand}"
                        IsEnabled="{Binding CanRemove}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:Icon Glyph="Trash" Size="{DynamicResource IconSizeStatus}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Remove" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ui:DataGrid.Toolbar>

        <ui:DataGrid.Columns>
            <ui:GridColumn Header="Icon" Width="150">
                <ui:GridColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WorkspaceLinkRowViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:Icon Glyph="{Binding Icon.Glyph}"
                                     Size="{DynamicResource IconSizeStatus}"
                                     Foreground="{DynamicResource InkRail}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Icon.Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ui:GridColumn.CellTemplate>
                <ui:GridColumn.EditTemplate>
                    <DataTemplate x:DataType="vm:WorkspaceLinkRowViewModel">
                        <ComboBox ItemsSource="{Binding Icons}"
                                  SelectedItem="{Binding Icon, Mode=TwoWay}"
                                  AutomationProperties.Name="Link icon">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkspaceLinkIcon">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ui:Icon Glyph="{Binding Glyph}"
                                                 Size="{DynamicResource IconSizeSmall}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DataTemplate>
                </ui:GridColumn.EditTemplate>
            </ui:GridColumn>

            <ui:GridColumn Header="Name" Width="*" IsStrong="True">
                <ui:GridColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WorkspaceLinkRowViewModel">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ui:TextTip.Shows="True" />
                    </DataTemplate>
                </ui:GridColumn.CellTemplate>
                <ui:GridColumn.EditTemplate>
                    <DataTemplate x:DataType="vm:WorkspaceLinkRowViewModel">
                        <TextBox Text="{Binding Label, Mode=TwoWay}"
                                 PlaceholderText="Design docs"
                                 AutomationProperties.Name="Link name" />
                    </DataTemplate>
                </ui:GridColumn.EditTemplate>
            </ui:GridColumn>

            <ui:GridColumn Header="Address" Width="2*" IsMono="True">
                <ui:GridColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WorkspaceLinkRowViewModel">
                        <TextBlock Text="{Binding Address}" VerticalAlignment="Center"
                                   Classes.error="{Binding !IsValid}"
                                   ToolTip.Tip="{Binding Problem}"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ui:GridColumn.CellTemplate>
                <ui:GridColumn.EditTemplate>
                    <DataTemplate x:DataType="vm:WorkspaceLinkRowViewModel">
                        <TextBox Text="{Binding Address, Mode=TwoWay}"
                                 Classes.error="{Binding !IsValid}"
                                 PlaceholderText="https://example.com/design"
                                 AutomationProperties.Name="Link address" />
                    </DataTemplate>
                </ui:GridColumn.EditTemplate>
            </ui:GridColumn>
        </ui:DataGrid.Columns>
    </ui:DataGrid>
</UserControl>

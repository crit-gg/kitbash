<ui:DialogWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="clr-namespace:Kitbash.ViewModels"
                 xmlns:tools="clr-namespace:Kitbash.Tools"
                 xmlns:ui="clr-namespace:Kitbash.Ui.Controls;assembly=Kitbash.Ui"
                 x:Class="Kitbash.Views.ToolInputsDialog"
                 x:DataType="vm:ToolInputsViewModel"
                 Title="Run tool"
                 Width="484" SizeToContent="Height"
                 FontFamily="{StaticResource FontFamilyUi}"
                 FontSize="{StaticResource FontSizeBody}">

    <Window.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="TextBlock.fieldNote">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.fieldError">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource Error}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <ui:WindowTitleBar Grid.Row="0" Title="{Binding $parent[Window].Title}" />

        <!-- A form with many fields scrolls rather than growing past the screen. The
             window is sized to its content up to that height. -->
        <ScrollViewer Grid.Row="1" MaxHeight="420">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="16,16,16,14">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolInputRowViewModel">
                        <StackPanel Spacing="7" Margin="0,0,0,18">
                            <TextBlock Classes="fieldLabel" Text="{Binding Name}" />

                            <Panel>
                                <TextBox IsVisible="{Binding IsText}"
                                         Text="{Binding Text, Mode=TwoWay}" />

                                <ui:PathField IsVisible="{Binding IsPath}"
                                              Target="{Binding PathTarget}"
                                              Path="{Binding Text, Mode=TwoWay}"
                                              DialogTitle="{Binding Name}" />

                                <NumericUpDown Width="160" HorizontalAlignment="Left"
                                               IsVisible="{Binding IsNumber}"
                                               Value="{Binding Number, Mode=TwoWay}"
                                               Increment="{Binding Step}"
                                               Minimum="{Binding Minimum}"
                                               Maximum="{Binding Maximum}" />

                                <ComboBox MinWidth="212" HorizontalAlignment="Left"
                                          IsVisible="{Binding IsChoice}"
                                          ItemsSource="{Binding Options}"
                                          SelectedItem="{Binding Chosen, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="tools:ToolInputChoice">
                                            <TextBlock Text="{Binding Label}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ToggleSwitch HorizontalAlignment="Left"
                                              IsVisible="{Binding IsBoolean}"
                                              IsChecked="{Binding Flag, Mode=TwoWay}" />
                            </Panel>

                            <TextBlock Classes="fieldNote"
                                       IsVisible="{Binding HasDescription}"
                                       Text="{Binding Description}" />

                            <TextBlock Classes="fieldError"
                                       IsVisible="{Binding HasMessage}"
                                       Text="{Binding Message}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ui:DialogFooter Grid.Row="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" ui:Dialog.Role="Cancel" />

                <Button Classes="primary" Content="Run" ui:Dialog.Role="Accept"
                        IsEnabled="{Binding CanRun}" />
            </StackPanel>
        </ui:DialogFooter>
    </Grid>
</ui:DialogWindow>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kitbash.ViewModels"
             x:Class="Kitbash.Views.HiddenToolsEditorView"
             x:DataType="vm:HiddenToolsEditor"
             x:CompileBindings="True">

    <StackPanel Spacing="7">
        <!-- A well, so the rows read as one list rather than as loose fields. Same fill
             the read only lists on this page use. -->
        <Border Background="{DynamicResource SurfaceRowAlt}"
                BorderBrush="{DynamicResource LineControlOff}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusControl}"
                Padding="7"
                IsVisible="{Binding !IsEmpty}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HiddenToolRowViewModel">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                            <!-- Two builds of one IDE read the same, so the program is what
                                 tells them apart, and it is long enough to be a tip. -->
                            <!-- Transparent rather than no background, or the text is not
                                 hit tested and the pointer never reaches the tip. -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       ToolTip.Tip="{Binding Program}"
                                       Background="Transparent"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource InkPrimary}" />

                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsOffered, Mode=TwoWay}"
                                          IsEnabled="{Binding CanEdit}"
                                          AutomationProperties.Name="{Binding Name}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Text="Kitbash found nothing on this machine to open a workspace in."
                   IsVisible="{Binding IsEmpty}"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource InkMuted}" />

        <TextBlock Text="A tool turned off keeps its answer if it is uninstalled and put back."
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{DynamicResource InkMuted}" />
    </StackPanel>
</UserControl>

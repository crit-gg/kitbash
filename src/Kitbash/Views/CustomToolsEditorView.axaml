<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kitbash.ViewModels"
             xmlns:ui="clr-namespace:Kitbash.Ui.Controls;assembly=Kitbash.Ui"
             x:Class="Kitbash.Views.CustomToolsEditorView"
             x:DataType="vm:CustomToolsEditor"
             x:CompileBindings="True">

    <StackPanel Spacing="7">
        <!-- A well, so the rows read as one list rather than as loose fields. Same fill
             the read only lists on this page use. -->
        <Border Background="{DynamicResource SurfaceRowAlt}"
                BorderBrush="{DynamicResource LineControlOff}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusControl}"
                Padding="7"
                IsVisible="{Binding !IsEmpty}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomToolRowViewModel">
                        <StackPanel Spacing="3">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
                                <TextBox Grid.Column="0" Width="116"
                                         Text="{Binding Name, Mode=TwoWay}"
                                         IsEnabled="{Binding CanEdit}"
                                         PlaceholderText="Name"
                                         AutomationProperties.Name="Tool name" />

                                <ui:PathField Grid.Column="1"
                                              Target="File"
                                              IsCompact="True"
                                              Path="{Binding Path, Mode=TwoWay}"
                                              IsEnabled="{Binding CanEdit}"
                                              AutomationProperties.Name="Program to run" />

                                <TextBox Grid.Column="2" Width="150"
                                         Classes="mono"
                                         Text="{Binding Arguments, Mode=TwoWay}"
                                         IsEnabled="{Binding CanEdit}"
                                         PlaceholderText="{}{workspace}"
                                         AutomationProperties.Name="Arguments" />

                                <Button Grid.Column="3" Classes="icon"
                                        Width="26" Height="26"
                                        Command="{Binding RemoveCommand}"
                                        IsEnabled="{Binding CanEdit}"
                                        ToolTip.Tip="Take this tool off the list"
                                        AutomationProperties.Name="Take this tool off the list">
                                    <ui:Icon Glyph="X" Size="13" />
                                </Button>
                            </Grid>

                            <ui:Alert Tier="Error" Form="Inline"
                                      IsVisible="{Binding HasProblem}"
                                      Title="{Binding Problem}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Text="No tools of your own, so the menu offers only what Kitbash found."
                   IsVisible="{Binding IsEmpty}"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource InkMuted}" />

        <TextBlock Text="Arguments are optional. Blank passes the workspace folder, and {workspace} places it yourself."
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{DynamicResource InkMuted}" />

        <Button Classes="ghost"
                Command="{Binding AddCommand}"
                IsEnabled="{Binding IsPageWritable}"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Icon Glyph="Plus" VerticalAlignment="Center" />
                <TextBlock Text="Add tool" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>

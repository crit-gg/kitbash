<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kitbash.ViewModels"
             xmlns:ui="clr-namespace:Kitbash.Ui.Controls;assembly=Kitbash.Ui"
             x:Class="Kitbash.Views.CustomToolsEditorView"
             x:DataType="vm:CustomToolsEditor"
             x:CompileBindings="True">

    <StackPanel Spacing="7">
        <!-- A list already on a page, so the grid drops the rule, the stripe and the
             header fill. Double click a cell to change it, Escape puts the row back. -->
        <ui:DataGrid Classes="plain"
                     MaxHeight="220"
                     ItemsSource="{Binding Grid}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}">
            <ui:DataGrid.Toolbar>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Button Theme="{StaticResource CompactButton}"
                            Command="{Binding AddCommand}"
                            IsEnabled="{Binding IsPageWritable}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:Icon Glyph="Plus" Size="{DynamicResource IconSizeStatus}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Add tool" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Theme="{StaticResource CompactButton}"
                            Command="{Binding RemoveCommand}"
                            IsEnabled="{Binding CanRemove}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:Icon Glyph="Trash" Size="{DynamicResource IconSizeStatus}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Remove" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ui:DataGrid.Toolbar>

            <ui:DataGrid.Columns>
                <ui:GridColumn Header="Name" Width="150" IsStrong="True">
                    <ui:GridColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:CustomToolRowViewModel">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       Classes.error="{Binding !IsValid}"
                                       ToolTip.Tip="{Binding Problem}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ui:GridColumn.CellTemplate>
                    <ui:GridColumn.EditTemplate>
                        <DataTemplate x:DataType="vm:CustomToolRowViewModel">
                            <TextBox Text="{Binding Name, Mode=TwoWay}"
                                     PlaceholderText="Name"
                                     AutomationProperties.Name="Tool name" />
                        </DataTemplate>
                    </ui:GridColumn.EditTemplate>
                </ui:GridColumn>

                <ui:GridColumn Header="Program" Width="*" IsMono="True">
                    <ui:GridColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:CustomToolRowViewModel">
                            <TextBlock Text="{Binding Path}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ui:TextTip.Shows="True" />
                        </DataTemplate>
                    </ui:GridColumn.CellTemplate>
                    <ui:GridColumn.EditTemplate>
                        <DataTemplate x:DataType="vm:CustomToolRowViewModel">
                            <ui:PathField Target="File"
                                          IsCompact="True"
                                          Path="{Binding Path, Mode=TwoWay}"
                                          AutomationProperties.Name="Program to run" />
                        </DataTemplate>
                    </ui:GridColumn.EditTemplate>
                </ui:GridColumn>

                <ui:GridColumn Header="Arguments" Width="170" IsMono="True">
                    <ui:GridColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:CustomToolRowViewModel">
                            <TextBlock Text="{Binding Arguments}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ui:GridColumn.CellTemplate>
                    <ui:GridColumn.EditTemplate>
                        <DataTemplate x:DataType="vm:CustomToolRowViewModel">
                            <TextBox Text="{Binding Arguments, Mode=TwoWay}"
                                     PlaceholderText="{}{workspace}"
                                     AutomationProperties.Name="Arguments" />
                        </DataTemplate>
                    </ui:GridColumn.EditTemplate>
                </ui:GridColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <TextBlock Text="Arguments are optional. Blank passes the workspace folder, and {workspace} places it yourself."
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{DynamicResource InkMuted}" />
    </StackPanel>
</UserControl>

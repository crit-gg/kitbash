<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Kitbash.ViewModels"
             xmlns:ui="clr-namespace:Kitbash.Ui.Controls;assembly=Kitbash.Ui"
             x:Class="Kitbash.Views.ToolRepositoriesEditorView"
             x:DataType="vm:ToolRepositoriesEditor"
             x:CompileBindings="True">

    <StackPanel Spacing="7">
        <!-- A well, so the rows read as one list rather than as loose fields. Same fill
             the read only lists on this page use. -->
        <Border Background="{DynamicResource SurfaceRowAlt}"
                BorderBrush="{DynamicResource LineControlOff}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusControl}"
                Padding="7"
                IsVisible="{Binding !IsEmpty}">
            <!-- A field's focus halo reaches outside the field, and an ItemsControl clips
                 to its bounds, which would cut it off along every row. -->
            <ItemsControl ItemsSource="{Binding Rows}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolRepositoryRowViewModel">
                        <StackPanel Spacing="3">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                                <ComboBox Grid.Column="0" Width="116"
                                          ItemsSource="{Binding Kinds}"
                                          SelectedItem="{Binding Kind, Mode=TwoWay}"
                                          IsEnabled="{Binding CanEdit}"
                                          AutomationProperties.Name="Repository kind" />

                                <TextBox Grid.Column="1"
                                         Text="{Binding Address, Mode=TwoWay}"
                                         Classes.error="{Binding HasProblem}"
                                         IsEnabled="{Binding CanEdit}"
                                         PlaceholderText="https://github.com/owner/repository"
                                         AutomationProperties.Name="Repository address" />

                                <Button Grid.Column="2" Classes="icon"
                                        Width="26" Height="26"
                                        Command="{Binding RemoveCommand}"
                                        IsEnabled="{Binding CanEdit}"
                                        ToolTip.Tip="Take this repository off the list"
                                        AutomationProperties.Name="Take this repository off the list">
                                    <ui:Icon Glyph="X" Size="13" />
                                </Button>
                            </Grid>

                            <ui:Alert Tier="Error" Form="Inline"
                                      IsVisible="{Binding HasProblem}"
                                      Title="{Binding Problem}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Text="No repositories, so no tool is offered."
                   IsVisible="{Binding IsEmpty}"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource InkMuted}" />

        <Button Classes="ghost"
                Command="{Binding AddCommand}"
                IsEnabled="{Binding IsPageWritable}"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Icon Glyph="Plus" VerticalAlignment="Center" />
                <TextBlock Text="Add repository" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>

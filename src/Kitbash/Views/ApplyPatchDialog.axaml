<ui:DialogWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="clr-namespace:Kitbash.ViewModels"
                 xmlns:ui="clr-namespace:Kitbash.Ui.Controls;assembly=Kitbash.Ui"
                 x:Class="Kitbash.Views.ApplyPatchDialog"
                 x:DataType="vm:ApplyPatchViewModel"
                 Title="Apply patch"
                 Width="484" SizeToContent="Height"
                 FontFamily="{StaticResource FontFamilyUi}"
                 FontSize="{StaticResource FontSizeBody}">

    <Window.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="TextBlock.fieldNote">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <ui:WindowTitleBar Grid.Row="0" Title="Apply patch" />

        <StackPanel Grid.Row="1" Margin="16,16,16,14" Spacing="18">
            <ui:Alert Tier="Warn"
                      Title="Changes you had before applying a patch were set aside."
                      Description="{Binding SetAsideDetail}"
                      IsOpen="{Binding HasSetAside}">
                <ui:Alert.Actions>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="RestoreButton" Theme="{StaticResource CompactButton}" Classes="warn"
                                Content="Put them back"
                                IsEnabled="{Binding CanEdit}"
                                Click="OnRestoreClick" />
                    </StackPanel>
                </ui:Alert.Actions>
            </ui:Alert>

            <StackPanel Spacing="7">
                <TextBlock Classes="fieldLabel" Text="Patch file" />

                <ui:PathField Name="PatchField"
                              Target="File"
                              Path="{Binding PatchFile}"
                              Problem="{Binding FileProblem}"
                              IsEnabled="{Binding CanEdit}"
                              DialogTitle="Choose a patch file"
                              ui:Dialog.TakesFocus="True">
                    <ui:PathField.Filters>
                        <ui:PathFilter Name="Patch files" Extensions=".patch, .diff" />
                    </ui:PathField.Filters>
                </ui:PathField>
            </StackPanel>

            <StackPanel Spacing="7" IsVisible="{Binding HasPreview}">
                <TextBlock Classes="fieldLabel" Text="{Binding FilesHeading}" />

                <Border Padding="10,8"
                        Background="{DynamicResource SurfaceWell}"
                        BorderBrush="{DynamicResource LineSeam}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusControl}">
                    <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Name="PathList" ItemsSource="{Binding Paths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}"
                                               FontFamily="{DynamicResource FontFamilyMono}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               LineHeight="17"
                                               Foreground="{DynamicResource InkSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               ui:TextTip.Shows="True" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <TextBlock Classes="fieldLabel" Text="Commit" Margin="0,7,0,0" />

                <TextBlock Name="SubjectText" Classes="fieldNote" Text="{Binding Subject}" />
            </StackPanel>

            <ui:Alert Tier="{Binding NoticeTier}"
                      Title="{Binding Notice}"
                      Description="{Binding NoticeDetail}"
                      IsOpen="{Binding HasNotice}">
                <ui:Alert.Actions>
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding HasDetails}">
                        <Button Name="CopyDetails" Theme="{StaticResource CompactButton}"
                                Content="Copy details"
                                Click="OnCopyClick" />
                    </StackPanel>
                </ui:Alert.Actions>
            </ui:Alert>

            <StackPanel Spacing="8" IsVisible="{Binding IsWorking}">
                <ProgressBar IsIndeterminate="True" />

                <TextBlock Classes="fieldNote" Text="Applying" />
            </StackPanel>
        </StackPanel>

        <!-- Neither button carries a role. Apply closes only once the patch has landed, and
             Cancel does nothing while git runs, since stopping part way is what could leave
             work set aside. -->
        <ui:DialogFooter Grid.Row="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" IsCancel="True"
                        IsEnabled="{Binding CanEdit}"
                        Click="OnCancelClick" />

                <Button Name="ApplyButton" Classes="primary" Content="Apply" IsDefault="True"
                        IsEnabled="{Binding CanApply}"
                        Click="OnApplyClick" />
            </StackPanel>
        </ui:DialogFooter>
    </Grid>
</ui:DialogWindow>

<ui:DialogWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:Workbench.Ui.Controls;assembly=Workbench.Ui"
                 x:Class="Workbench.Views.UninstallDialog"
                 Title="Uninstall engine"
                 Width="428" SizeToContent="Height"
                 FontFamily="{StaticResource FontFamilyUi}"
                 FontSize="{StaticResource FontSizeBody}">

    <Grid RowDefinitions="Auto,*,Auto">
        <ui:WindowTitleBar Grid.Row="0" Title="Uninstall engine" />

        <StackPanel Grid.Row="1" Margin="16,16,16,14">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="11">
                <ui:Icon Grid.Column="0" Glyph="AlertTriangle" Size="20"
                         Foreground="{DynamicResource Error}"
                         VerticalAlignment="Top" />

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Name="Heading"
                               FontSize="{DynamicResource FontSizeSubhead}"
                               FontWeight="{DynamicResource FontWeightStrong}"
                               Foreground="{DynamicResource InkPrimary}"
                               TextWrapping="Wrap" />

                    <TextBlock Name="Body"
                               FontSize="{DynamicResource FontSizeControl}"
                               LineHeight="19"
                               Foreground="{DynamicResource InkSecondary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- The path and the size as evidence, in a well, so what is about to go is on
                 screen rather than described. -->
            <Border Margin="31,12,0,0" Padding="10,8"
                    Background="{DynamicResource SurfaceWell}"
                    BorderBrush="{DynamicResource LineSeam}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusControl}">
                <StackPanel Spacing="5">
                    <!-- The one place a path is shown whole, and it wraps rather than eliding. -->
                    <TextBlock Name="Path"
                               FontFamily="{DynamicResource FontFamilyMono}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               FontWeight="{DynamicResource FontWeightMedium}"
                               Foreground="{DynamicResource InkPrimary}"
                               TextWrapping="Wrap" />

                    <TextBlock Name="Size"
                               FontFamily="{DynamicResource FontFamilyMono}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               FontWeight="{DynamicResource FontWeightMedium}"
                               Foreground="{DynamicResource InkMuted}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Enter and Escape are Avalonia's, since a role sets IsDefault and IsCancel.
             Cancel is marked ready, because the accepting answer here destroys something. -->
        <ui:DialogFooter Grid.Row="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" ui:Dialog.Role="Cancel" ui:Dialog.TakesFocus="True" />
                <Button Name="Confirm" Classes="danger" ui:Dialog.Role="Accept" />
            </StackPanel>
        </ui:DialogFooter>
    </Grid>
</ui:DialogWindow>

<ui:ChromelessWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Workbench.ViewModels"
        xmlns:ui="clr-namespace:Workbench.Ui.Controls;assembly=Workbench.Ui"
        xmlns:views="clr-namespace:Workbench.Views"
        x:Class="Workbench.Views.LauncherWindow"
        x:DataType="vm:LauncherViewModel"
        Title="Workbench"
        Icon="avares://Workbench/Assets/Icons/icon_256x256.png"
        Width="964" Height="724"
        MinWidth="844" MinHeight="584"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FontFamilyUi}"
        FontSize="{StaticResource FontSizeBody}">

    <!-- The size is 24 more than the design's 940 by 700 on each axis, because the window
         carries a 12px transparent gutter on every side for its shadow to fall into. The
         visible frame is the design size. -->

    <Window.Styles>
        <!-- Launcher layout only. Every control look comes from Workbench.Ui, so nothing
             here sets a brush, a radius or a size that belongs to a control. -->
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        </Style>

        <!-- The bands. SurfaceRoot at top and bottom brackets the SurfaceNest1 middle,
             which is the depth rule doing its job rather than a decision. -->
        <Style Selector="Border.band">
            <Setter Property="Background" Value="{DynamicResource SurfaceRoot}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
        </Style>

        <!-- The page and the cards on it ride the depth ramp rather than naming a tone,
             so the page is one step below the window and a card one below the page. They
             land on the same two pairs that were written here by hand, and now anything
             dropped into the page is on the tone the page really is. -->
        <Style Selector="Border.page">
            <Setter Property="(ui:Surface.Nests)" Value="True" />
        </Style>

        <!-- A tool card. A card is a surface rather than a control, so it is styled
             here and its contents are library controls. -->
        <Style Selector="Border.toolCard">
            <Setter Property="(ui:Surface.Nests)" Value="True" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
            <Setter Property="Padding" Value="15,14" />
        </Style>

        <Style Selector="Border.engineMark">
            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        </Style>

        <Style Selector="Border.toolMark">
            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
        </Style>

        <!-- A row in the workspace list. Full bleed rather than an inset pill, because it
             carries two lines and a badge, which is the rule stage 5 recorded. -->
        <Style Selector="Border.workspaceRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="13,10" />
        </Style>

        <Style Selector="Border.workspaceRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
        </Style>

        <Style Selector="Border.workspaceRow.current">
            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
        </Style>

        <!-- The open row hovers too. Both selectors bind at the same precedence, so the
             later one wins and without this the current row would be the one row in the
             list that does not answer the pointer. -->
        <Style Selector="Border.workspaceRow.current:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentTintStrong}" />
        </Style>

        <!-- The state square beside a workspace, and the one in the selector. -->
        <Style Selector="Border.stateMark">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMark}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Ok}" />
        </Style>

        <Style Selector="Border.stateMark.local">
            <Setter Property="Background" Value="{DynamicResource InkSecondary}" />
        </Style>

        <Style Selector="Border.stateMark.missing">
            <Setter Property="Background" Value="{DynamicResource Error}" />
        </Style>

        <Style Selector="TextBlock.rowAction">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.rowAction.inert">
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>

        <!-- The list being built at launch so the first real open is not the slow one. See
             LauncherWindow.OnOpened. Nothing is drawn while that happens. -->
        <Style Selector="FlyoutPresenter.warming">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- The status bar readouts, the count classes and the conflict chip all come from
             Workbench.Ui, so a tool's status bar reads the same as this one. -->
    </Window.Styles>

    <!-- the frame, the shadow and the resize grips come from Workbench.Ui -->
    <Grid RowDefinitions="Auto,*">

        <!-- The launcher adds nothing of its own to the chrome, so this row disappears
             entirely when the desktop draws the frame. -->
        <ui:WindowTitleBar Grid.Row="0" Title="Workbench"
                           Icon="avares://Workbench/Assets/Icons/icon_64x64.png" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

            <!-- The rail. Selection, keyboard navigation and the selected state all come
                 from ListBox. Only the workspace page exists, so the other two are here
                 and disabled rather than absent, which is what the design shows. -->
            <!-- The rail. Selection, keyboard navigation and the selected state all come
                 from ListBox, so what the library supplies is a look.

                 Two groups rather than one, because the settings item sits at the foot and
                 the items panel cannot be changed from a theme. Both groups draw the same
                 ground and the same seam, so they read as one rail. -->
            <DockPanel Grid.Column="0">
                <ListBox DockPanel.Dock="Bottom" Name="RailFoot"
                         Theme="{StaticResource ActivityRail}"
                         Padding="0,0,0,8"
                         SelectedIndex="-1">
                    <ListBoxItem Theme="{StaticResource ActivityRailItem}"
                                 IsEnabled="False"
                                 ToolTip.Tip="Settings" ToolTip.Placement="Right"
                                 AutomationProperties.Name="Settings">
                        <ui:Icon Glyph="Cog" Size="{DynamicResource IconSizeLarge}" />
                    </ListBoxItem>
                </ListBox>

                <ListBox DockPanel.Dock="Top" Name="Rail"
                         Theme="{StaticResource ActivityRail}"
                         Padding="0,8,0,0"
                         VerticalAlignment="Stretch"
                         SelectedIndex="{Binding Page, Mode=TwoWay}">
                    <ListBoxItem Theme="{StaticResource ActivityRailItem}"
                                 ToolTip.Tip="Workspace" ToolTip.Placement="Right"
                                 AutomationProperties.Name="Workspace">
                        <ui:Icon Glyph="Window" Size="{DynamicResource IconSizeLarge}" />
                    </ListBoxItem>

                    <ListBoxItem Theme="{StaticResource ActivityRailItem}"
                                 ToolTip.Tip="Godot engines" ToolTip.Placement="Right"
                                 AutomationProperties.Name="Godot engines">
                        <ui:Icon Glyph="Godot" Size="{DynamicResource IconSizeLarge}" />
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <!-- The pages the rail opens. Both are built and only one is shown, so
                 switching costs nothing and neither page reloads on the way back. The
                 settings page is its own piece of work and its rail item stays disabled. -->
            <Panel Grid.Column="1">
              <Panel IsVisible="{Binding OnWorkspacePage}">
                <Grid IsVisible="{Binding HasWorkspaces}" RowDefinitions="Auto,Auto,*,Auto">

                    <!-- workspace bar -->
                    <Border Grid.Row="0" Classes="band" BorderThickness="0,0,0,1"
                            Padding="20,14,20,13">
                        <DropDownButton Name="WorkspaceSelector"
                                        HorizontalAlignment="Left"
                                        MinWidth="266" Height="40"
                                        HorizontalContentAlignment="Stretch">
                            <DropDownButton.Flyout>
                                <!-- The list covers the page, so the page is put aside
                                     rather than merely overlapped. -->
                                <Flyout Placement="BottomEdgeAlignedLeft"
                                        FlyoutPresenterClasses="popover"
                                        ui:Dimmer.Dims="True">
                                    <ui:Popover Width="436" Header="WORKSPACES">
                                        <ScrollViewer MaxHeight="296"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Workspaces}" Margin="0,5">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:WorkspaceViewModel">
                                                        <Border Classes="workspaceRow"
                                                                Classes.current="{Binding IsCurrent}"
                                                                Tapped="OnWorkspaceTapped">
                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="11">
                                                                <Border Grid.Column="0" Classes="stateMark"
                                                                        Classes.local="{Binding IsLocal}"
                                                                        Classes.missing="{Binding IsMissing}" />

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontSize="{DynamicResource FontSizeTitle}"
                                                                                   FontWeight="{DynamicResource FontWeightStrong}"
                                                                                   Foreground="{DynamicResource InkPrimary}"
                                                                                   VerticalAlignment="Center" />
                                                                        <ui:Badge Content="{Binding Badge}"
                                                                                  IsVisible="{Binding HasBadge}" />
                                                                    </StackPanel>
                                                                    <TextBlock Classes="mono" Text="{Binding Path}"
                                                                               Margin="0,4,0,0"
                                                                               FontSize="{DynamicResource FontSizeBody}"
                                                                               Foreground="{DynamicResource InkSecondary}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="2" Classes="rowAction"
                                                                           Classes.inert="{Binding !CanSwitch}"
                                                                           Text="{Binding Action}" />

                                                                <Button Grid.Column="3" Classes="icon"
                                                                        ToolTip.Tip="More"
                                                                        AutomationProperties.Name="More">
                                                                    <ui:Icon Glyph="DotsVerticalRounded" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <ui:Popover.Footer>
                                            <!-- A library button rather than a menu item.
                                                 The row is one action, not a menu, and the
                                                 ghost kind is what a button with no fill
                                                 already looks like here. -->
                                            <Button Classes="ghost"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Click="OnAddWorkspaceClick">
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <ui:Icon Glyph="FolderOpen" VerticalAlignment="Center" />
                                                    <TextBlock Text="Add workspace from folder"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </ui:Popover.Footer>
                                    </ui:Popover>
                                </Flyout>
                            </DropDownButton.Flyout>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Grid.Column="0" Classes="stateMark" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WorkspaceName}"
                                               FontSize="{DynamicResource FontSizeSubhead}"
                                               FontWeight="{DynamicResource FontWeightStrong}"
                                               Foreground="{DynamicResource InkPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="mono" Text="{Binding WorkspaceSubtitle}"
                                               Margin="0,3,0,0"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource InkSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DropDownButton>
                    </Border>

                    <!-- The engine strip. Every value in it is invented for now, which
                         is deliberate and temporary. EngineViewModel says which fields
                         are already readable from project.godot and which need engine
                         discovery. -->
                    <Border Grid.Row="1" Classes="page" BorderThickness="0,0,0,1"
                            Height="56" Padding="20,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                            <Border Grid.Column="0" Classes="engineMark"
                                    Width="28" Height="28" VerticalAlignment="Center">
                                <TextBlock Classes="mono" Text="GD"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           FontWeight="{DynamicResource FontWeightStrong}"
                                           Foreground="{DynamicResource AccentTintInk}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Engine.Version}"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               FontWeight="{DynamicResource FontWeightStrong}"
                                               Foreground="{DynamicResource InkPrimary}"
                                               VerticalAlignment="Center" />

                                    <!-- A runtime is a fact rather than a status, which is
                                         why it is the data tier and carries a dot. -->
                                    <ui:Badge Tier="Data" HasDot="True"
                                              Content="{Binding Engine.Runtime}"
                                              IsVisible="{Binding Engine.HasRuntime}" />

                                    <ui:Badge Tier="{Binding Engine.BadgeTier}"
                                              Content="{Binding Engine.StateLabel}"
                                              IsVisible="{Binding Engine.HasState}" />
                                </StackPanel>

                                <TextBlock Classes="mono" Text="{Binding Engine.Note}"
                                           Margin="0,4,0,0"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource InkSecondary}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <SplitButton Grid.Column="2"
                                         Classes.primary="{Binding Engine.IsMatched}"
                                         Classes.warn="{Binding Engine.IsMismatch}"
                                         Classes.danger="{Binding Engine.IsMissing}"
                                         Content="{Binding Engine.Action}"
                                         VerticalAlignment="Center">
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Open project folder" />
                                        <MenuItem Header="Edit project.godot" />
                                        <MenuItem Header="Manage engine installs" />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                        </Grid>
                    </Border>

                    <!-- tools -->
                    <Border Grid.Row="2" Classes="page" BorderThickness="0">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,16,20,18">
                                <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                        Header="TOOLS" Margin="0,0,0,11" />

                                <ItemsControl ItemsSource="{Binding Tools}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ToolCardViewModel">
                                            <Border Classes="toolCard">
                                                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="15">
                                                    <!-- The square holds the tool's icon. The
                                                         design draws a letter there and that is
                                                         a placeholder, so it stays empty until a
                                                         tool supplies one. -->
                                                    <Border Grid.Column="0" Classes="toolMark"
                                                            Width="48" Height="48"
                                                            VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="{DynamicResource FontSizeCardTitle}"
                                                                   FontWeight="{DynamicResource FontWeightStrong}"
                                                                   Foreground="{DynamicResource InkPrimary}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Margin="0,6,0,0"
                                                                   FontSize="{DynamicResource FontSizeControl}"
                                                                   LineHeight="17.4"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource InkSecondary}" />
                                                    </StackPanel>

                                                    <Button Grid.Column="2" Classes="primary"
                                                            Content="Launch"
                                                            VerticalAlignment="Center"
                                                            Click="OnLaunchToolClick" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- The status bar. Two of them, one row, and which one shows is
                         whether the workspace is a repository. Everything in the git one is
                         read from the repository and kept current by the monitor. -->
                    <!-- Less room on the right, because the button there brings its own. -->
                    <Border Grid.Row="3" Classes="band" BorderThickness="0,1,0,0"
                            Height="{DynamicResource HeightTitleBar}" Padding="16,0,12,0">
                        <Panel>
                            <!-- Not a repository, so there is no branch and no history to
                                 report. The path is all there is to say. -->
                            <TextBlock Classes="mono" Text="{Binding WorkspaceSubtitle}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource InkMuted}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding !Git.IsRepository}" />

                            <!-- Two groups, because they answer two questions. Left is
                                 identity: which branch this is and what has changed in it.
                                 Right is this branch against its remote, and the one action
                                 the launcher offers. -->
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14"
                                  IsVisible="{Binding Git.IsRepository}">

                                <!-- A readout and nothing more. No border, no chevron and no
                                     hover, because switching branches belongs to a git tool
                                     and this only says where you are. -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <ui:Icon Glyph="GitBranch" Size="{DynamicResource IconSizeStatus}"
                                             Foreground="{DynamicResource InkSecondary}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Classes="branch" Text="{Binding Git.Branch}"
                                               MaxWidth="260" />
                                </StackPanel>

                                <!-- What has changed here. Each count carries its own glyph,
                                     so none of them says its meaning in colour alone. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14"
                                            VerticalAlignment="Center">
                                    <StackPanel Classes="countReadout" IsVisible="{Binding Git.HasModified}">
                                        <ui:Icon Classes="countMark" Glyph="Save"
                                                 Foreground="{DynamicResource Warn}" />
                                        <TextBlock Classes="count" Text="{Binding Git.Modified}" />
                                        <TextBlock Classes="countLabel" Text="modified" />
                                    </StackPanel>

                                    <StackPanel Classes="countReadout" IsVisible="{Binding Git.HasStaged}">
                                        <ui:Icon Classes="countMark" Glyph="Check"
                                                 Foreground="{DynamicResource Ok}" />
                                        <TextBlock Classes="count" Text="{Binding Git.Staged}" />
                                        <TextBlock Classes="countLabel" Text="staged" />
                                    </StackPanel>

                                    <!-- A conflict blocks work where everything else here is
                                         only worth knowing, so it leaves the row of counts
                                         and takes a tinted chip. Still a readout. -->
                                    <Border Classes="conflictChip" IsVisible="{Binding Git.HasConflicted}">
                                        <StackPanel Classes="countReadout">
                                            <ui:Icon Classes="countMark" Glyph="AlertTriangle"
                                                     Foreground="{DynamicResource Error}" />
                                            <TextBlock Classes="count" Text="{Binding Git.Conflicted}" />
                                            <TextBlock Classes="countLabel" Text="{Binding Git.ConflictWord}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="14"
                                            VerticalAlignment="Center">
                                    <StackPanel Classes="countReadout" IsVisible="{Binding Git.HasAhead}">
                                        <ui:Icon Classes="countMark" Glyph="ChevronUp"
                                                 Foreground="{DynamicResource InkSecondary}" />
                                        <TextBlock Classes="count" Text="{Binding Git.Ahead}" />
                                        <TextBlock Classes="countLabel" Text="ahead" />
                                    </StackPanel>

                                    <StackPanel Classes="countReadout" IsVisible="{Binding Git.HasBehind}">
                                        <ui:Icon Classes="countMark" Glyph="ChevronDown"
                                                 Foreground="{DynamicResource InkSecondary}" />
                                        <TextBlock Classes="count" Text="{Binding Git.Behind}" />
                                        <TextBlock Classes="countLabel" Text="behind" />
                                    </StackPanel>

                                    <TextBlock Classes="updateAge" Text="{Binding Git.UpdateLabel}" />

                                    <!-- The only action in the bar, and one word for both
                                         of the things it does. It always fetches, and it
                                         takes the new commits only when there is nothing
                                         local that taking them could cost. Pushing and
                                         resolving a conflict belong to a git client. -->
                                    <Button Theme="{StaticResource StatusBarButton}"
                                            Command="{Binding UpdateCommand}"
                                            ToolTip.Tip="Fetch, and pull when nothing has changed here">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <ui:Icon Glyph="RefreshCw" Size="{DynamicResource IconSizeStatus}"
                                                     Classes.spin="{Binding Git.IsUpdating}"
                                                     Foreground="{DynamicResource InkSecondary}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="Update"
                                                       Foreground="{DynamicResource InkPrimary}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Panel>
                    </Border>
                </Grid>

                <!-- Nothing above makes sense without a workspace, so the whole page is
                     replaced rather than emptied. Derived rather than designed: the
                     design shows a launcher that always has one. -->
                <Border Classes="page" BorderThickness="0"
                        IsVisible="{Binding !HasWorkspaces}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="400">
                        <Border Classes="toolMark" Width="52" Height="52"
                                HorizontalAlignment="Center">
                            <ui:Icon Glyph="FolderOpen" Size="{DynamicResource IconSizeLarge}"
                                     Foreground="{DynamicResource Accent}" />
                        </Border>

                        <TextBlock Text="No workspaces yet" Margin="0,18,0,0"
                                   FontSize="{DynamicResource FontSizeDialogTitle}"
                                   FontWeight="{DynamicResource FontWeightStrong}"
                                   Foreground="{DynamicResource InkPrimary}"
                                   HorizontalAlignment="Center" />

                        <TextBlock Margin="0,8,0,0"
                                   FontSize="{DynamicResource FontSizeControl}"
                                   LineHeight="18"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource InkSecondary}"
                                   Text="A workspace is a project folder. Tools and settings follow the one you have open." />

                        <Button Classes="primary" Content="Choose a folder"
                                Margin="0,22,0,0"
                                HorizontalAlignment="Center"
                                Click="OnChooseFolderClick" />
                    </StackPanel>
                </Border>
              </Panel>

              <Panel IsVisible="{Binding OnEnginesPage}">
                <views:EnginesPage DataContext="{Binding Engines}" />
              </Panel>
            </Panel>
        </Grid>
    </Grid>
</ui:ChromelessWindow>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Workbench.ViewModels"
        xmlns:core="clr-namespace:Workbench.Core;assembly=Workbench.Core"
        x:Class="Workbench.Views.LauncherWindow"
        x:DataType="vm:LauncherViewModel"
        Title="Workbench"
        Width="900" Height="560"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:LauncherViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="280,*">

        <!-- Tool list -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding Title}"
                           FontSize="20" FontWeight="SemiBold"
                           Margin="0,0,0,16" />

                <ListBox ItemsSource="{Binding Tools}"
                         SelectedItem="{Binding SelectedTool}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="core:ITool">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Category}" Opacity="0.6" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Detail pane -->
        <DockPanel Grid.Column="1" Margin="32">

            <StackPanel DockPanel.Dock="Bottom" Spacing="12">
                <TextBlock Text="{Binding Status}" Opacity="0.6" TextWrapping="Wrap" />
                <Button Content="Open"
                        Command="{Binding OpenSelectedCommand}"
                        HorizontalAlignment="Left"
                        Padding="24,8" />
            </StackPanel>

            <StackPanel Spacing="8" VerticalAlignment="Top">
                <TextBlock Text="{Binding SelectedTool.Name, FallbackValue='No tool selected'}"
                           FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedTool.Description}"
                           TextWrapping="Wrap" Opacity="0.8" />
            </StackPanel>

        </DockPanel>
    </Grid>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Workbench.Ui.Controls;assembly=Workbench.Ui"
             xmlns:vm="clr-namespace:Workbench.ViewModels"
             x:Class="Workbench.Views.EnginesPage"
             x:DataType="vm:EnginesViewModel">

    <!-- The band and page classes are the launcher's and reach here from the window, so
         the two pages sit on the same tones without either naming one. -->
    <UserControl.Resources>

        <!-- A card is not a row. The library's ListBoxItem carries a height, a padding and
             the seven row states, all of which would sit under a card that draws its own
             surface, so the container here is a bare presenter and the card is the whole
             look. Keyed rather than a class, for the reason the caption buttons are. -->
        <ControlTheme x:Key="EngineCard" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <!-- A card is not a row to pick, and there is no SelectionMode that says so,
                 so the container refuses focus and the theme draws no selected state. -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <!--
            Two buttons a card needs that the library has no kind for. Both are keyed
            rather than a class on the shared theme, for the reason the caption buttons
            are: a class inherits whatever that theme later gains, and the shared button
            is 26 tall with a border where these are 22 and one of them has none.
        -->

        <!-- Install. A filled 22px button with no border, one step above the card's own
             seam, so a row of them reads as the row's one action. -->
        <ControlTheme x:Key="InstallButton" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{DynamicResource LineControl}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            <Setter Property="Foreground" Value="{DynamicResource PinStruct}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#PART_Frame">
                <Setter Property="Background" Value="{DynamicResource LineWindow}" />
            </Style>

            <Style Selector="^:pressed /template/ Border#PART_Frame">
                <Setter Property="Background" Value="{DynamicResource LineControlDeep}" />
            </Style>

            <Style Selector="^:disabled /template/ Border#PART_Frame">
                <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            </Style>

            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
            </Style>
        </ControlTheme>

        <!-- The footer disclosure. Outlined rather than filled, since it changes what is
             listed rather than doing anything. -->
        <ControlTheme x:Key="DisclosureButton" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceNest2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlDeep}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#PART_Frame">
                <Setter Property="Background" Value="{DynamicResource StateHover}" />
            </Style>

            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
            </Style>

            <Style Selector="^:pressed /template/ Border#PART_Frame">
                <Setter Property="Background" Value="{DynamicResource StatePressed}" />
            </Style>
        </ControlTheme>

    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            <Setter Property="Foreground" Value="{DynamicResource InkTitle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A tab is a label and a count side by side, and the count lifts to the accent
             tint on the chosen one. That is a state of the option, so it is a class the
             row sets rather than two brushes written per tab. -->
        <Style Selector="TextBlock.tabCount">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="RadioButton:checked TextBlock.tabCount">
            <Setter Property="Foreground" Value="{DynamicResource AccentTintInk}" />
        </Style>

        <!-- The card rides the depth ramp rather than naming a tone. Nothing counts: the
             page nests once, a card nests again, and its open body nests once more, so
             each takes the fill and the seam that go together and a rule inside reads the
             right one. Hardcoding SurfaceNest2 here worked and left Border.seam resolving
             against the wrong level, which drew a rule nobody could see. -->
        <Style Selector="Border.engineRow">
            <Setter Property="(ui:Surface.Nests)" Value="True" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
            <Setter Property="Padding" Value="13,11" />
        </Style>

        <Style Selector="TextBlock.rowTitle">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.rowSub">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- A path in the status bar stays a quiet mono readout at rest and only reads as
             a link under the pointer, where it takes the accent and the underline the
             hyperlink theme already draws. Styles here are applied after the control
             theme, so the later pointerover setter is the one that wins, which is the
             precedence rule the theme file states. -->
        <Style Selector="HyperlinkButton.path">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
        </Style>

        <Style Selector="HyperlinkButton.path:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <!-- The card, read off the design's own values rather than approximated.

             The header is the whole row, so it is a button with no look of its own and the
             card behind it draws the surface. Its hover is the next tone down rather than
             the control hover fill, which is what the design draws and what makes an open
             card's header meet its body. -->
        <Style Selector="Button.cardHead">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.cardHead /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="Button.cardHead:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceNest3}" />
        </Style>

        <Style Selector="Button.cardHead:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceNest3}" />
        </Style>

        <!-- A card title is the subhead size, not the title size. -->
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSubhead}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A release with nothing for this platform drops its title a tier. -->
        <Style Selector="TextBlock.cardTitle.muted">
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>

        <!-- The subtitle is separate parts spaced 18 apart, not one joined string. -->
        <Style Selector="StackPanel.cardSub">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="18" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>

        <Style Selector="StackPanel.cardSub > TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- The marks at the right of a header. Body size at medium, muted, whatever the
             glyph beside them means. -->
        <Style Selector="TextBlock.cardMark">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The body sits one tone down from the card, which is what tells an open card
             from a closed one before any of its contents are read. -->
        <Style Selector="Border.cardBody">
            <Setter Property="(ui:Surface.Nests)" Value="True" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>

        <Style Selector="Grid.groupHead">
            <Setter Property="Margin" Value="46,9,14,6" />
        </Style>

        <!-- Tracked out, which is what a small capitalised label takes to stay readable.
             The design says .12em, and at 11 that is 1.32. -->
        <Style Selector="TextBlock.groupLabel">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
            <Setter Property="LetterSpacing" Value="1.32" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.buildRow">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="46,0,14,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.buildRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
        </Style>

        <Style Selector="TextBlock.buildName">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- A build already here drops to the muted tier, so the row still reads and stops
             asking to be pressed. -->
        <Style Selector="TextBlock.buildName.here">
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>

        <Style Selector="TextBlock.buildSize">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The percentage takes the accent's readable ink, since it is the one number in
             the row that is moving. -->
        <Style Selector="TextBlock.buildProgress">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTintInk}" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="ProgressBar.buildBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="MaxWidth" Value="104" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Grid.cardAbsentBlock">
            <Setter Property="Margin" Value="46,14,16,15" />
            <Setter Property="ColumnSpacing" Value="11" />
        </Style>

        <Style Selector="StackPanel.cardAbsent">
            <Setter Property="Spacing" Value="5" />
        </Style>

        <Style Selector="TextBlock.cardAbsentHead">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            <Setter Property="Foreground" Value="{DynamicResource InkChip}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.cardNote">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
            <Setter Property="Margin" Value="46,10,14,10" />
        </Style>

        <Style Selector="StackPanel.cardAbsent > TextBlock.cardNote">
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- The footer is separated by its own rule and is pushed off the rows above it,
             so it never reads as another build. -->
        <Style Selector="Border.cardFootLine">
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>

        <Style Selector="Border.cardFootLine">
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlDeep}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="46,9,14,10" />
        </Style>

        <Style Selector="HyperlinkButton.notes">
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        </Style>

        <Style Selector="TextBlock.rowMark">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- The design draws this as a window title bar. Here it is a page band, because
             the window already has a title bar and there is only one per window. -->
        <Border Grid.Row="0" Classes="band" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                <!-- The Godot mark in its own colours, so no tile behind it and no
                     foreground over it. It is a DrawingImage rather than an ui:Icon,
                     because a glyph in this library carries no fill and takes its colour
                     from the control. The rail keeps the mono glyph, which is right for a
                     row of icons that all answer the same selection state. -->
                <Image Grid.Column="0" Source="{StaticResource GodotMark}"
                       Width="20" Height="20" Stretch="Uniform"
                       VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Classes="pageTitle" Text="Godot engine installs" />

                <ui:SearchBox Grid.Column="3" Width="176"
                              PlaceholderText="Filter versions"
                              Text="{Binding Query, Mode=TwoWay}" />

                <Button Grid.Column="4" Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Read the release list again">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <ui:Icon Glyph="RefreshCw" Classes.spin="{Binding IsLoading}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Importing is step 7, so this says what it will do and cannot yet. -->
                <Button Grid.Column="5" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <ui:Icon Glyph="FolderOpen" VerticalAlignment="Center" />
                        <TextBlock Text="Add existing" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Tabs, and on Available the channel filter. There is no platform control and no
             architecture control, because the page shows what this machine runs. -->
        <Border Grid.Row="1" Classes="page" BorderThickness="0,0,0,1"
                Height="40" Padding="20,0">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">

                <ui:Segmented Grid.Column="0" VerticalAlignment="Center">
                    <RadioButton GroupName="engineTab"
                                 IsChecked="{Binding OnInstalled, Mode=OneWay}"
                                 Command="{Binding PickTabCommand}" CommandParameter="installed">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="Installed" VerticalAlignment="Center" />
                            <TextBlock Classes="tabCount" Text="{Binding InstalledCount}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="engineTab"
                                 IsChecked="{Binding OnAvailable, Mode=OneWay}"
                                 Command="{Binding PickTabCommand}" CommandParameter="available">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="Available" VerticalAlignment="Center" />
                            <TextBlock Classes="tabCount" Text="{Binding ReleaseCount}" />
                        </StackPanel>
                    </RadioButton>
                </ui:Segmented>

                <!-- The design draws these as chips. A chip in this library carries no
                     chosen state, and picking one of several is what a segmented row is,
                     so they are options with the chip's mark kept. -->
                <ui:Segmented Grid.Column="1" VerticalAlignment="Center"
                              IsVisible="{Binding OnAvailable}">
                    <RadioButton GroupName="engineChannel"
                                 Command="{Binding PickChannelCommand}" CommandParameter="all"
                                 Content="all" />

                    <RadioButton GroupName="engineChannel" IsChecked="True"
                                 Command="{Binding PickChannelCommand}" CommandParameter="stable"
                                 Content="stable" />

                    <RadioButton GroupName="engineChannel"
                                 Command="{Binding PickChannelCommand}" CommandParameter="rc"
                                 Content="rc" />

                    <RadioButton GroupName="engineChannel"
                                 Command="{Binding PickChannelCommand}" CommandParameter="beta"
                                 Content="beta" />

                    <RadioButton GroupName="engineChannel"
                                 Command="{Binding PickChannelCommand}" CommandParameter="dev"
                                 Content="dev" />
                </ui:Segmented>

                <TextBlock Grid.Column="2" Classes="mono"
                           Text="default install is used when a project pins no version"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource InkMuted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           IsVisible="{Binding OnInstalled}" />
            </Grid>
        </Border>

        <!-- The list is from a cache and the network could not be reached. It describes
             the state of what is on screen, so it is an alert and not a toast. -->
        <ui:Alert Grid.Row="2" Form="Strip" Tier="Warn"
                  Title="{Binding StaleNote}"
                  IsOpen="{Binding IsStale}" />

        <Border Grid.Row="3" Classes="page" BorderThickness="0">
            <Panel>
                <!-- **A ListBox, because it is the only items control in Avalonia 12 that
                     virtualises.** An ItemsControl realises every row, and this list is 183
                     releases, so picking a channel cost 348 to 709 ms of layout. Nothing
                     here is selectable: SelectionMode has no None in Avalonia, so the
                     container is unfocusable and its theme draws no selected state. -->
                <!-- Installed rows. -->
                <ListBox ItemsSource="{Binding Rows}"
                         IsVisible="{Binding OnInstalled}"
                         Padding="20,12,20,18"
                         ItemContainerTheme="{StaticResource EngineCard}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EngineRowViewModel">
                                <Border Classes="engineRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                        <StackPanel Grid.Column="0">

                                            <!-- The floor is the pill's own height, so a
                                                 row is the same whether it carries one or
                                                 not. Measured without it: a card with a
                                                 pill is 61 and one without is 58, because
                                                 a pill is 17 and the title's line box at
                                                 12.5 is 14. Three pixels is enough to read
                                                 as an uneven list. A floor rather than a
                                                 height, so a title that ever grows past
                                                 the pill still fits and still grows every
                                                 row alike. -->
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        MinHeight="{DynamicResource HeightPill}">
                                                <TextBlock Classes="rowTitle" Text="{Binding Title}" />
                                                <ui:Badge Content="DEFAULT" IsVisible="{Binding IsDefault}" />
                                                <ui:Badge Content="{Binding Channel}" IsVisible="{Binding HasChannel}" />
                                                <ui:Badge Content=".NET" IsVisible="{Binding IsMono}" />
                                            </StackPanel>

                                            <TextBlock Classes="rowSub" Text="{Binding Subtitle}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Classes="rowMark"
                                                   Text="{Binding Mark}"
                                                   IsVisible="{Binding HasMark}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Release cards. A card is a header that opens onto its builds. -->
                <ListBox ItemsSource="{Binding Cards}"
                         IsVisible="{Binding OnAvailable}"
                         Padding="20,12,20,18"
                         ItemContainerTheme="{StaticResource EngineCard}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReleaseCardViewModel">
                            <Border Classes="engineRow" Padding="0" ClipToBounds="True">
                                <StackPanel>

                                    <!-- The header. The whole row opens the card. -->
                                    <Button Classes="cardHead" Command="{Binding ToggleCommand}">
                                        <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="12">

                                            <!-- Two glyphs rather than one rotated. A
                                                 render transform on the icon did not
                                                 take, and the set draws both directions. -->
                                            <Panel Grid.Column="0" Width="20" Height="20">
                                                <ui:Icon Glyph="ChevronRight" Size="16"
                                                         Foreground="{DynamicResource InkSecondary}"
                                                         IsVisible="{Binding !IsOpen}" />
                                                <ui:Icon Glyph="ChevronDown" Size="16"
                                                         Foreground="{DynamicResource InkSecondary}"
                                                         IsVisible="{Binding IsOpen}" />
                                            </Panel>

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                            MinHeight="{DynamicResource HeightPill}">
                                                    <TextBlock Classes="cardTitle"
                                                               Classes.muted="{Binding IsUnavailable}"
                                                               Text="{Binding Title}" />
                                                    <ui:Badge Content="{Binding Channel}"
                                                              Tier="{Binding ChannelTier}"
                                                              HasDot="True"
                                                              IsVisible="{Binding HasChannel}" />
                                                </StackPanel>

                                                <StackPanel Classes="cardSub">
                                                    <TextBlock Text="{Binding Released}" />
                                                    <TextBlock Text="{Binding BuildCount}"
                                                               IsVisible="{Binding HasBuildCount}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            IsVisible="{Binding IsUnavailable}">
                                                    <ui:Icon Glyph="InfoCircle" Size="14"
                                                             Foreground="{DynamicResource InkMuted}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Classes="cardMark" Text="{Binding UnavailableNote}" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            IsVisible="{Binding HasInstalled}">
                                                    <ui:Icon Glyph="Check" Size="14"
                                                             Foreground="{DynamicResource Ok}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Classes="cardMark" Text="{Binding InstalledNote}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- The body. Nothing here exists until the card opens. -->
                                    <Border Classes="cardBody" IsVisible="{Binding IsOpen}">
                                        <StackPanel>

                                            <TextBlock Classes="cardNote" Text="Reading what this release holds"
                                                       IsVisible="{Binding IsLoading}" />

                                            <ui:Alert Form="Block" Tier="Error"
                                                      Title="This release could not be read"
                                                      Description="{Binding Failure}"
                                                      IsOpen="{Binding HasFailed}"
                                                      Margin="46,10,14,10" />

                                            <!-- Spec 5.1. The card keeps its place and says
                                                 what it is, and never guesses why. -->
                                            <Grid Classes="cardAbsentBlock" ColumnDefinitions="20,*"
                                                  IsVisible="{Binding IsUnavailable}">
                                                <ui:Icon Grid.Column="0" Glyph="InfoCircle" Size="20"
                                                         Foreground="{DynamicResource InkMuted}"
                                                         VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1" Classes="cardAbsent">
                                                    <TextBlock Classes="cardAbsentHead" Text="{Binding UnavailableNote}" />
                                                    <TextBlock Classes="cardNote" Text="{Binding PublishedFor}" />
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Groups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:EngineArchitectureGroupViewModel">
                                                        <StackPanel>
                                                            <Grid Classes="groupHead"
                                                                  ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                                                <TextBlock Grid.Column="0" Classes="groupLabel"
                                                                           Text="{Binding Label}" />
                                                                <Border Grid.Column="1" Classes="seam" Height="1"
                                                                        VerticalAlignment="Center" />
                                                            </Grid>

                                                            <ItemsControl ItemsSource="{Binding Builds}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:EngineBuildViewModel">
                                                                        <Border Classes="buildRow">
                                                                            <Grid ColumnDefinitions="*,80,218"
                                                                                  ColumnSpacing="12">
                                                                                <StackPanel Grid.Column="0"
                                                                                            Orientation="Horizontal" Spacing="9">
                                                                                    <TextBlock Classes="buildName"
                                                                                               Classes.here="{Binding IsInstalled}"
                                                                                               Text="{Binding FileName}" />
                                                                                    <ui:Badge Content=".NET" Tier="Data"
                                                                                              IsVisible="{Binding IsMono}" />
                                                                                </StackPanel>

                                                                                <TextBlock Grid.Column="1" Classes="buildSize"
                                                                                           Text="{Binding Size}"
                                                                                           IsVisible="{Binding HasSize}" />

                                                                                <Panel Grid.Column="2">
                                                                                    <Button Theme="{StaticResource InstallButton}"
                                                                                            HorizontalAlignment="Right"
                                                                                            Command="{Binding InstallCommand}"
                                                                                            IsVisible="{Binding CanInstall}">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                            <ui:Icon Glyph="ArrowToBottom" Size="13"
                                                                                                     VerticalAlignment="Center" />
                                                                                            <TextBlock Text="Install" VerticalAlignment="Center" />
                                                                                        </StackPanel>
                                                                                    </Button>

                                                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                                                HorizontalAlignment="Right"
                                                                                                IsVisible="{Binding IsInstalled}">
                                                                                        <ui:Icon Glyph="Check" Size="13"
                                                                                                 Foreground="{DynamicResource Ok}"
                                                                                                 VerticalAlignment="Center" />
                                                                                        <TextBlock Classes="cardMark" Text="Installed" />
                                                                                    </StackPanel>

                                                                                    <TextBlock Classes="cardMark" Text="queued"
                                                                                               HorizontalAlignment="Right"
                                                                                               IsVisible="{Binding IsQueued}" />

                                                                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                                                                          ColumnSpacing="9"
                                                                                          IsVisible="{Binding IsRunning}">
                                                                                        <ProgressBar Grid.Column="0" Classes="buildBar"
                                                                                                     Minimum="0" Maximum="1"
                                                                                                     Value="{Binding Progress}"
                                                                                                     IsIndeterminate="{Binding !HasProgress}" />
                                                                                        <TextBlock Grid.Column="1" Classes="buildProgress"
                                                                                                   Text="{Binding ProgressLabel}" />
                                                                                        <Button Grid.Column="2" Classes="icon"
                                                                                                Width="22" Height="22"
                                                                                                Command="{Binding CancelCommand}"
                                                                                                ToolTip.Tip="Stop this install"
                                                                                                AutomationProperties.Name="Stop this install">
                                                                                            <ui:Icon Glyph="X" Size="13" />
                                                                                        </Button>
                                                                                    </Grid>
                                                                                </Panel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- The card has builds but none for this
                                                 processor, which the design does not draw
                                                 and which every ARM machine meets. -->
                                            <TextBlock Classes="cardNote" Text="{Binding NoNativeNote}"
                                                       IsVisible="{Binding HasNoNative}" />

                                            <Border Classes="cardFootLine">
                                                <Grid Classes="cardFoot" ColumnDefinitions="Auto,*,Auto">
                                                    <Button Grid.Column="0"
                                                            Theme="{StaticResource DisclosureButton}"
                                                            Content="{Binding OtherArchitecturesLabel}"
                                                            Command="{Binding ToggleArchitecturesCommand}"
                                                            IsVisible="{Binding HasOtherArchitectures}" />

                                                    <HyperlinkButton Grid.Column="2" Classes="notes"
                                                                     Content="Release notes"
                                                                     Command="{Binding OpenNotesCommand}"
                                                                     IsVisible="{Binding HasNotes}" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Classes="emptyState" IsVisible="{Binding IsEmpty}">
                    <ui:Icon Glyph="Package" Size="{DynamicResource IconSizeLarge}" />
                    <TextBlock Text="{Binding EmptyNote}" />
                </StackPanel>

                <!-- Nothing could be read at all, from the network or from a cache. The
                     one case with no list behind it. -->
                <ui:Alert Form="Block" Tier="Error"
                          Title="The Godot release list could not be read"
                          Description="{Binding Failure}"
                          IsOpen="{Binding HasFailed}"
                          MaxWidth="420"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
        </Border>

        <!-- The page's own status bar. The workspace page has one too, so the classes come
             from the library and neither page invents a row. -->
        <Border Grid.Row="4" Classes="band" BorderThickness="0,1,0,0"
                Height="{DynamicResource HeightTitleBar}" Padding="16,0,12,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <ui:Icon Glyph="FolderOpen" Size="{DynamicResource IconSizeStatus}"
                             Foreground="{DynamicResource InkMuted}"
                             VerticalAlignment="Center" />
                    <!-- The one thing in this row that is a control rather than a
                         readout, which the status bar's first rule would normally
                         forbid. It earns it: the folder is the page's subject and
                         opening it is the only thing anyone wants to do with the
                         path. -->
                    <HyperlinkButton Classes="path"
                                     Content="{Binding InstallRoot}"
                                     Command="{Binding OpenEngineDirectoryCommand}"
                                     ToolTip.Tip="Show this folder in the file browser" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14"
                            VerticalAlignment="Center">

                    <!-- Colour plus icon plus label, and a zero is never drawn, which are
                         two of the status bar's own rules. -->
                    <StackPanel Classes="countReadout" IsVisible="{Binding HasInstalled}">
                        <ui:Icon Classes="countMark" Glyph="Package"
                                 Foreground="{DynamicResource Accent}" />
                        <TextBlock Classes="count" Text="{Binding InstalledCount}" />
                        <TextBlock Classes="countLabel" Text="installed" />
                    </StackPanel>

                    <StackPanel Classes="countReadout" IsVisible="{Binding HasInstalled}">
                        <ui:Icon Classes="countMark" Glyph="Database"
                                 Foreground="{DynamicResource InkSecondary}" />
                        <TextBlock Classes="count" Text="{Binding OnDisk}" />
                        <TextBlock Classes="countLabel" Text="on disk" />
                    </StackPanel>

                    <StackPanel Classes="countReadout" IsVisible="{Binding HasUpdate}">
                        <ui:Icon Classes="countMark" Glyph="ArrowToBottom"
                                 Foreground="{DynamicResource Warn}" />
                        <TextBlock Classes="count" Text="{Binding UpdateVersion}" />
                        <TextBlock Classes="countLabel" Text="update available" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

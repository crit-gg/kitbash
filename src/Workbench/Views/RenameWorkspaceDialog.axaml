<ui:DialogWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:Workbench.Ui.Controls;assembly=Workbench.Ui"
                 x:Class="Workbench.Views.RenameWorkspaceDialog"
                 Title="Rename workspace"
                 Width="412" SizeToContent="Height"
                 FontFamily="{StaticResource FontFamilyUi}"
                 FontSize="{StaticResource FontSizeBody}">

    <Grid RowDefinitions="Auto,*,Auto">
        <ui:WindowTitleBar Grid.Row="0" Title="Rename workspace" />

        <StackPanel Grid.Row="1" Margin="16,16,16,14" Spacing="7">
            <TextBlock Text="Name"
                       FontSize="{DynamicResource FontSizeControl}"
                       FontWeight="{DynamicResource FontWeightMedium}"
                       Foreground="{DynamicResource InkPrimary}" />

            <TextBox Name="Value" ui:Dialog.TakesFocus="True" />

            <!-- The path, so a rename lands on the folder a person meant. -->
            <TextBlock Name="Path"
                       FontFamily="{DynamicResource FontFamilyMono}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource InkMuted}"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Text="This name is yours alone. Blank goes back to the project name, or the folder name."
                       Margin="0,4,0,0"
                       FontSize="{DynamicResource FontSizeSmall}"
                       LineHeight="17"
                       Foreground="{DynamicResource InkSecondary}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ui:DialogFooter Grid.Row="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" ui:Dialog.Role="Cancel" />
                <Button Classes="primary" Content="Rename" ui:Dialog.Role="Accept" />
            </StackPanel>
        </ui:DialogFooter>
    </Grid>
</ui:DialogWindow>

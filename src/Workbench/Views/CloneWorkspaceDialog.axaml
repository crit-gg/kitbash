<ui:DialogWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="clr-namespace:Workbench.ViewModels"
                 xmlns:ui="clr-namespace:Workbench.Ui.Controls;assembly=Workbench.Ui"
                 x:Class="Workbench.Views.CloneWorkspaceDialog"
                 x:DataType="vm:CloneWorkspaceViewModel"
                 Title="Clone workspace"
                 Width="484" SizeToContent="Height"
                 FontFamily="{StaticResource FontFamilyUi}"
                 FontSize="{StaticResource FontSizeBody}">

    <Window.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="TextBlock.fieldNote">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <ui:WindowTitleBar Grid.Row="0" Title="Clone workspace" />

        <StackPanel Grid.Row="1" Margin="16,16,16,14" Spacing="18">
            <StackPanel Spacing="7">
                <TextBlock Classes="fieldLabel" Text="Repository" />

                <TextBox Text="{Binding Address}"
                         IsEnabled="{Binding CanEdit}"
                         ui:Dialog.TakesFocus="True"
                         PlaceholderText="https://example.com/team/game.git" />

                <TextBlock Classes="fieldNote"
                           Text="An https address, or an SSH one such as git@example.com:team/game.git" />
            </StackPanel>

            <StackPanel Spacing="7">
                <TextBlock Classes="fieldLabel" Text="Put it in" />

                <ui:PathField Target="Folder"
                              Path="{Binding Folder}"
                              IsEnabled="{Binding CanEdit}"
                              DialogTitle="Choose a folder" />

                <!-- The folder git will make, named before it is made. -->
                <TextBlock FontFamily="{DynamicResource FontFamilyMono}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource InkMuted}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Target}" />
            </StackPanel>

            <ui:Alert Tier="Error" Title="{Binding Message}"
                      IsVisible="{Binding HasMessage}" />

            <StackPanel Spacing="8" IsVisible="{Binding IsCloning}">
                <ProgressBar IsIndeterminate="True" />

                <TextBlock Classes="fieldNote" Text="Cloning" />
            </StackPanel>
        </StackPanel>

        <!-- Clone runs before the dialog can close, so it carries no role and Cancel stops
             a clone that is running instead of closing over the top of it. -->
        <ui:DialogFooter Grid.Row="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" />

                <Button Classes="primary" Content="Clone" IsDefault="True"
                        IsEnabled="{Binding CanClone}"
                        Click="OnCloneClick" />
            </StackPanel>
        </ui:DialogFooter>
    </Grid>
</ui:DialogWindow>

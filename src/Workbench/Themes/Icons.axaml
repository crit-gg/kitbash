<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- BoxIcons v3 Pro, path data only, on a 24 by 24 view box. Draw with a
         PathIcon so the fill follows the foreground. -->

    <!-- The stock PathIcon template stretches the geometry's own ink to fill the
         control, which throws the 24 unit box away and blows up any glyph that does
         not fill it. A chevron is mostly empty space, so it came out about two and a
         half times too large. Holding the box on a Canvas keeps every icon at the
         size the design asks for. -->
    <ControlTheme x:Key="{x:Type PathIcon}" TargetType="PathIcon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <Viewbox Width="{TemplateBinding Width}"
                             Height="{TemplateBinding Height}"
                             Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{TemplateBinding Foreground}"
                                  Data="{TemplateBinding Data}" />
                        </Canvas>
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>


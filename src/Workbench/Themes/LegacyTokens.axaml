<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- TEMPORARY. The launcher's markup is rewritten in stage 6 and this file is
         deleted with it. See .claude/plans/stage-06-launcher-relayout.md.

         These are the old palette, kept at their old values so the launcher looks
         exactly as it did. They are prefixed because several of the old names collide
         with a Slate token of the same name and a different value, and because a
         prefix makes it obvious that new work must not use them. A grep for Legacy
         shows everything stage 6 has to replace. -->

    <SolidColorBrush x:Key="LegacyGroundDeep" Color="#07080a" />
    <SolidColorBrush x:Key="LegacyGroundChrome" Color="#090b0d" />
    <SolidColorBrush x:Key="LegacyGroundStrip" Color="#0f1216" />
    <SolidColorBrush x:Key="LegacyGroundBar" Color="#101317" />
    <SolidColorBrush x:Key="LegacyGroundWindow" Color="#14171b" />
    <SolidColorBrush x:Key="LegacyGroundRaised" Color="#131619" />
    <SolidColorBrush x:Key="LegacySurface" Color="#171b20" />
    <SolidColorBrush x:Key="LegacySurfaceHover" Color="#1a1f26" />
    <SolidColorBrush x:Key="LegacySurfaceControl" Color="#1d2228" />
    <SolidColorBrush x:Key="LegacySurfaceMenu" Color="#1a1e23" />
    <SolidColorBrush x:Key="LegacySurfaceMenuHover" Color="#1d2228" />
    <SolidColorBrush x:Key="LegacyCaptionHover" Color="#2b313a" />
    <SolidColorBrush x:Key="LegacyCaptionPressed" Color="#353c47" />
    <SolidColorBrush x:Key="LegacyLineChrome" Color="#1c2126" />
    <SolidColorBrush x:Key="LegacyLineRule" Color="#1e242a" />
    <SolidColorBrush x:Key="LegacyLineSoft" Color="#272d34" />
    <SolidColorBrush x:Key="LegacyLineControl" Color="#313943" />
    <SolidColorBrush x:Key="LegacyLineMenu" Color="#3b444f" />
    <SolidColorBrush x:Key="LegacyLineDashed" Color="#2a3138" />
    <SolidColorBrush x:Key="LegacyInkBright" Color="#e5eaef" />
    <SolidColorBrush x:Key="LegacyInkBody" Color="#c6cfd8" />
    <SolidColorBrush x:Key="LegacyInkMuted" Color="#9ba6b0" />
    <SolidColorBrush x:Key="LegacyInkDim" Color="#8b959e" />
    <SolidColorBrush x:Key="LegacyInkFaint" Color="#6e7982" />
    <SolidColorBrush x:Key="LegacyInkGhost" Color="#49535b" />
    <SolidColorBrush x:Key="LegacyInkGhostest" Color="#3f484f" />
    <SolidColorBrush x:Key="LegacyAccent" Color="#58a6f0" />
    <SolidColorBrush x:Key="LegacyAccentBright" Color="#92c5f7" />
    <SolidColorBrush x:Key="LegacyAccentInk" Color="#6fabe8" />
    <SolidColorBrush x:Key="LegacyAccentTint" Color="#12202e" />
    <SolidColorBrush x:Key="LegacyAccentTintLine" Color="#2d5478" />
    <SolidColorBrush x:Key="LegacyAccentSelected" Color="#16212c" />
    <SolidColorBrush x:Key="LegacyOk" Color="#52cfa5" />
    <SolidColorBrush x:Key="LegacyOkInk" Color="#7cd6b2" />
    <SolidColorBrush x:Key="LegacyOkTint" Color="#112019" />
    <SolidColorBrush x:Key="LegacyOkTintLine" Color="#23452f" />
    <SolidColorBrush x:Key="LegacyWarn" Color="#e0a943" />
    <SolidColorBrush x:Key="LegacyWarnTint" Color="#1f1a10" />
    <SolidColorBrush x:Key="LegacyWarnTintLine" Color="#3b2f16" />
    <SolidColorBrush x:Key="LegacyBad" Color="#ea5257" />
    <SolidColorBrush x:Key="LegacyBadInk" Color="#ea8a8a" />
    <SolidColorBrush x:Key="LegacyBadTint" Color="#1e1416" />
    <SolidColorBrush x:Key="LegacyBadTintLine" Color="#3a1e21" />
    <SolidColorBrush x:Key="LegacyClose" Color="#e13c2f" />
    <SolidColorBrush x:Key="LegacyClosePressed" Color="#bd2c21" />
    <SolidColorBrush x:Key="LegacyNeutral" Color="#5c6772" />
    <SolidColorBrush x:Key="LegacyScrim" Color="#05070a" Opacity="0.5" />

</ResourceDictionary>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Workbench.Views">

    <Styles.Resources>
        <!-- The title bar row and the caption buttons share this, which keeps the
             buttons square. A window sets its own title bar to this height. -->
        <x:Double x:Key="CaptionBarHeight">36</x:Double>

        <!-- Caption glyphs, drawn as strokes on a 10 by 10 box. -->
        <StreamGeometry x:Key="GlyphMinimize">M 0,5 H 10</StreamGeometry>
        <StreamGeometry x:Key="GlyphMaximize">M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z</StreamGeometry>
        <StreamGeometry x:Key="GlyphRestore">M 2.5,2.5 V 0.5 H 9.5 V 7.5 H 7.5 M 0.5,2.5 H 7.5 V 9.5 H 0.5 Z</StreamGeometry>
        <StreamGeometry x:Key="GlyphClose">M 0,0 L 9,9 M 9,0 L 0,9</StreamGeometry>
    </Styles.Resources>

    <!-- Caption buttons are real buttons so they take focus, answer the keyboard and
         report themselves to assistive technology, the way a system title bar does. -->
    <Style Selector="views|WindowTitleBar /template/ Button.caption">
        <Setter Property="Width" Value="{StaticResource CaptionBarHeight}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root" Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="views|WindowTitleBar /template/ Button.caption Path">
        <Setter Property="Stroke" Value="{DynamicResource InkBright}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style Selector="views|WindowTitleBar /template/ Button.caption:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource SurfaceMenu}" />
    </Style>

    <Style Selector="views|WindowTitleBar /template/ Button.caption:pressed /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource SurfaceControl}" />
    </Style>

    <!-- Close floods red the way every system close button does. It is declared
         after the shared pressed state so the flood wins while the button is held. -->
    <Style Selector="views|WindowTitleBar /template/ Button.captionClose:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource Close}" />
    </Style>

    <Style Selector="views|WindowTitleBar /template/ Button.captionClose:pressed /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource ClosePressed}" />
    </Style>

    <!-- Maximized swaps the glyph and the tooltip, the way a system button does. -->
    <Style Selector="views|WindowTitleBar.maximized /template/ Button.captionMaximize Path">
        <Setter Property="Data" Value="{StaticResource GlyphRestore}" />
    </Style>

    <Style Selector="views|WindowTitleBar.maximized /template/ Button.captionMaximize">
        <Setter Property="ToolTip.Tip" Value="Restore" />
    </Style>

    <!-- A window that cannot resize has no maximize button at all. -->
    <Style Selector="views|WindowTitleBar.fixedSize /template/ Button.captionMaximize">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- The title bar row. It owns the icon, the title and the caption buttons, so a
         window supplies only what it wants to add. WindowTitleBar hides the whole row
         when the desktop draws the frame and the window added nothing. -->
    <Style Selector="views|WindowTitleBar">
        <Setter Property="Height" Value="{StaticResource CaptionBarHeight}" />
        <Setter Property="Background" Value="{DynamicResource GroundChrome}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineChrome}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />

        <Setter Property="Template">
            <ControlTemplate>
                <!-- Background is on the border rather than the control, so the whole
                     row is hit tested and a drag can start anywhere on it. -->
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        WindowDecorationProperties.ElementRole="TitleBar">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="15,0,0,0">
                        <Image Grid.Column="0" Width="18" Height="18"
                               VerticalAlignment="Center"
                               IsVisible="{Binding $parent[views:WindowTitleBar].Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               Source="{TemplateBinding Icon}" />

                        <TextBlock Grid.Column="1" Text="{TemplateBinding Title}"
                                   Margin="11,0,0,0"
                                   FontSize="12.5" FontWeight="SemiBold" LetterSpacing="0.25"
                                   Foreground="{DynamicResource InkBright}"
                                   VerticalAlignment="Center" />

                        <ContentPresenter Grid.Column="2"
                                          Margin="11,0,0,0"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch" />

                        <StackPanel Grid.Column="3" Name="PART_CaptionButtons"
                                    Orientation="Horizontal">
                            <Button Classes="caption" Name="PART_MinimizeButton"
                                    ToolTip.Tip="Minimize"
                                    AutomationProperties.Name="Minimize"
                                    WindowDecorationProperties.ElementRole="MinimizeButton">
                                <Path Data="{StaticResource GlyphMinimize}" />
                            </Button>
                            <Button Classes="caption captionMaximize" Name="PART_MaximizeButton"
                                    ToolTip.Tip="Maximize"
                                    AutomationProperties.Name="Maximize"
                                    WindowDecorationProperties.ElementRole="MaximizeButton">
                                <Path Data="{StaticResource GlyphMaximize}" />
                            </Button>
                            <Button Classes="caption captionClose" Name="PART_CloseButton"
                                    ToolTip.Tip="Close"
                                    AutomationProperties.Name="Close"
                                    WindowDecorationProperties.ElementRole="CloseButton">
                                <Path Data="{StaticResource GlyphClose}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- The desktop draws the frame, so it supplies the caption buttons and ours go.
         A row that still carries content keeps everything else. -->
    <Style Selector="views|WindowTitleBar.nativeChrome /template/ StackPanel#PART_CaptionButtons">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- The frame for windows that draw their own title bar. No shadow is drawn here,
         so the window is exactly its visible size and the resize grips sit just
         inside its edges. -->

    <Style Selector="Window.chromeless">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TransparencyLevelHint" Value="Transparent" />
        <Setter Property="WindowDecorations" Value="None" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_ContentRoot"
                            Margin="{TemplateBinding Padding}"
                            Background="{DynamicResource GroundWindow}"
                            BorderBrush="{DynamicResource LineSoft}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Border CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Content="{TemplateBinding Content}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Border>

                    <!-- Grips sit over the outer edge of the frame. Corners are larger
                         so they are reachable without hitting an edge first. -->
                    <Border x:Name="PART_ResizeTopLeft" Classes="resizeGrip"
                            Width="12" Height="12" Background="Transparent"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Cursor="TopLeftCorner" Tag="{x:Static WindowEdge.NorthWest}" />

                    <Border x:Name="PART_ResizeTop" Classes="resizeGrip"
                            Height="5" Margin="12,0" Background="Transparent"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top"
                            Cursor="TopSide" Tag="{x:Static WindowEdge.North}" />

                    <Border x:Name="PART_ResizeTopRight" Classes="resizeGrip"
                            Width="12" Height="12" Background="Transparent"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Cursor="TopRightCorner" Tag="{x:Static WindowEdge.NorthEast}" />

                    <Border x:Name="PART_ResizeLeft" Classes="resizeGrip"
                            Width="5" Margin="0,12" Background="Transparent"
                            HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            Cursor="LeftSide" Tag="{x:Static WindowEdge.West}" />

                    <Border x:Name="PART_ResizeRight" Classes="resizeGrip"
                            Width="5" Margin="0,12" Background="Transparent"
                            HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            Cursor="RightSide" Tag="{x:Static WindowEdge.East}" />

                    <Border x:Name="PART_ResizeBottomLeft" Classes="resizeGrip"
                            Width="12" Height="12" Background="Transparent"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Cursor="BottomLeftCorner" Tag="{x:Static WindowEdge.SouthWest}" />

                    <Border x:Name="PART_ResizeBottom" Classes="resizeGrip"
                            Height="5" Margin="12,0" Background="Transparent"
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                            Cursor="BottomSide" Tag="{x:Static WindowEdge.South}" />

                    <Border x:Name="PART_ResizeBottomRight" Classes="resizeGrip"
                            Width="12" Height="12" Background="Transparent"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Cursor="BottomRightCorner" Tag="{x:Static WindowEdge.SouthEast}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Maximized fills the work area, so the rounding, the border and the grips go. -->
    <Style Selector="Window.chromeless[WindowState=Maximized]">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Window.chromeless[WindowState=Maximized] /template/ Border#PART_ContentRoot">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Window.chromeless[WindowState=Maximized] /template/ Border.resizeGrip">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Window.chromeless[CanResize=False] /template/ Border.resizeGrip">
        <Setter Property="IsVisible" Value="False" />
    </Style>

</Styles>

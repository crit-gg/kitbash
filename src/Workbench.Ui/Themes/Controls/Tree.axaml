<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Workbench.Ui.Controls">

    <!-- A tree is a list of rows that know their depth, so almost all of this is the list
         theme and only the leading edge of a row is new.

         Both themes are keyed off ListBoxItem's, because a control theme is found by the
         exact type and never falls back to a base one. Basing them on it is what keeps one
         row look rather than two that drift.

         Depth is drawn in three parts. The frame is pushed in by the indent, so a fill
         starts where the row starts. The caret sits at the front of the frame and holds
         its width whether it is drawn or not, so a branch and a leaf that are siblings
         line up. The guides are rendered by the row itself, since one element per level
         would be built and discarded on every scroll. -->

    <ControlTheme x:Key="{x:Type ui:Tree}" TargetType="ui:Tree" BasedOn="{StaticResource {x:Type ListBox}}" />

    <ControlTheme x:Key="{x:Type ui:TreeItem}" TargetType="ui:TreeItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Height" Value="{DynamicResource HeightTreeRow}" />
        <Setter Property="Padding" Value="{DynamicResource PaddingTreeRow}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}" />
        <Setter Property="IndentSize" Value="{DynamicResource IndentTree}" />
        <Setter Property="GuideOffset" Value="{DynamicResource IndentTreeGuide}" />
        <Setter Property="GuideBrush" Value="{DynamicResource LineRow}" />

        <Setter Property="Template">
            <ControlTemplate>
                <!-- Full width and hit tested across all of it, so a click anywhere along
                     the row picks it, while only the part after the indent is filled. -->
                <Panel Background="Transparent">
                    <Panel Margin="{TemplateBinding Indent}">
                        <Border Name="PART_Focus"
                                Margin="{DynamicResource FocusHaloReach}"
                                BorderThickness="{DynamicResource FocusHaloThickness}"
                                BorderBrush="Transparent"
                                CornerRadius="{DynamicResource RadiusControlHalo}"
                                IsHitTestVisible="False" />

                        <Rectangle Name="PART_Drop"
                                   Stroke="{DynamicResource LineControl}"
                                   StrokeThickness="1"
                                   StrokeDashArray="3,2"
                                   RadiusX="{DynamicResource SizeRadiusControl}"
                                   RadiusY="{DynamicResource SizeRadiusControl}"
                                   IsHitTestVisible="False"
                                   IsVisible="False" />

                        <Border Name="PART_Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <!-- The caret's hit area, which is the whole strip in front
                                     of the name rather than the glyph alone. It pads itself
                                     on both sides, which is why the row pads only its right:
                                     a 14px target is a small thing to hit twice in a row.

                                     Transparent rather than nothing, since a control with no
                                     background is not hit tested and the click could never
                                     be reached. -->
                                <Border Name="PART_Caret"
                                        DockPanel.Dock="Left"
                                        Padding="{DynamicResource PaddingCaret}"
                                        Background="Transparent">
                                    <!-- The glyph goes, the room it takes does not, so a
                                         branch and a leaf that are siblings line up. -->
                                    <Panel Width="{DynamicResource IconSizeCaret}">
                                        <ui:Icon Name="PART_CaretGlyph"
                                                 Glyph="ChevronRight"
                                                 Size="{DynamicResource IconSizeCaret}"
                                                 Foreground="{DynamicResource InkSecondary}"
                                                 VerticalAlignment="Center"
                                                 IsVisible="False" />
                                    </Panel>
                                </Border>

                                <Border Name="PART_Modified"
                                        DockPanel.Dock="Right"
                                        Width="{DynamicResource SizeMarkModified}"
                                        Height="{DynamicResource SizeMarkModified}"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        CornerRadius="{DynamicResource RadiusMark}"
                                        Background="{DynamicResource Warn}"
                                        IsVisible="False" />

                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </DockPanel>
                        </Border>
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- A caret means there is something to open. A leaf keeps the space and draws
             nothing, which is what the design asks for: a disclosure is a caret and never
             a box, so a row with no children simply has none. -->
        <Style Selector="^:branch /template/ ui|Icon#PART_CaretGlyph">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:expanded /template/ ui|Icon#PART_CaretGlyph">
            <Setter Property="Glyph" Value="ChevronDown" />
        </Style>

        <!-- The guide follows the tone it stands on, the way Border.seam does, and stays
             one step quieter than that tone's seam. The design draws a tree on the root
             tone, where the seam is LineSeam and the guide is LineRow, and this keeps that
             gap at every depth.

             Measured, and the reason this is here rather than one brush: LineRow on
             SurfaceNest2 is a difference of one in each channel, so a guide named once
             disappears the moment a tree is put inside two panels. -->
        <Style Selector="^[(ui|Surface.Level)=2]">
            <Setter Property="GuideBrush" Value="{DynamicResource LineSeam}" />
        </Style>

        <Style Selector="^[(ui|Surface.Level)=3]">
            <Setter Property="GuideBrush" Value="{DynamicResource LineControl}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="GuideBrush" Value="{DynamicResource LineControlOff}" />
        </Style>

        <Style Selector="^:disabled /template/ ui|Icon#PART_CaretGlyph">
            <Setter Property="Foreground" Value="{DynamicResource MarkOff}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#PART_Modified">
            <Setter Property="Background" Value="{DynamicResource MarkOff}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>

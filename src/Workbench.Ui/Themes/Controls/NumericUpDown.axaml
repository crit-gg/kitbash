<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Workbench.Ui.Controls">

    <!-- A number in a well with a stepper column inside it.

         The adorner rule is the whole look of a value editor: a stepper, a calendar mark
         or a colour swatch sits inside the well behind a hairline, never floating outside
         it. Nothing new is built for that. A NumericUpDown already hosts a ButtonSpinner
         which already hosts the field, so the frame is the spinner's and the field inside
         it draws nothing of its own.

         The value is mono, because the spec puts numbers, dates, counts and paths in
         JetBrains Mono and a column of them has to line up. -->

    <!-- The field inside the spinner. No frame, no well and no focus halo of its own,
         since all three belong to the spinner around it. -->
    <ControlTheme x:Key="SpinnerField" TargetType="TextBox"
                  BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="MinWidth" Value="0" />

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="^:focus-within">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="^:focus-within /template/ Border#PART_Halo">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </ControlTheme>

    <!-- One half of the stepper column. Keyed rather than a class on the button theme,
         because it is 18 by half a control and would inherit every height that theme
         gains. -->
    <ControlTheme x:Key="SpinnerStep" TargetType="RepeatButton">
        <Setter Property="Width" Value="{DynamicResource WidthSpinner}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MarkOff}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
        <Setter Property="Height" Value="{DynamicResource HeightControl}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SurfaceWell}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Halo"
                            Margin="{DynamicResource FocusHaloReach}"
                            BorderThickness="{DynamicResource FocusHaloThickness}"
                            BorderBrush="Transparent"
                            CornerRadius="{DynamicResource RadiusControlHalo}"
                            IsHitTestVisible="False" />

                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <DockPanel LastChildFill="True">
                            <!-- The column is a seam away from the value, and its two
                                 halves are a seam apart. Both take the frame's own line,
                                 so the whole well reads as one piece. -->
                            <Border Name="PART_SpinnerColumn"
                                    DockPanel.Dock="Right"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,0,0,0">
                                <Grid RowDefinitions="*,*">
                                    <RepeatButton Name="PART_IncreaseButton"
                                                  Grid.Row="0"
                                                  Theme="{StaticResource SpinnerStep}">
                                        <ui:Icon Glyph="ChevronUp"
                                                 Size="{DynamicResource IconSizeCompact}" />
                                    </RepeatButton>

                                    <RepeatButton Name="PART_DecreaseButton"
                                                  Grid.Row="1"
                                                  Theme="{StaticResource SpinnerStep}"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="0,1,0,0">
                                        <ui:Icon Glyph="ChevronDown"
                                                 Size="{DynamicResource IconSizeCompact}" />
                                    </RepeatButton>
                                </Grid>
                            </Border>

                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </DockPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- The column can sit on either side, and the control says which. -->
        <Style Selector="^:left /template/ Border#PART_SpinnerColumn">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>

        <Style Selector="^[ShowButtonSpinner=False] /template/ Border#PART_SpinnerColumn">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
        </Style>

        <Style Selector="^:focus-within">
            <Setter Property="Background" Value="{DynamicResource SurfaceWellFocus}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
        </Style>

        <Style Selector="^:focus-within /template/ Border#PART_Halo">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>

        <!-- The same error state every field answers. See TextBox.axaml. -->
        <Style Selector="^[(DataValidationErrors.HasErrors)=True]">
            <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
        </Style>

        <Style Selector="^.error">
            <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>
    </ControlTheme>

    <!-- The spinner is the whole look, so this is the wiring and nothing else. -->
    <ControlTheme x:Key="{x:Type NumericUpDown}" TargetType="NumericUpDown">
        <!-- The value can be dragged as well as typed and stepped. -->
        <Setter Property="(ui:Scrub.Drags)" Value="True" />
        <Setter Property="Height" Value="{DynamicResource HeightControl}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <ButtonSpinner Name="PART_Spinner"
                               AllowSpin="{TemplateBinding AllowSpin}"
                               ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
                               ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}"
                               HorizontalContentAlignment="Stretch"
                               VerticalContentAlignment="Center">
                    <TextBox Name="PART_TextBox"
                             Theme="{StaticResource SpinnerField}"
                             Text="{TemplateBinding Text, Mode=TwoWay}"
                             PlaceholderText="{TemplateBinding PlaceholderText}"
                             IsReadOnly="{TemplateBinding IsReadOnly}"
                             TextAlignment="{TemplateBinding TextAlignment}"
                             InnerLeftContent="{TemplateBinding InnerLeftContent}"
                             InnerRightContent="{TemplateBinding InnerRightContent}" />
                </ButtonSpinner>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>

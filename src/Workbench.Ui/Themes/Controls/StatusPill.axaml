<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Workbench.Ui.Controls">

    <!-- A status reads as colour plus icon plus label. -->
    <ControlTheme x:Key="{x:Type ui:StatusPill}" TargetType="ui:StatusPill">
        <Setter Property="Height" Value="{DynamicResource HeightPill}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Border Name="PART_Mark"
                                Width="{DynamicResource SizeMark}"
                                Height="{DynamicResource SizeMark}"
                                CornerRadius="{DynamicResource RadiusMark}"
                                VerticalAlignment="Center" />

                        <ui:Icon Name="PART_Icon"
                                 Glyph="{TemplateBinding Glyph}"
                                 Size="{DynamicResource IconSizeCompact}"
                                 VerticalAlignment="Center" />

                        <TextBlock Name="PART_Text"
                                   Text="{TemplateBinding Text}"
                                   LetterSpacing="{DynamicResource LetterSpacingPill}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Neutral, for a state that is neither good nor bad. -->
        <Style Selector="^.neutral">
            <Setter Property="Glyph" Value="InfoCircle" />
            <Setter Property="Background" Value="{DynamicResource SurfaceNest3}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlDeep}" />
            <Setter Property="Foreground" Value="{DynamicResource InkChip}" />
        </Style>

        <Style Selector="^.neutral /template/ Border#PART_Mark">
            <Setter Property="Background" Value="{DynamicResource InkSecondary}" />
        </Style>

        <Style Selector="^.ok">
            <Setter Property="Glyph" Value="Check" />
            <Setter Property="Background" Value="{DynamicResource OkSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OkLine}" />
            <Setter Property="Foreground" Value="{DynamicResource OkInk}" />
        </Style>

        <Style Selector="^.ok /template/ Border#PART_Mark">
            <Setter Property="Background" Value="{DynamicResource Ok}" />
        </Style>

        <Style Selector="^.modified">
            <Setter Property="Glyph" Value="AlertTriangle" />
            <Setter Property="Background" Value="{DynamicResource WarnSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarnLine}" />
            <Setter Property="Foreground" Value="{DynamicResource WarnInk}" />
        </Style>

        <Style Selector="^.modified /template/ Border#PART_Mark">
            <Setter Property="Background" Value="{DynamicResource Warn}" />
        </Style>

        <Style Selector="^.error">
            <Setter Property="Glyph" Value="AlertCircle" />
            <Setter Property="Background" Value="{DynamicResource ErrorSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorLine}" />
            <Setter Property="Foreground" Value="{DynamicResource ErrorInk}" />
        </Style>

        <Style Selector="^.error /template/ Border#PART_Mark">
            <Setter Property="Background" Value="{DynamicResource Error}" />
        </Style>

        <!-- Accent, for a state called out without being good or bad. -->
        <Style Selector="^.accent">
            <Setter Property="Glyph" Value="InfoCircle" />
            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintLine}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTintInk}" />
        </Style>

        <Style Selector="^.accent /template/ Border#PART_Mark">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Workbench.Ui.Controls">

    <Styles.Resources>

    <!-- Every field that takes typing. A well is darker than everything around it and does not
         ride the depth ramp, so it reads as recessed at any level. -->

    <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
        <Setter Property="Height" Value="{DynamicResource HeightControl}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Background" Value="{DynamicResource SurfaceWell}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource InkMuted}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="IBeam" />

        <!-- The row tint and its ink, so a selection matches the rest of the system. -->
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentTint}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelectionInk}" />

        <!-- Off, so the focus halo is not cut flush with the border. -->
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- The halo's radius is grown from the control's rather than named,
                         so a field with a wider radius keeps a ring concentric with it.
                         The search field is 8 where every other field is 5. -->
                    <Border Name="PART_Halo"
                            Margin="{DynamicResource FocusHaloReach}"
                            BorderThickness="{DynamicResource FocusHaloThickness}"
                            BorderBrush="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius, Converter={x:Static ui:HaloRadius.Grown}}"
                            IsHitTestVisible="False" />

                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <DockPanel LastChildFill="True">
                            <ContentPresenter Name="PART_InnerLeft"
                                              DockPanel.Dock="Left"
                                              Content="{TemplateBinding InnerLeftContent}"
                                              VerticalAlignment="Center" />

                            <ContentPresenter Name="PART_InnerRight"
                                              DockPanel.Dock="Right"
                                              Content="{TemplateBinding InnerRightContent}"
                                              VerticalAlignment="Center" />

                            <Panel Margin="{TemplateBinding Padding}">
                                <TextBlock Name="PART_Placeholder"
                                           Text="{TemplateBinding PlaceholderText}"
                                           Foreground="{TemplateBinding PlaceholderForeground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center"
                                           IsVisible="False"
                                           IsHitTestVisible="False" />

                                <ScrollViewer Name="PART_ScrollViewer"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden">
                                    <TextPresenter Name="PART_TextPresenter"
                                                   Text="{TemplateBinding Text, Mode=TwoWay}"
                                                   CaretIndex="{TemplateBinding CaretIndex}"
                                                   CaretBrush="{TemplateBinding CaretBrush}"
                                                   SelectionStart="{TemplateBinding SelectionStart}"
                                                   SelectionEnd="{TemplateBinding SelectionEnd}"
                                                   SelectionBrush="{TemplateBinding SelectionBrush}"
                                                   SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                                   PasswordChar="{TemplateBinding PasswordChar}"
                                                   RevealPassword="{TemplateBinding RevealPassword}"
                                                   TextAlignment="{TemplateBinding TextAlignment}"
                                                   TextWrapping="{TemplateBinding TextWrapping}"
                                                   LineHeight="{TemplateBinding LineHeight}"
                                                   VerticalAlignment="Center" />
                                </ScrollViewer>
                            </Panel>
                        </DockPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- The control says when it holds nothing, so the placeholder needs no converter. -->
        <Style Selector="^:empty /template/ TextBlock#PART_Placeholder">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
        </Style>

        <!-- focus-within rather than focus, since what actually takes focus is the
             presenter inside the template. -->
        <Style Selector="^:focus-within">
            <Setter Property="Background" Value="{DynamicResource SurfaceWellFocus}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
        </Style>

        <Style Selector="^:focus-within /template/ Border#PART_Halo">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>

        <!-- A plain field holds language, so it takes the UI family. -->
        <Style Selector="^.mono">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        </Style>

        <!-- What a field looks like when what is in it will not do. -->
        <Style Selector="^[(DataValidationErrors.HasErrors)=True]">
            <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
            <Setter Property="Foreground" Value="{DynamicResource Error}" />
        </Style>

        <Style Selector="^.error">
            <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
            <Setter Property="Foreground" Value="{DynamicResource Error}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
            <Setter Property="PlaceholderForeground" Value="{DynamicResource InkDisabled}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <!-- A control theme is found by the exact type and never falls back to a base one, so
         a derived text box needs its own even when it wants the same look. -->
    <ControlTheme x:Key="{x:Type MaskedTextBox}" TargetType="MaskedTextBox"
                  BasedOn="{StaticResource {x:Type TextBox}}" />

    <!-- The one field with a wider radius in the design, which is what makes a filter read
         as a filter rather than as another property. The mark and the clear button live in
         the template rather than in the view, so every search field carries both. -->
    <ControlTheme x:Key="{x:Type ui:SearchBox}" TargetType="ui:SearchBox"
                  BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />

        <Setter Property="InnerLeftContent">
            <Template>
                <ui:Icon Glyph="Search"
                         Size="{DynamicResource IconSizeField}"
                         Margin="9,0,0,0"
                         VerticalAlignment="Center" />
            </Template>
        </Setter>

        <Setter Property="InnerRightContent">
            <Template>
                <Button Name="PART_Clear"
                        Theme="{StaticResource FieldButton}"
                        Margin="0,0,4,0"
                        ToolTip.Tip="Clear"
                        AutomationProperties.Name="Clear">
                    <ui:Icon Glyph="X" Size="{DynamicResource IconSizeCompact}" />
                </Button>
            </Template>
        </Setter>
    </ControlTheme>

    <!-- A mark inside a well that can be pressed. Keyed rather than a class on the button
         theme, for the reason the caption buttons are keyed: this is smaller than any
         button in the system and would inherit every height that theme gains. -->
    <ControlTheme x:Key="FieldButton" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMark}" />
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Arrow" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MarkOff}" />
        </Style>
    </ControlTheme>

    </Styles.Resources>

    <!-- Nothing to clear, so nothing to press. Out here rather than inside the theme, and both
         halves of that are forced. -->
    <Style Selector="ui|SearchBox:empty Button#PART_Clear">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Every field that takes typing, including the ones inside a spinner and a picker.
         :is, so a derived field is covered without a style of its own. -->
    <Style Selector=":is(TextBox)">
        <Setter Property="(ui:TextMenu.Shows)" Value="True" />
    </Style>

</Styles>

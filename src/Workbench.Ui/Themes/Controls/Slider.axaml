<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Workbench.Ui.Controls">

    <!-- A 3px track with a filled portion and a round knob. -->

    <ControlTheme x:Key="SliderKnob" TargetType="Thumb">
        <Setter Property="Width" Value="{DynamicResource SizeKnob}" />
        <Setter Property="Height" Value="{DynamicResource SizeKnob}" />
        <Setter Property="Background" Value="{DynamicResource InkChip}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- The halo is the border brush rather than a state of its own, so
                         the slider can turn it on with one setter. -->
                    <Ellipse Margin="{DynamicResource FocusHaloReach}"
                             Fill="{TemplateBinding BorderBrush}" />
                    <Ellipse Fill="{TemplateBinding Background}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- The two halves of the track either side of the knob. The filled one is the accent
         and the empty one shows the rail behind it, so neither draws a rail of its own. -->
    <ControlTheme x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Height" Value="{DynamicResource HeightTrack}" />
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMark}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="SliderEmpty" TargetType="RepeatButton"
                  BasedOn="{StaticResource SliderFill}">
        <Setter Property="Background" Value="Transparent" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
        <Setter Property="Height" Value="{DynamicResource HeightControl}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="{DynamicResource LineSeam}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <!-- Transparent, or the row between the track and the edge is not hit
                     tested and the slider can only be grabbed on the 3px line itself. -->
                <Border Background="Transparent">
                    <Panel VerticalAlignment="Center">
                        <Border Name="PART_Rail"
                                Height="{DynamicResource HeightTrack}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusMark}"
                                VerticalAlignment="Center" />

                        <!-- Behind the track and standing clear of it either side, which
                             is what makes a stop readable without drawing over the fill. -->
                        <TickBar Name="PART_TickBar"
                                 Height="{DynamicResource HeightTick}"
                                 Fill="{DynamicResource LineControl}"
                                 Minimum="{TemplateBinding Minimum}"
                                 Maximum="{TemplateBinding Maximum}"
                                 TickFrequency="{TemplateBinding TickFrequency}"
                                 Ticks="{TemplateBinding Ticks}"
                                 Orientation="Horizontal"
                                 Placement="Top"
                                 VerticalAlignment="Center"
                                 IsVisible="False" />

                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                               Orientation="Horizontal">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton"
                                              Theme="{StaticResource SliderFill}"
                                              Background="{TemplateBinding Foreground}" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton"
                                              Theme="{StaticResource SliderEmpty}" />
                            </Track.IncreaseButton>
                            <Thumb Name="PART_Thumb" Theme="{StaticResource SliderKnob}" />
                        </Track>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[TickPlacement=Outside] /template/ TickBar#PART_TickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource LineControl}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
        </Style>

        <Style Selector="^:pointerover /template/ Thumb#PART_Thumb">
            <Setter Property="Width" Value="{DynamicResource SizeKnobActive}" />
            <Setter Property="Height" Value="{DynamicResource SizeKnobActive}" />
            <Setter Property="Background" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource LineControl}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPressed}" />
        </Style>

        <Style Selector="^:pressed /template/ Thumb#PART_Thumb">
            <Setter Property="Width" Value="{DynamicResource SizeKnobActive}" />
            <Setter Property="Height" Value="{DynamicResource SizeKnobActive}" />
            <Setter Property="Background" Value="{DynamicResource InkKnobPressed}" />
        </Style>

        <Style Selector="^:focus-visible /template/ Thumb#PART_Thumb">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource LineControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource FillOff}" />
        </Style>

        <Style Selector="^:disabled /template/ Thumb#PART_Thumb">
            <Setter Property="Background" Value="{DynamicResource MarkOff}" />
        </Style>

        <Style Selector="^:disabled /template/ TickBar#PART_TickBar">
            <Setter Property="Fill" Value="{DynamicResource LineControlOff}" />
        </Style>
    </ControlTheme>

    <!-- The range slider's knobs. The dragged one brightens and takes the halo, which the
         Thumb already says through :pressed, so nothing has to be tracked to know which of
         the two is under the finger. -->
    <ControlTheme x:Key="RangeKnob" TargetType="Thumb" BasedOn="{StaticResource SliderKnob}">
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource InkPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>
    </ControlTheme>

    <!-- Two knobs and the fill between them. Everything it draws is the slider's, so the
         two cannot drift: the same rail, the same knob, the same track height. -->
    <ControlTheme x:Key="{x:Type ui:RangeSlider}" TargetType="ui:RangeSlider">
        <Setter Property="Height" Value="{DynamicResource HeightControl}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="{DynamicResource LineSeam}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Panel VerticalAlignment="Center">
                        <Border Name="PART_Rail"
                                Height="{DynamicResource HeightTrack}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusMark}"
                                VerticalAlignment="Center" />

                        <Canvas Name="PART_Track" ClipToBounds="False" Height="{DynamicResource SizeKnobActive}">
                            <Border Name="PART_Fill"
                                    Height="{DynamicResource HeightTrack}"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{DynamicResource RadiusMark}"
                                    Canvas.Top="5" />

                            <Thumb Name="PART_LowerThumb" Theme="{StaticResource RangeKnob}" Canvas.Top="1" />
                            <Thumb Name="PART_UpperThumb" Theme="{StaticResource RangeKnob}" Canvas.Top="1" />
                        </Canvas>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource LineControl}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource LineControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource FillOff}" />
        </Style>

        <Style Selector="^:disabled /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource MarkOff}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>

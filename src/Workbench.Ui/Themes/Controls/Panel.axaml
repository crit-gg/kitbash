<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Workbench.Ui.Controls">

    <Styles.Resources>

    <!-- The surfaces a tool is assembled from. Both of these say Surface.Nests and
         nothing else about their tone, so the ramp in Themes/Surfaces.axaml paints them
         and neither one counts its own depth. -->

    <!-- A header over a body with a footer under it. One tone throughout: the header and
         the footer sit on the body's fill and are told apart by a hairline alone, so a
         fill change means a different panel and never a different part of this one.

         The hairline is the panel's own border brush, which is the seam belonging to its
         tone, so it deepens with the frame rather than staying put. -->
    <ControlTheme x:Key="{x:Type ui:SurfacePanel}" TargetType="ui:SurfacePanel">
        <Setter Property="(ui:Surface.Nests)" Value="True" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />

        <!-- What a body holding rows or further panels wants. A body holding a form wants
             more, and says so. -->
        <Setter Property="Padding" Value="6" />

        <Setter Property="Template">
            <ControlTemplate>
                <!-- Two borders rather than one: a clip on the border that draws the
                     stroke would cut the corner into two colours. -->
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Border CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                        <DockPanel LastChildFill="True">
                            <Border Name="PART_HeaderRow"
                                    DockPanel.Dock="Top"
                                    Height="{DynamicResource HeightPanelHeader}"
                                    Padding="10,0"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    IsVisible="{Binding $parent[ui:SurfacePanel].Header, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <ContentPresenter Name="PART_HeaderPresenter"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontSize="{DynamicResource FontSizeBody}"
                                                  TextElement.FontWeight="{DynamicResource FontWeightMedium}"
                                                  TextElement.Foreground="{DynamicResource InkSecondary}" />
                            </Border>

                            <Border Name="PART_FooterRow"
                                    DockPanel.Dock="Bottom"
                                    Height="{DynamicResource HeightPanelFooter}"
                                    Padding="10,0"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    IsVisible="{Binding $parent[ui:SurfacePanel].Footer, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <ContentPresenter Name="PART_Footer"
                                                  Content="{TemplateBinding Footer}"
                                                  ContentTemplate="{TemplateBinding FooterTemplate}"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontFamily="{DynamicResource FontFamilyMono}"
                                                  TextElement.FontSize="{DynamicResource FontSizeSmall}"
                                                  TextElement.Foreground="{DynamicResource InkMuted}" />
                            </Border>

                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </DockPanel>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- The collapsible one. The design draws no specimen, so this is a SurfacePanel
         whose header is the switch, and it takes every value from there rather than
         inventing a second look for the same shape.

         The header is a ToggleButton because the control itself handles no input at all,
         which was measured rather than assumed: Expander in Avalonia 12 has no pointer
         handling and no field for its header, so a template that only presents the
         header can never be opened. -->
    <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
        <Setter Property="(ui:Surface.Nests)" Value="True" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="6" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Border CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                        <DockPanel LastChildFill="True">
                            <ToggleButton Name="PART_Toggle"
                                          DockPanel.Dock="Top"
                                          Theme="{StaticResource ExpanderHeader}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding $parent[Expander].IsExpanded, Mode=TwoWay}">
                                <DockPanel LastChildFill="True">
                                    <ui:Icon Name="PART_Chevron"
                                             DockPanel.Dock="Left"
                                             Glyph="ChevronRight"
                                             Size="{DynamicResource IconSizeSmall}"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center" />
                                    <ContentPresenter Name="PART_HeaderPresenter"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      VerticalAlignment="Center" />
                                </DockPanel>
                            </ToggleButton>

                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              IsVisible="{TemplateBinding IsExpanded}" />
                        </DockPanel>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:expanded /template/ ui|Icon#PART_Chevron">
            <Setter Property="Glyph" Value="ChevronDown" />
        </Style>

        <!-- Closed, the seam under the header would rule off nothing, so it goes. -->
        <Style Selector="^:not(:expanded) /template/ ToggleButton#PART_Toggle">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>
    </ControlTheme>

    <!-- The expander's header. Keyed rather than a class on the ToggleButton theme, for
         the reason the caption buttons are keyed: a panel header is a row rather than a
         control, and a class would inherit every height and fill the shared theme gains. -->
    <ControlTheme x:Key="ExpanderHeader" TargetType="ToggleButton">
        <Setter Property="Height" Value="{DynamicResource HeightPanelHeader}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>
    </ControlTheme>

    <!-- The small capitalised label over a group, with a rule filling what is left of the
         row and an optional note at the end. A header over content is what a
         HeaderedContentControl already is, so the label is the header and the note is the
         content, and nothing new is built for it.

         Keyed, so a plain HeaderedContentControl keeps whatever look it is given
         elsewhere and only a label asking for this one gets it. -->
    <ControlTheme x:Key="SectionLabel" TargetType="HeaderedContentControl">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel LastChildFill="True">
                    <ContentPresenter Name="PART_HeaderPresenter"
                                      DockPanel.Dock="Left"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      VerticalAlignment="Center"
                                      TextElement.FontFamily="{DynamicResource FontFamilyUi}"
                                      TextElement.FontSize="{DynamicResource FontSizeSmall}"
                                      TextElement.FontWeight="{DynamicResource FontWeightStrong}"
                                      TextElement.LetterSpacing="{DynamicResource LetterSpacingLabel}"
                                      TextElement.Foreground="{DynamicResource InkMuted}" />

                    <ContentPresenter Name="PART_ContentPresenter"
                                      DockPanel.Dock="Right"
                                      Margin="9,0,0,0"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding $parent[HeaderedContentControl].Content, Converter={x:Static ObjectConverters.IsNotNull}}"
                                      TextElement.FontFamily="{DynamicResource FontFamilyMono}"
                                      TextElement.FontSize="{DynamicResource FontSizeSmall}"
                                      TextElement.Foreground="{DynamicResource InkMuted}" />

                    <!-- The rule takes the seam of the tone it is on, so it stays visible
                         at depth. Themes/Surfaces.axaml holds that. -->
                    <Border Classes="seam"
                            Height="1"
                            Margin="9,0,0,0"
                            VerticalAlignment="Center" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    </Styles.Resources>

    <!-- A panel with nothing in it yet. Classes rather than a control, the way the status
         bar readouts are: a mark, a line and one action, with no behaviour of its own.

         The design draws a neutral square where the glyph belongs, the way it does
         everywhere an icon goes, so the view names the glyph. Empty states take the
         large icon size. -->
    <Style Selector="StackPanel.emptyState">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Spacing" Value="8" />
    </Style>

    <Style Selector="StackPanel.emptyState > ui|Icon">
        <Setter Property="Size" Value="{DynamicResource IconSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="StackPanel.emptyState > TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="StackPanel.emptyState > Button">
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

</Styles>

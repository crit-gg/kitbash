<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Workbench.Ui.Controls">

    <!-- Everything that floats, in one file, so a menu and a dropdown cannot drift apart.

         The overlay surface is `SurfaceNest2` on a `LineControl` edge at `RadiusControl`,
         with a real shadow. That is the whole rule, and it is written the same way in
         every theme below rather than aliased, so a grep for SurfaceNest2 in this file
         finds every floating thing at once.

         The radius is the control radius, not a larger one. A popover reads as an
         extension of the trigger that opened it rather than a separate card.

         Shadow is `ShadowPopup` for a menu, a dropdown or a tooltip, and `ShadowOverlay`
         for a popover, which is the only one large enough to need it. -->

    <!-- The drop every overlay opens with. A translate and a fade over 110ms.
         TranslateTransform.Y is animated against a real TranslateTransform instance. A
         keyframe on RenderTransform throws at startup, and one against a
         TransformOperations value does nothing at all. Both are in .claude/avalonia.md. -->
    <ControlTheme x:Key="OverlayRoot" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceNest2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowPopup}" />
    </ControlTheme>

    <!-- A row in a menu. 26px, inset as a pill, with the shortcut right aligned in mono
         so a column of them lines up. -->
    <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
        <Setter Property="Height" Value="{DynamicResource HeightControl}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <ContentPresenter Grid.Column="0" Name="PART_IconPresenter"
                                          Content="{TemplateBinding Icon}"
                                          Width="{DynamicResource IconSizeSmall}"
                                          Margin="0,0,9,0"
                                          VerticalAlignment="Center"
                                          IsVisible="False" />

                        <ContentPresenter Grid.Column="1" Name="PART_HeaderPresenter"
                                          Content="{TemplateBinding Header}"
                                          VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2" Name="PART_Gesture"
                                   Margin="18,0,0,0"
                                   Text="{Binding $parent[MenuItem].InputGesture, Converter={x:Static ui:GestureText.Instance}}"
                                   IsVisible="{Binding $parent[MenuItem].InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   FontFamily="{DynamicResource FontFamilyMono}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource InkMuted}"
                                   VerticalAlignment="Center" />

                        <ui:Icon Grid.Column="3" Name="PART_SubMenuMark"
                                 Glyph="ChevronRight"
                                 Size="{DynamicResource IconSizeCompact}"
                                 Margin="9,0,0,0"
                                 Foreground="{DynamicResource InkMuted}"
                                 IsVisible="{Binding $parent[MenuItem].HasSubMenu}" />

                        <Popup Name="PART_Popup"
                               WindowManagerAddShadowHint="False"
                               Placement="RightEdgeAlignedTop"
                               HorizontalOffset="4"
                               IsLightDismissEnabled="False"
                               IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
                            <Border Theme="{StaticResource OverlayRoot}" Padding="5">
                                <ItemsPresenter Name="PART_ItemsPresenter" />
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:icon /template/ ContentPresenter#PART_IconPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:selected /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
        </Style>

        <!-- A destructive item takes the error ink and keeps the ordinary hover, so it
             reads as dangerous without becoming a red button in a list. -->
        <Style Selector="^.danger">
            <Setter Property="Foreground" Value="{DynamicResource Error}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>

        <Style Selector="^:disabled /template/ TextBlock#PART_Gesture">
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>
    </ControlTheme>

    <!-- A hairline with room around it, not a full width rule. -->
    <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="7,5" />
        <Setter Property="Background" Value="{DynamicResource LineControl}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Theme="{StaticResource OverlayRoot}" Padding="5"
                        Margin="{DynamicResource OverlayGap}">
                    <ItemsPresenter Name="PART_ItemsPresenter" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Theme="{StaticResource OverlayRoot}" Padding="5"
                        Margin="{DynamicResource OverlayGap}">
                    <ItemsPresenter Name="PART_ItemsPresenter" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- A flyout with arbitrary content, which is what a dropdown popup opens into. -->
    <ControlTheme x:Key="{x:Type FlyoutPresenter}" TargetType="FlyoutPresenter">
        <Setter Property="Padding" Value="5" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Theme="{StaticResource OverlayRoot}" Padding="{TemplateBinding Padding}"
                        Margin="{DynamicResource OverlayGap}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- A popover is a card rather than a list of actions, so it brings its own
             padding and the presenter gets out of the way. -->
        <Style Selector="^.popover">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="^.popover /template/ Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="{DynamicResource ShadowNone}" />
        </Style>
    </ControlTheme>

    <!-- Small, the same surface, and it never takes the pointer. -->
    <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="MinHeight" Value="{DynamicResource HeightTooltip}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        <Setter Property="MaxWidth" Value="320" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Theme="{StaticResource OverlayRoot}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- A popover: header, body, footer, all on the popover tone and separated only by
         hairlines, which is the panel rule applied to something floating.

         It differs from a menu in three ways the design states outright. Rows are full
         bleed rather than inset pills, because they carry two lines and a badge. The
         current row takes the selection tint rather than a check mark. The footer
         actions are inset pills, because they behave like menu items rather than list
         entries. Those are rules about the content, so the launcher supplies it. -->
    <ControlTheme x:Key="{x:Type ui:Popover}" TargetType="ui:Popover">
        <Setter Property="Background" Value="{DynamicResource SurfaceNest2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />

        <Setter Property="Template">
            <ControlTemplate>
                <!-- Two borders: the outer draws the stroke and the shadow, the inner
                     clips. A single border cannot do both, because clipping to bounds
                     clips the stroke's own children to the outer rounded rectangle and
                     leaves a corner artefact. Measured once in the launcher already. -->
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource ShadowOverlay}">
                    <Border CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Border Grid.Row="0" Name="PART_Header"
                                    BorderBrush="{DynamicResource LineControl}"
                                    BorderThickness="0,0,0,1"
                                    Padding="13,10"
                                    IsVisible="{Binding $parent[ui:Popover].Header, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <ContentPresenter Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}" />
                            </Border>

                            <ContentPresenter Grid.Row="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <Border Grid.Row="2" Name="PART_Footer"
                                    BorderBrush="{DynamicResource LineControl}"
                                    BorderThickness="0,1,0,0"
                                    Padding="5"
                                    IsVisible="{Binding $parent[ui:Popover].Footer, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <ContentPresenter Content="{TemplateBinding Footer}" />
                            </Border>
                        </Grid>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Dropped into a panel it is not floating, so it gives up the shadow and the
             surface and takes whatever it was placed on. The body is unchanged, which is
             the whole point of the class. -->
        <Style Selector="^.inPanel /template/ Border#PART_Root">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="{DynamicResource ShadowNone}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>

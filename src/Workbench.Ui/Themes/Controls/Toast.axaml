<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Workbench.Ui.Controls"
                    xmlns:toasts="clr-namespace:Workbench.Ui.Toasts">

    <!-- A toast is a popover that nobody opened, so it takes the popover treatment
         exactly: SurfaceNest2 on a LineControl edge with ShadowOverlay. Everything here
         is stage 5's overlay surface reused rather than a second definition of it.

         The one thing this file adds to that surface is the rule about the bar along the
         foot. A card with no bar is a card that will not go away by itself, so the bar is
         never decoration and never optional on a card that dwells. -->

    <!-- The bar. Two pixels, square, and driven by the built in ProgressBar, which sizes
         its own indicator from the value. It says time left on a card that is counting
         down and work done on one that is reporting progress, which is why it has one
         name and not two.

         Keyed rather than a class on the ProgressBar theme, for the reason the caption
         buttons are keyed: that theme is 6px with a mark radius, and a class would take
         both back the moment either moved. -->
    <ControlTheme x:Key="ToastMeter" TargetType="ProgressBar">
        <Setter Property="Height" Value="{DynamicResource HeightToastMeter}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SurfaceWell}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Track"
                        Background="{TemplateBinding Background}"
                        ClipToBounds="True">
                    <Border Name="PART_Indicator"
                            Background="{TemplateBinding Foreground}"
                            HorizontalAlignment="Left" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- One toast, drawn. Three templates, one per form, chosen by the class the card
         puts on itself. The tier styles below reach into whichever of the three is up,
         and a part that form does not draw is simply not there to be matched. -->
    <ControlTheme x:Key="{x:Type ui:ToastCard}" TargetType="ui:ToastCard">
        <Setter Property="Padding" Value="{DynamicResource PaddingToast}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceNest2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />

        <!-- The shadow is drawn outside the frame, so the card must not clip.

             Measured with the clip left on: the shadow was cut off flush with the card's
             rectangle, which took away all of it except the wedge at each rounded corner,
             where the card's own bounds are outside its curve. Four dark corners and no
             shadow at all. -->
        <Setter Property="ClipToBounds" Value="False" />

        <!-- One width for every region, so a card reads the same wherever it lands and a
             stack never changes shape as its cards come and go. The compact form takes
             this back below, since it is only as wide as its words. -->
        <Setter Property="Width" Value="{DynamicResource WidthToast}" />

        <!-- The card scales as it falls back in the stack, and a scale is not layout, so
             nothing moves when it does. -->
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource ShadowOverlay}"
                        RenderTransform="scale(1)">
                    <Border.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                        </Transitions>
                    </Border.Transitions>

                    <!-- Two borders, because the bar fills the foot corner to corner. A
                         Border clips to its outer radius, so a child painting to the edge
                         clears the stroke along a straight run and covers it at a corner.
                         Inset by the border thickness, this one clears it everywhere. -->
                    <Border Name="PART_Frame"
                            CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                        <DockPanel LastChildFill="True">
                            <ProgressBar Name="PART_Meter"
                                         DockPanel.Dock="Bottom"
                                         Theme="{StaticResource ToastMeter}"
                                         Value="{Binding Meter, RelativeSource={RelativeSource TemplatedParent}}" />

                            <DockPanel LastChildFill="True" Margin="{TemplateBinding Padding}">
                                <Border Name="PART_Mark"
                                        DockPanel.Dock="Left"
                                        Width="{DynamicResource SizeToastMark}"
                                        Height="{DynamicResource SizeToastMark}"
                                        Margin="0,1,10,0"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusControl}"
                                        VerticalAlignment="Top">
                                    <ui:Icon Name="PART_MarkIcon"
                                             Size="{DynamicResource IconSizeStatus}"
                                             Classes.spin="{Binding IsBusy, RelativeSource={RelativeSource TemplatedParent}}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Border>

                                <Button Name="PART_Close"
                                        DockPanel.Dock="Right"
                                        Classes="icon"
                                        VerticalAlignment="Top"
                                        Command="{Binding Close, RelativeSource={RelativeSource TemplatedParent}}"
                                        ToolTip.Tip="Dismiss"
                                        AutomationProperties.Name="Dismiss">
                                    <ui:Icon Glyph="X" Size="{DynamicResource IconSizeDismiss}" />
                                </Button>

                                <StackPanel Spacing="4">
                                    <DockPanel LastChildFill="True">
                                        <Border Name="PART_Count"
                                                DockPanel.Dock="Right"
                                                Margin="7,0,0,0"
                                                Height="{DynamicResource HeightPill}"
                                                Padding="6,0"
                                                Background="{DynamicResource SurfaceNest3}"
                                                BorderBrush="{DynamicResource LineControlDeep}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource RadiusSurface}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Toast.Count, RelativeSource={RelativeSource TemplatedParent}, StringFormat='x{0}'}"
                                                       FontFamily="{DynamicResource FontFamilyMono}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       FontWeight="{DynamicResource FontWeightStrong}"
                                                       Foreground="{DynamicResource InkSecondary}"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Name="PART_Title"
                                                   Text="{Binding Toast.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="{DynamicResource FontSizeControl}"
                                                   FontWeight="{DynamicResource FontWeightStrong}"
                                                   Foreground="{DynamicResource InkTitle}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock Name="PART_Body"
                                               Text="{Binding Toast.Body, RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{DynamicResource InkSecondary}"
                                               TextWrapping="Wrap" />

                                    <ItemsControl Name="PART_Actions"
                                                  Margin="0,5,0,0"
                                                  ItemsSource="{Binding Toast.Actions, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="7" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="toasts:ToastAction">
                                                <Button Theme="{StaticResource CompactButton}"
                                                        Classes.primary="{Binding IsPrimary}"
                                                        Content="{Binding Text}"
                                                        Command="{Binding $parent[ui:ToastCard].Run}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Compact. An acknowledgement is a glyph, a line and a way to close it, and it
             is as wide as its words rather than as wide as a card. -->
        <Style Selector="^.compact">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="{DynamicResource HeightToastCompact}" />
            <Setter Property="Padding" Value="10,0,6,0" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BoxShadow="{DynamicResource ShadowOverlay}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransform="scale(1)">
                        <Border.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                            </Transitions>
                        </Border.Transitions>

                        <Border Name="PART_Frame" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <ui:Icon Name="PART_MarkIcon"
                                     Size="{DynamicResource IconSizeStatus}"
                                     Classes.spin="{Binding IsBusy, RelativeSource={RelativeSource TemplatedParent}}"
                                     VerticalAlignment="Center" />

                            <TextBlock Name="PART_Title"
                                       Text="{Binding Toast.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource InkPrimary}"
                                       VerticalAlignment="Center" />

                            <Button Name="PART_Close"
                                    Classes="icon"
                                    Command="{Binding Close, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip.Tip="Dismiss"
                                    AutomationProperties.Name="Dismiss">
                                <ui:Icon Glyph="X" Size="{DynamicResource IconSizeDismiss}" />
                            </Button>
                        </StackPanel>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- The undo bar. One line saying what changed and one way to put it back, in a
             row rather than a card, because nobody reads a card to press Undo.

             It keeps the bar, which the design does not draw on this form. It is the one
             short form carrying something worth pressing, and a hidden clock on a button
             a person means to press is exactly what the bar exists to prevent. The
             compact form has nothing to press and keeps the design's plain pill. -->
        <Style Selector="^.undo">
            <Setter Property="Height" Value="{DynamicResource HeightToastUndo}" />
            <Setter Property="Padding" Value="11,0,8,0" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BoxShadow="{DynamicResource ShadowOverlay}"
                            RenderTransform="scale(1)">
                        <Border.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                            </Transitions>
                        </Border.Transitions>

                        <Border Name="PART_Frame"
                                CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                        <DockPanel LastChildFill="True">
                        <ProgressBar Name="PART_Meter"
                                     DockPanel.Dock="Bottom"
                                     Theme="{StaticResource ToastMeter}"
                                     Value="{Binding Meter, RelativeSource={RelativeSource TemplatedParent}}" />

                        <DockPanel LastChildFill="True" Margin="{TemplateBinding Padding}">
                            <Button Name="PART_Close"
                                    DockPanel.Dock="Right"
                                    Classes="icon"
                                    VerticalAlignment="Center"
                                    Command="{Binding Close, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip.Tip="Dismiss"
                                    AutomationProperties.Name="Dismiss">
                                <ui:Icon Glyph="X" Size="{DynamicResource IconSizeDismiss}" />
                            </Button>

                            <ItemsControl Name="PART_Actions"
                                          DockPanel.Dock="Right"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding Toast.Actions, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="toasts:ToastAction">
                                        <!-- The glyph belongs to the form rather than to
                                             the action. An undo bar is the one place a
                                             toast's action carries a mark, and it is
                                             always the same mark, so no caller names it. -->
                                        <Button Theme="{StaticResource CompactButton}"
                                                Classes="link"
                                                Command="{Binding $parent[ui:ToastCard].Run}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ui:Icon Glyph="Undo"
                                                         Size="{DynamicResource IconSizeStatus}"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Name="PART_Title"
                                       Text="{Binding Toast.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource InkPrimary}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        </DockPanel>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- What each part draws when it has nothing to say. Classes rather than bindings,
             because the card has already worked all four out and a null toast would leave
             a binding reporting nothing at all. -->
        <Style Selector="^:not(.hasBody) /template/ TextBlock#PART_Body">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:not(.hasActions) /template/ ItemsControl#PART_Actions">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:not(.grouped) /template/ Border#PART_Count">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:not(.meter) /template/ ProgressBar#PART_Meter">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- The tiers. The mark is the same tinted pair the chips and the status marks
             use, so nothing new enters the palette, and the bar takes the tier's own
             colour so a card says the same thing twice over.

             Info takes AccentTint, which the design brightened after this page was drawn.
             Every accent tinted fill moved with it and this is one of them. -->
        <Style Selector="^.info /template/ Border#PART_Mark">
            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintLine}" />
        </Style>

        <Style Selector="^.info /template/ ui|Icon#PART_MarkIcon">
            <Setter Property="Glyph" Value="InfoCircle" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="^.info /template/ ProgressBar#PART_Meter">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="^.ok /template/ Border#PART_Mark">
            <Setter Property="Background" Value="{DynamicResource OkSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OkLine}" />
        </Style>

        <Style Selector="^.ok /template/ ui|Icon#PART_MarkIcon">
            <Setter Property="Glyph" Value="Check" />
            <Setter Property="Foreground" Value="{DynamicResource Ok}" />
        </Style>

        <Style Selector="^.ok /template/ ProgressBar#PART_Meter">
            <Setter Property="Foreground" Value="{DynamicResource Ok}" />
        </Style>

        <Style Selector="^.warn /template/ Border#PART_Mark">
            <Setter Property="Background" Value="{DynamicResource WarnSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarnLine}" />
        </Style>

        <Style Selector="^.warn /template/ ui|Icon#PART_MarkIcon">
            <Setter Property="Glyph" Value="AlertTriangle" />
            <Setter Property="Foreground" Value="{DynamicResource Warn}" />
        </Style>

        <Style Selector="^.warn /template/ ProgressBar#PART_Meter">
            <Setter Property="Foreground" Value="{DynamicResource Warn}" />
        </Style>

        <Style Selector="^.error /template/ Border#PART_Mark">
            <Setter Property="Background" Value="{DynamicResource ErrorSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorLine}" />
        </Style>

        <Style Selector="^.error /template/ ui|Icon#PART_MarkIcon">
            <Setter Property="Glyph" Value="AlertCircle" />
            <Setter Property="Foreground" Value="{DynamicResource Error}" />
        </Style>

        <Style Selector="^.error /template/ ProgressBar#PART_Meter">
            <Setter Property="Foreground" Value="{DynamicResource Error}" />
        </Style>

        <!-- Busy holds its square still and turns the glyph inside it. Recorded because
             the design was corrected on this exact point: turning the whole mark swings
             the tint and the border around with it. The turn is the shared spin style
             from Themes/Motion.axaml rather than an animation written here. -->
        <Style Selector="^.busy /template/ Border#PART_Mark">
            <Setter Property="Background" Value="{DynamicResource SurfaceNest3}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlDeep}" />
        </Style>

        <Style Selector="^.busy /template/ ui|Icon#PART_MarkIcon">
            <Setter Property="Glyph" Value="RefreshCw" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
        </Style>

        <Style Selector="^.busy /template/ ProgressBar#PART_Meter">
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
        </Style>

        <!-- Where the card sits, which is what decides the corner it scales toward and
             the edge it arrives from. Two classes, a column and a row, so a corner is the
             two of them together rather than one of eight names. -->
        <Style Selector="^.atLeft">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="^.atCenter">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="^.atRight">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style Selector="^.atLeft.atTop /template/ Border#PART_Root">
            <Setter Property="RenderTransformOrigin" Value="0%,0%" />
        </Style>

        <Style Selector="^.atCenter.atTop /template/ Border#PART_Root">
            <Setter Property="RenderTransformOrigin" Value="50%,0%" />
        </Style>

        <Style Selector="^.atRight.atTop /template/ Border#PART_Root">
            <Setter Property="RenderTransformOrigin" Value="100%,0%" />
        </Style>

        <!-- The side centres grow down from their midpoint, so they scale from the top the
             way the top row does. -->
        <Style Selector="^.atLeft.atMiddle /template/ Border#PART_Root">
            <Setter Property="RenderTransformOrigin" Value="0%,0%" />
        </Style>

        <Style Selector="^.atRight.atMiddle /template/ Border#PART_Root">
            <Setter Property="RenderTransformOrigin" Value="100%,0%" />
        </Style>

        <Style Selector="^.atLeft.atBottom /template/ Border#PART_Root">
            <Setter Property="RenderTransformOrigin" Value="0%,100%" />
        </Style>

        <Style Selector="^.atCenter.atBottom /template/ Border#PART_Root">
            <Setter Property="RenderTransformOrigin" Value="50%,100%" />
        </Style>

        <Style Selector="^.atRight.atBottom /template/ Border#PART_Root">
            <Setter Property="RenderTransformOrigin" Value="100%,100%" />
        </Style>

        <!-- Older cards fall back rather than stacking flat, so the newest is always the
             one being read. Three deep, because a region shows three.

             A card behind keeps the whole shape of a card and runs on under the one in
             front of it, so the end facing that card is hidden rather than changed.

             It was cut square there first, which is wrong for a reason only a corner
             shows: the front card's radius leaves a notch at each of its corners, the
             card behind is what fills that notch, and a square corner with a straight
             edge running up through a curve reads as a card in front rather than one
             behind. A rounded end nested inside that notch reads as what it is.

             The tucked end is frame and nothing else, so the body is held back by the
             same amount and clipped there. A card behind is faded, and its own content
             left under the card in front reads through as a second line of text across
             the deck. -->
        <Style Selector="^.depth1 /template/ Border#PART_Frame, ^.depth2 /template/ Border#PART_Frame">
            <Setter Property="Margin" Value="{DynamicResource MarginToastTuck}" />
        </Style>

        <Style Selector="^.depth1">
            <Setter Property="Opacity" Value="{DynamicResource OpacityToastDepth1}" />
        </Style>

        <Style Selector="^.depth1 /template/ Border#PART_Root">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <Style Selector="^.depth2">
            <Setter Property="Opacity" Value="{DynamicResource OpacityToastDepth2}" />
        </Style>

        <Style Selector="^.depth2 /template/ Border#PART_Root">
            <Setter Property="RenderTransform" Value="scale(0.94)" />
        </Style>

        <!-- A card behind is a strip of its top, and the bar lives along its foot, so the
             bar would land under the strip and read as a coloured rule ruling nothing off.
             Nobody is watching a clock they cannot see the card for. -->
        <Style Selector="^.depth1 /template/ ProgressBar#PART_Meter, ^.depth2 /template/ ProgressBar#PART_Meter">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Entry. A card slides 12px from the nearest edge, and the two centre columns
             slide vertically instead, having no near edge.

             The keyframes name TranslateTransform.X rather than RenderTransform, because
             a keyframe against RenderTransform throws and one against a
             TransformOperations value does nothing at all and logs nothing. The scale
             above is a transition on a different element for that same reason, so the two
             never share a transform. Recorded in .claude/avalonia.md. -->
        <Style Selector="^.atLeft">
            <Style.Animations>
                <Animation Duration="0:0:0.16" FillMode="None" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="-12" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^.atRight">
            <Style.Animations>
                <Animation Duration="0:0:0.16" FillMode="None" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="12" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^.atCenter.atTop">
            <Style.Animations>
                <Animation Duration="0:0:0.16" FillMode="None" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-12" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^.atCenter.atBottom">
            <Style.Animations>
                <Animation Duration="0:0:0.16" FillMode="None" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="12" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Exit. The service keeps a dismissed toast for exactly this long before taking
             it out of the region, so the fade and the removal are one number rather than
             two that have to be kept in step. FillMode holds it at nothing, since the card
             is still there for the rest of the tick. Declared last, so it beats the entry
             on a card dismissed while it was still arriving. -->
        <Style Selector="^.leaving">
            <Style.Animations>
                <Animation Duration="0:0:0.12" FillMode="Forward" Easing="LinearEasing">
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <!-- One region's cards. It has no fill, so it is not hit tested and the page under it
         is reachable everywhere a card is not. The cards are, which is how a pointer
         reaches this at all and pauses this region and only this region. -->
    <ControlTheme x:Key="{x:Type ui:ToastStack}" TargetType="ui:ToastStack">
        <Setter Property="Padding" Value="{DynamicResource PaddingToastRegion}" />

        <!-- A card's shadow falls outside the card, and a stack wraps its cards tightly,
             so both this and the items control inside it have to let it out. Measured with
             the clips left on: the shadow reached two pixels below a card and nothing at
             all to either side. Only the host clips, and it does so on purpose, which is
             what keeps a panel's toasts in the panel. -->
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel LastChildFill="True" Margin="{TemplateBinding Padding}">
                    <!-- What is held back. Away from the anchored edge, so the newest card
                         keeps the corner and the count is read last. -->
                    <Border Name="PART_More"
                            DockPanel.Dock="Top"
                            Margin="{DynamicResource MarginToast}"
                            Height="{DynamicResource HeightPill}"
                            Padding="7,0"
                            Background="{DynamicResource SurfaceNest2}"
                            BorderBrush="{DynamicResource LineControl}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSurface}"
                            IsVisible="{Binding HasWaiting, RelativeSource={RelativeSource TemplatedParent}}">
                        <TextBlock Text="{Binding Region.Waiting, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0} more'}"
                                   FontFamily="{DynamicResource FontFamilyUi}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource InkMuted}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <ItemsControl Name="PART_Items"
                                  ClipToBounds="False"
                                  ItemsSource="{Binding Region.Visible, RelativeSource={RelativeSource TemplatedParent}}">
                        <!-- A deck rather than a column. Only the newest card is whole and
                             the ones behind it show a strip of their top edge, which is
                             what the design draws and what keeps three cards from being
                             most of a window. -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ui:ToastDeck Peek="{DynamicResource PeekToast}"
                                              Tuck="{DynamicResource TuckToast}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="toasts:Toast">
                                <ui:ToastCard Toast="{Binding}"
                                              Anchor="{Binding $parent[ui:ToastStack].Anchor}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.atLeft">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="^.atCenter">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="^.atRight">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style Selector="^.atTop">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style Selector="^.atMiddle">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="^.atBottom">
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style Selector="^.atLeft /template/ Border#PART_More">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="^.atCenter /template/ Border#PART_More">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="^.atRight /template/ Border#PART_More">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </ControlTheme>

    <!-- Where one service draws. Eight regions over whatever this is placed in, and it
         clips, so a panel's toasts stay in the panel.

         The centre cell is empty on purpose. The document area is never covered by more
         than one region, which is what the eight of them are arranged around. -->
    <ControlTheme x:Key="{x:Type ui:ToastHost}" TargetType="ui:ToastHost">
        <Setter Property="ClipToBounds" Value="True" />

        <Setter Property="Template">
            <ControlTemplate>
                <!-- A Panel rather than a grid of nine cells. Every stack is given the
                     whole surface and puts itself where its anchor says, which is what
                     its alignment classes already decide.

                     Measured with a three by three grid first, and it was wrong twice
                     over: a 352 card in a third of a 1000px window was cut off at both
                     side edges, and three tall cards came to 280 in a 233 row, which
                     arranged from the top and put the newest card, the one nearest the
                     anchored edge, off the bottom of the window. A cell can be smaller
                     than a card and the whole surface never is. -->
                <Panel>
                    <ui:ToastStack Anchor="TopLeft" Service="{TemplateBinding Service}" />
                    <ui:ToastStack Anchor="TopCenter" Service="{TemplateBinding Service}" />
                    <ui:ToastStack Anchor="TopRight" Service="{TemplateBinding Service}" />

                    <ui:ToastStack Anchor="LeftCenter" Service="{TemplateBinding Service}" />
                    <ui:ToastStack Anchor="RightCenter" Service="{TemplateBinding Service}" />

                    <ui:ToastStack Anchor="BottomLeft" Service="{TemplateBinding Service}" />
                    <ui:ToastStack Anchor="BottomCenter" Service="{TemplateBinding Service}" />
                    <ui:ToastStack Anchor="BottomRight" Service="{TemplateBinding Service}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>

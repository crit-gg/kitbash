<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Workbench.Ui.Controls">

    <Styles.Resources>

    <!-- The date and time fields, and the two popovers they open.

         Both fields are a well with an adorner inside it, the same rule every value editor
         follows, and both values read in mono so a column of dates lines up.

         Avalonia ships two date families and these take one from each. CalendarDatePicker
         opens a month grid and TimePicker opens snapping columns, which is what the design
         draws. Taking one family for both would mean fighting whichever one lost.

         Nothing here writes a day name, a month name or a field order. Those come from the
         culture the app is running under, which is why the design's Mo Tu We is one locale
         rather than a specification. -->

    <!-- A day in the month grid. Six states and no two of them say the same thing: a day
         from a neighbouring month is dimmed, today carries a ring and no fill, and the
         chosen day carries the selection tint. -->
    <ControlTheme x:Key="{x:Type CalendarDayButton}" TargetType="CalendarDayButton">
        <Setter Property="Height" Value="{DynamicResource HeightControl}" />
        <Setter Property="MinWidth" Value="{DynamicResource HeightControl}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Halo"
                            Margin="{DynamicResource FocusHaloReach}"
                            BorderThickness="{DynamicResource FocusHaloThickness}"
                            BorderBrush="Transparent"
                            CornerRadius="{DynamicResource RadiusControlHalo}" />

                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:inactive">
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
        </Style>

        <!-- A ring rather than a fill, so today and the chosen day can both be true of one
             cell without either hiding the other. -->
        <Style Selector="^:today">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintLine}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTintInk}" />
        </Style>

        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
            <Setter Property="Foreground" Value="{DynamicResource SelectionInk}" />
        </Style>

        <Style Selector="^:dayfocused /template/ Border#PART_Halo">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>

        <Style Selector="^:blackout, ^:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MarkOff}" />
        </Style>
    </ControlTheme>

    <!-- A month or a year, in the views the header opens. The same cell, wider. -->
    <ControlTheme x:Key="{x:Type CalendarButton}" TargetType="CalendarButton">
        <Setter Property="Height" Value="{DynamicResource HeightGridRow}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        <Setter Property="Cursor" Value="Arrow" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:inactive">
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
        </Style>

        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
            <Setter Property="Foreground" Value="{DynamicResource SelectionInk}" />
        </Style>
    </ControlTheme>

    <!-- The step buttons either side of the month name, and the name itself, which opens
         the year view. Keyed, since a 24px square would inherit every height the shared
         button theme gains. -->
    <ControlTheme x:Key="CalendarStep" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource SizeIconButton}" />
        <Setter Property="Height" Value="{DynamicResource SizeIconButton}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
        <Setter Property="Cursor" Value="Arrow" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource MarkOff}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="CalendarHeader" TargetType="Button" BasedOn="{StaticResource CalendarStep}">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
    </ControlTheme>

    <!-- A day name over the grid. The control builds one per column from this. -->
    <ControlTheme x:Key="CalendarDayTitle" TargetType="ContentControl">
        <Setter Property="Height" Value="20" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type CalendarItem}" TargetType="CalendarItem">
        <Setter Property="DayTitleTemplate">
            <Template>
                <ContentControl x:CompileBindings="False"
                                Theme="{StaticResource CalendarDayTitle}"
                                Content="{Binding}" />
            </Template>
        </Setter>

        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                        <Button Name="PART_PreviousButton"
                                Grid.Column="0"
                                Theme="{StaticResource CalendarStep}">
                            <ui:Icon Glyph="ChevronRight"
                                     Size="{DynamicResource IconSizeField}"
                                     RenderTransform="rotate(180deg)" />
                        </Button>

                        <Button Name="PART_HeaderButton"
                                Grid.Column="1"
                                Theme="{StaticResource CalendarHeader}"
                                HorizontalAlignment="Center" />

                        <Button Name="PART_NextButton"
                                Grid.Column="2"
                                Theme="{StaticResource CalendarStep}">
                            <ui:Icon Glyph="ChevronRight" Size="{DynamicResource IconSizeField}" />
                        </Button>
                    </Grid>

                    <!-- The control fills these by row and column, so the cells have to
                         exist before it can. Seven days across and six weeks down, plus a
                         row for the day names, and four across by three down for the
                         months and the years the header opens. -->
                    <Grid Name="PART_MonthView"
                          IsVisible="False"
                          ColumnSpacing="2" RowSpacing="2"
                          ColumnDefinitions="26,26,26,26,26,26,26"
                          RowDefinitions="Auto,26,26,26,26,26,26" />

                    <Grid Name="PART_YearView"
                          IsVisible="False"
                          ColumnSpacing="2" RowSpacing="2"
                          ColumnDefinitions="*,*,*,*"
                          RowDefinitions="*,*,*" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type Calendar}" TargetType="Calendar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="PART_Root">
                    <CalendarItem Name="PART_CalendarItem" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- The shell both popovers open in. The same surface every floating thing takes, with
         a small caps label over it and a row under it. -->
    <ControlTheme x:Key="PickerFooterButton" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource SizeIconButton}" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SurfaceNest2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{DynamicResource InkChip}" />
        <Setter Property="Cursor" Value="Arrow" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type CalendarDatePicker}" TargetType="CalendarDatePicker">
        <Setter Property="(ui:Picker.Wires)" Value="True" />
        <Setter Property="Height" Value="{DynamicResource HeightControl}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="128" />
        <Setter Property="Background" Value="{DynamicResource SurfaceWell}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Halo"
                            Margin="{DynamicResource FocusHaloReach}"
                            BorderThickness="{DynamicResource FocusHaloThickness}"
                            BorderBrush="Transparent"
                            CornerRadius="{DynamicResource RadiusControlHalo}"
                            IsHitTestVisible="False" />

                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <DockPanel LastChildFill="True">
                            <!-- The adorner sits inside the well behind nothing at all,
                                 since a mark that only opens a popover needs no seam. -->
                            <Button Name="PART_Button"
                                    DockPanel.Dock="Right"
                                    Theme="{StaticResource FieldButton}"
                                    Margin="0,0,7,0"
                                    ToolTip.Tip="Pick a date"
                                    AutomationProperties.Name="Pick a date">
                                <ui:Icon Glyph="History" Size="{DynamicResource IconSizeField}" />
                            </Button>

                            <!-- The culture's pattern, not the control's, which wraps the
                                 same pattern in angle brackets. -->
                            <TextBox Name="PART_TextBox"
                                     Theme="{StaticResource SpinnerField}"
                                     Watermark="{x:Static ui:Picker.DateHint}"
                                     VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Popup Name="PART_Popup"
                           WindowManagerAddShadowHint="False"
                           PlacementTarget="{TemplateBinding}"
                           Placement="BottomEdgeAlignedLeft"
                           HorizontalOffset="{DynamicResource OverlayRoomX}"
                           VerticalOffset="{DynamicResource OverlayRoomY}"
                           IsLightDismissEnabled="True">
                        <!-- Two borders. A clip on the border that draws the stroke cuts
                             the children to the outer rounded rectangle, so the corner
                             reads as two colours and fades at the apex. -->
                        <Border Background="{DynamicResource SurfaceNest2}"
                                BorderBrush="{DynamicResource LineControl}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusControl}"
                                BoxShadow="{DynamicResource ShadowPopup}"
                                Margin="{DynamicResource OverlayRoom}"
                                ui:Popups.KeepsWheel="True">
                          <Border CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Top"
                                        Padding="11,9"
                                        BorderBrush="{DynamicResource LineControl}"
                                        BorderThickness="0,0,0,1">
                                    <TextBlock Text="DATE"
                                               FontFamily="{DynamicResource FontFamilyUi}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontWeight="{DynamicResource FontWeightStrong}"
                                               LetterSpacing="{DynamicResource LetterSpacingLabel}"
                                               Foreground="{DynamicResource InkMuted}" />
                                </Border>

                                <Border DockPanel.Dock="Bottom"
                                        Padding="11,9"
                                        Background="{DynamicResource SurfaceRoot}"
                                        BorderBrush="{DynamicResource LineControl}"
                                        BorderThickness="0,1,0,0">
                                    <DockPanel LastChildFill="True">
                                        <Button Name="PART_Today"
                                                DockPanel.Dock="Right"
                                                Theme="{StaticResource PickerFooterButton}"
                                                Content="Today" />

                                        <!-- Emptying the field is a thing a person does,
                                             not a thing that happens to them on the way
                                             in. -->
                                        <Button Name="PART_Clear"
                                                DockPanel.Dock="Right"
                                                Theme="{StaticResource PickerFooterButton}"
                                                Margin="0,0,6,0"
                                                Content="Clear" />

                                        <TextBlock Text="{Binding $parent[CalendarDatePicker].SelectedDate, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                   FontFamily="{DynamicResource FontFamilyMono}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource InkMuted}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                    </DockPanel>
                                </Border>

                                <!-- Nothing bound to it. The control owns this part and
                                     fills it when the popup opens, and a two way binding
                                     here pushed the fresh calendar's empty selection back
                                     into the field, wiping the date on the way in. -->
                                <Calendar Name="PART_Calendar" Margin="11" />
                            </DockPanel>
                          </Border>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
        </Style>

        <Style Selector="^:focus-within, ^:flyout-open">
            <Setter Property="Background" Value="{DynamicResource SurfaceWellFocus}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
        </Style>

        <Style Selector="^:focus-within /template/ Border#PART_Halo">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>

        <Style Selector="^[(DataValidationErrors.HasErrors)=True]">
            <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>
    </ControlTheme>

    <!-- One column of the clock. The panel scrolls and snaps on its own, so this is the
         look of a row and nothing else. -->
    <ControlTheme x:Key="ClockColumn" TargetType="DateTimePickerPanel">
        <Setter Property="ItemHeight" Value="{DynamicResource SizeIconButton}" />
        <Setter Property="ShouldLoop" Value="True" />
    </ControlTheme>

    <!-- A number in one of those columns. The panel builds these itself as list items, so
         without a theme they fall through to Fluent and draw black on the dark surface. -->
    <ControlTheme x:Key="ClockCell" TargetType="ListBoxItem">
        <Setter Property="Height" Value="{DynamicResource SizeIconButton}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
            <Setter Property="Foreground" Value="{DynamicResource SelectionInk}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TimePickerPresenter}" TargetType="TimePickerPresenter">
        <Setter Property="Width" Value="242" />
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top"
                            Padding="11,9"
                            BorderBrush="{DynamicResource LineControl}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="TIME"
                                   FontFamily="{DynamicResource FontFamilyUi}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="{DynamicResource FontWeightStrong}"
                                   LetterSpacing="{DynamicResource LetterSpacingLabel}"
                                   Foreground="{DynamicResource InkMuted}" />
                    </Border>

                    <!-- The design draws a Now button alone, because its popover is a
                         picture. A working presenter only writes the time when it is
                         accepted, so the two that do that are here as well. -->
                    <Border DockPanel.Dock="Bottom"
                            Padding="11,9"
                            Background="{DynamicResource SurfaceRoot}"
                            BorderBrush="{DynamicResource LineControl}"
                            BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="False">
                            <Button Name="PART_Now"
                                    DockPanel.Dock="Left"
                                    Theme="{StaticResource PickerFooterButton}"
                                    Content="Now" />

                            <Button Name="PART_AcceptButton"
                                    DockPanel.Dock="Right"
                                    Classes="primary"
                                    Height="{DynamicResource SizeIconButton}"
                                    Content="Set" />

                            <Button Name="PART_DismissButton"
                                    DockPanel.Dock="Right"
                                    Classes="ghost"
                                    Height="{DynamicResource SizeIconButton}"
                                    Margin="0,0,6,0"
                                    Content="Cancel" />
                        </DockPanel>
                    </Border>

                    <!-- Six columns, because the control decides which of them exist.
                         Seconds and the period are its to show or hide from UseSeconds and
                         ClockIdentifier, and every one of these parts has to be here even
                         under a clock that will never draw it: the build refuses a template
                         that leaves a required part out.

                         A heading sits inside the column it names rather than in a row of
                         its own, so a column the control hides takes its label with it.
                         Otherwise SS ends up over the period. -->
                    <Grid Name="PART_PickerContainer"
                          Margin="11"
                          ColumnDefinitions="*,Auto,*,Auto,*,Auto">

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="HH" Classes="clockHead" />
                            <ScrollViewer Height="120" VerticalScrollBarVisibility="Hidden">
                                <DateTimePickerPanel Name="PART_HourSelector"
                                                     Theme="{StaticResource ClockColumn}"
                                                     PanelType="Hour"
                                                     ItemFormat="HH" />
                            </ScrollViewer>
                        </StackPanel>

                        <Rectangle Name="PART_SecondSpacer" Grid.Column="1"
                                   Width="1" Margin="0,20,0,0"
                                   Fill="{DynamicResource LineControl}" />

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MM" Classes="clockHead" />
                            <ScrollViewer Height="120" VerticalScrollBarVisibility="Hidden">
                                <DateTimePickerPanel Name="PART_MinuteSelector"
                                                     Theme="{StaticResource ClockColumn}"
                                                     PanelType="Minute"
                                                     ItemFormat="mm" />
                            </ScrollViewer>
                        </StackPanel>

                        <Rectangle Name="PART_ThirdSpacer" Grid.Column="3"
                                   Width="1" Margin="0,20,0,0"
                                   Fill="{DynamicResource LineControl}" />

                        <StackPanel Name="PART_SecondHost" Grid.Column="4">
                            <TextBlock Text="SS" Classes="clockHead" />
                            <ScrollViewer Height="120" VerticalScrollBarVisibility="Hidden">
                                <DateTimePickerPanel Name="PART_SecondSelector"
                                                     Theme="{StaticResource ClockColumn}"
                                                     PanelType="Second"
                                                     ItemFormat="ss" />
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel Name="PART_PeriodHost" Grid.Column="5">
                            <TextBlock Text="{x:Static ui:Clock.Period}" Classes="clockHead" />
                            <ScrollViewer Height="120" VerticalScrollBarVisibility="Hidden">
                                <!-- Two values and no third, so it turns over rather than
                                     scrolling. See ui:Clock.Turns. -->
                                <DateTimePickerPanel Name="PART_PeriodSelector"
                                                     Theme="{StaticResource ClockColumn}"
                                                     ShouldLoop="False"
                                                     ui:Clock.Turns="True"
                                                     PanelType="TimePeriod" />
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>

                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TimePicker}" TargetType="TimePicker">
        <Setter Property="(ui:Picker.Wires)" Value="True" />

        <!-- The control places its own popup in code and puts it at the top of the screen.
             See Popups for what was measured. -->
        <Setter Property="(ui:Popups.Under)" Value="True" />
        <Setter Property="Height" Value="{DynamicResource HeightControl}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="106" />
        <Setter Property="Background" Value="{DynamicResource SurfaceWell}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />

        <!-- The culture decides whether this is twelve hours or twenty four. Avalonia
             defaults to twelve whatever the culture says, so it is asked rather than left
             alone. The design draws twenty four because the design is one locale. -->
        <Setter Property="ClockIdentifier" Value="{x:Static ui:Clock.Identifier}" />
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Halo"
                            Margin="{DynamicResource FocusHaloReach}"
                            BorderThickness="{DynamicResource FocusHaloThickness}"
                            BorderBrush="Transparent"
                            CornerRadius="{DynamicResource RadiusControlHalo}"
                            IsHitTestVisible="False" />

                    <Button Name="PART_FlyoutButton"
                            Theme="{StaticResource PickerField}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Foreground="{TemplateBinding Foreground}">
                        <DockPanel LastChildFill="True">
                            <ui:Icon DockPanel.Dock="Right"
                                     Glyph="Timer"
                                     Size="{DynamicResource IconSizeField}"
                                     Foreground="{DynamicResource InkMuted}"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center" />

                            <Panel>
                                <!-- One string, through the culture's own short time
                                     pattern. Reading the hour and the minute out of the
                                     control's parts and joining them with a colon would
                                     drop the period on a twelve hour culture and would
                                     fix an order that is not ours to fix. -->
                                <TextBlock Classes="clockRead"
                                           VerticalAlignment="Center"
                                           Text="{Binding $parent[TimePicker].SelectedTime, Converter={x:Static ui:Clock.Reads}}" />

                                <!-- The control's own readout, which it fills in and lays
                                     out itself. It is here because the build refuses a
                                     template that leaves a required part out, and hidden
                                     because it is a segmented row of numbers between
                                     rules where the design is one string.

                                     Nothing is lost by that. The only thing the control's
                                     layout carries that a format string does not is where
                                     a locale puts the period, and this clock is pinned to
                                     24 hour so there is never one. -->
                                <Grid Name="PART_FlyoutButtonContentGrid"
                                      IsVisible="False"
                                      ColumnDefinitions="*,Auto,*,Auto,*,Auto,*">
                                    <Border Name="PART_FirstPickerHost" Grid.Column="0">
                                        <TextBlock Name="PART_HourTextBlock" />
                                    </Border>
                                    <Rectangle Name="PART_FirstColumnDivider" Grid.Column="1" Width="1" />
                                    <Border Name="PART_SecondPickerHost" Grid.Column="2">
                                        <TextBlock Name="PART_MinuteTextBlock" />
                                    </Border>
                                    <Rectangle Name="PART_SecondColumnDivider" Grid.Column="3" Width="1" />
                                    <Border Name="PART_ThirdPickerHost" Grid.Column="4">
                                        <TextBlock Name="PART_SecondTextBlock" />
                                    </Border>
                                    <Rectangle Name="PART_ThirdColumnDivider" Grid.Column="5" Width="1" />
                                    <Border Name="PART_FourthPickerHost" Grid.Column="6">
                                        <TextBlock Name="PART_PeriodTextBlock" />
                                    </Border>
                                </Grid>
                            </Panel>
                        </DockPanel>
                    </Button>

                    <!-- Placement is set by ui:Popups.Under above rather than here. The
                         control overwrites whatever this element says. -->
                    <Popup Name="PART_Popup"
                           WindowManagerAddShadowHint="False"
                           HorizontalOffset="{DynamicResource OverlayRoomX}"
                           VerticalOffset="{DynamicResource OverlayRoomY}"
                           IsLightDismissEnabled="True">
                        <Border Background="{DynamicResource SurfaceNest2}"
                                BorderBrush="{DynamicResource LineControl}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusControl}"
                                BoxShadow="{DynamicResource ShadowPopup}"
                                Margin="{DynamicResource OverlayRoom}"
                                ui:Popups.KeepsWheel="True">
                          <Border CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True">
                            <TimePickerPresenter Name="PART_PickerPresenter" />
                          </Border>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
        </Style>

        <Style Selector="^:focus-within">
            <Setter Property="Background" Value="{DynamicResource SurfaceWellFocus}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
        </Style>

        <Style Selector="^:focus-within /template/ Border#PART_Halo">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>
    </ControlTheme>

    <!-- The time field is a button rather than a well with a caret in it, since a time is
         picked and never typed here. It still looks like every other well. -->
    <ControlTheme x:Key="PickerField" TargetType="Button">
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Arrow" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    </Styles.Resources>

    <!-- The clock's numbers. The panel adds its own containers, so nothing inside it can be
         reached from a control theme: a control theme may hold no descendant selector at
         all, and these are not template children of anything this library wrote. -->
    <Style Selector="DateTimePickerPanel > ListBoxItem">
        <Setter Property="Theme" Value="{StaticResource ClockCell}" />
    </Style>

</Styles>

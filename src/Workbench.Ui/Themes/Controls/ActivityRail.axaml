<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Workbench.Ui.Controls">

    <!-- The rail down the left of a Workbench window, switching which page is shown. -->
    <ControlTheme x:Key="ActivityRail" TargetType="ListBox">
        <Setter Property="Width" Value="{DynamicResource WidthActivityRail}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRoot}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="0,8" />

        <!-- An ItemsPanel setter does not take here. -->

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ItemsPresenter Name="PART_ItemsPresenter" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="ActivityRailItem" TargetType="ListBoxItem">
        <Setter Property="Width" Value="{DynamicResource SizeRailItem}" />
        <Setter Property="Height" Value="{DynamicResource SizeRailItem}" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Foreground" Value="{DynamicResource InkRail}" />
        <Setter Property="DockPanel.Dock" Value="Top" />

        <!-- See Button.axaml. ContentControl clips by default and would cut the halo. -->
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Focus"
                            Margin="{DynamicResource FocusHaloReach}"
                            BorderThickness="{DynamicResource FocusHaloThickness}"
                            BorderBrush="Transparent"
                            CornerRadius="{DynamicResource RadiusControlHalo}"
                            IsHitTestVisible="False" />

                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- Order is the whole of precedence here. Every selector below carries a pseudo class, so
             they all bind at the same strength and the later one wins. -->

        <Style Selector="^:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
        </Style>

        <!-- Selection is the tint alone, the way it is everywhere else in this system.
             No marker down the edge, and the icon carries the accent instead. -->
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="^:selected /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
        </Style>

        <!-- The open page answers the pointer too. Without these the selected item would be
             the one item in the rail that looks dead under the cursor, because the plain
             hover above loses to the selected fill whatever order they are written in. -->
        <Style Selector="^:selected:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource AccentTintStrong}" />
        </Style>

        <Style Selector="^:selected:pressed /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource AccentTintStrong}" />
        </Style>

        <Style Selector="^:selected:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
        </Style>

        <Style Selector="^:focus-visible /template/ Border#PART_Focus">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>

        <!-- Last, so nothing above can put colour back into a page nobody can open. -->
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#PART_Root">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="^:disabled:selected /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
        </Style>

    </ControlTheme>

</ResourceDictionary>

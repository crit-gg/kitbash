<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The one thing a consumer includes:

             <StyleInclude Source="avares://Workbench.Ui/Themes/WorkbenchTheme.axaml" />

         Workbench and every tool take this and nothing else, so a token added here
         reaches all of them without any of them being edited.

         Slate is one theme. There is no light variant and no ThemeVariant plumbing
         until something asks for it. -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Workbench.Ui/Themes/Tokens.axaml" />
                <ResourceInclude Source="avares://Workbench.Ui/Themes/Typography.axaml" />
                <ResourceInclude Source="avares://Workbench.Ui/Themes/Icons.axaml" />
                <ResourceInclude Source="avares://Workbench.Ui/Themes/Controls/Icon.axaml" />
                <ResourceInclude Source="avares://Workbench.Ui/Themes/Controls/DialogFooter.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Control themes go in the resources above. A control whose look is a set of
         styles rather than one theme, such as the window frame, is included here. -->
    <StyleInclude Source="avares://Workbench.Ui/Themes/Controls/WindowChrome.axaml" />

</Styles>

<ui:ChromelessWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kitbash.Ui.Controls;assembly=Kitbash.Ui"
        x:Class="Kitbash.Gallery.Views.GalleryWindow"
        Title="Kitbash Gallery"
        Icon="avares://Kitbash.Gallery/Assets/Icons/icon_256x256.png"
        Width="1024" Height="784"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FontFamilyUi}"
        FontSize="{StaticResource FontSizeBody}">

    <Window.Styles>
        <!-- The gallery's own furniture, and every page below is inside this window, so
             these reach all of them. Nothing here is a control look. Every one of those
             comes from Kitbash.Ui, so anything wrong on a page is wrong in the library. -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            <Setter Property="LetterSpacing" Value="{DynamicResource LetterSpacingLabel}" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>

        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Stands in for a window's foot, so the readouts sit on the ground they really
             sit on. -->
        <Style Selector="Border.statusBarRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceRoot}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
            <Setter Property="Height" Value="{DynamicResource HeightTitleBar}" />
            <Setter Property="Padding" Value="16,0,12,0" />
        </Style>

        <!-- A page's own panels ride the depth ramp rather than naming a tone, so every
             section on a page is also a check that the ramp works. -->
        <Style Selector="Border.panel">
            <Setter Property="(ui:Surface.Nests)" Value="True" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- The strip over the page, naming the one the rail is on. The rail says it in a
             tooltip, which is gone as soon as the pointer moves. -->
        <Style Selector="Border.pageHead">
            <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Height" Value="{DynamicResource HeightTitleBar}" />
            <Setter Property="Padding" Value="20,0" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- The title bar carries content, which is the case that keeps the row alive
             under the desktop's own frame. Turn window.nativeChrome on and this row
             stays while the launcher's disappears.
             Version is the quiet readout after the name, set from the build. The dialog
             the windows page opens sets none, so both states are here. -->
        <ui:WindowTitleBar Grid.Row="0" Name="TitleBar" Title="Kitbash Gallery"
                           Icon="avares://Kitbash.Gallery/Assets/Icons/icon_64x64.png">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0">
                <!-- The whole library at the other density, live. It is one style include,
                     so turning it on here is exactly what an app does at startup. -->
                <ToggleButton Classes="ghost" Content="Comfortable" Click="OnToggleDensity" />

                <Button Classes="ghost" Name="ToggleEnabledButton"
                        Content="Disable everything"
                        Click="OnToggleEnabled" />
            </StackPanel>
        </ui:WindowTitleBar>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

            <!-- The rail, filled in code, since a page carries a glyph, a name and the way
                 to build it and a container theme cannot be handed one per item. Selection
                 and keyboard navigation are the ListBox's. -->
            <ListBox Grid.Column="0" Name="Rail"
                     Theme="{StaticResource ActivityRail}"
                     Padding="0,8,0,0"
                     VerticalAlignment="Stretch"
                     SelectionChanged="OnPageSelected" />

            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="pageHead">
                    <TextBlock Name="PageName" Classes="section" VerticalAlignment="Center" />
                </Border>

                <!-- One page at a time. Each is built the first time it is opened and kept
                     after, so a page comes back where it was left. -->
                <ContentControl Grid.Row="1" Name="Body" />
            </Grid>
        </Grid>

        <!-- The window's eight regions, over the page and under nothing. Row 1 rather than
             both rows, so the title bar and its caption buttons stay reachable. It draws
             last, which is what puts a card over the page rather than under it. -->
        <ui:ToastHost Grid.Row="1" Name="WindowToasts" />
    </Grid>
</ui:ChromelessWindow>

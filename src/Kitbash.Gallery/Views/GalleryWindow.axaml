<ui:ChromelessWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kitbash.Ui.Controls;assembly=Kitbash.Ui"
        xmlns:views="clr-namespace:Kitbash.Gallery.Views"
        x:Class="Kitbash.Gallery.Views.GalleryWindow"
        Title="Kitbash Gallery"
        Width="1024" Height="784"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FontFamilyUi}"
        FontSize="{StaticResource FontSizeBody}">

    <Window.DataTemplates>
        <!-- What a docked thing draws. A dockable is a view model and the shell finds its
             view by type, so the harness says here what a tool and a document look like. -->
        <DataTemplate DataType="views:HarnessTool">
            <TextBlock Classes="caption" Margin="11,9" Text="{Binding Body}" />
        </DataTemplate>
        <DataTemplate DataType="views:HarnessDocument">
            <TextBlock Classes="caption" Margin="11,9" Text="{Binding Body}" />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <!-- The gallery's own furniture. Nothing here is a control look. Every one of
             those comes from Kitbash.Ui, so anything wrong on this page is wrong in
             the library. -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            <Setter Property="LetterSpacing" Value="{DynamicResource LetterSpacingLabel}" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        </Style>

        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Stands in for a window's foot, so the readouts sit on the ground they really
             sit on. -->
        <Style Selector="Border.statusBarRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceRoot}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
            <Setter Property="Height" Value="{DynamicResource HeightTitleBar}" />
            <Setter Property="Padding" Value="16,0,12,0" />
        </Style>

        <!-- The page's own panels ride the depth ramp rather than naming a tone, so every section
             on this page is also a check that the ramp works. -->
        <Style Selector="Border.panel">
            <Setter Property="(ui:Surface.Nests)" Value="True" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- The title bar carries content, which is the case that keeps the row alive
             under the desktop's own frame. Turn window.nativeChrome on and this row
             stays while the launcher's disappears.
             Version is the quiet readout after the name, set from the build. The dialog
             below sets none, so both states are here. -->
        <ui:WindowTitleBar Grid.Row="0" Name="TitleBar" Title="Kitbash Gallery">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0">
                <!-- The whole library at the other density, live. It is one style include,
                     so turning it on here is exactly what an app does at startup. -->
                <ToggleButton Classes="ghost" Content="Comfortable" Click="OnToggleDensity" />

                <Button Classes="ghost" Name="ToggleEnabledButton"
                        Content="Disable everything"
                        Click="OnToggleEnabled" />
            </StackPanel>
        </ui:WindowTitleBar>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="Body" Spacing="16" Margin="20">

                <!-- section -->
                <TextBlock Classes="section" Text="BUTTONS" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="Every kind in every state. The first column is live, so hover it, hold it and tab to it. The rest are held in one state so the five can be compared at once, and they ignore the pointer for that reason." />

                        <Grid ColumnDefinitions="90,Auto,Auto,Auto,Auto,Auto"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="10" RowSpacing="9">

                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="caption" Text="live" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Classes="caption" Text="hover" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Classes="caption" Text="pressed" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Classes="caption" Text="focus" />
                            <TextBlock Grid.Row="0" Grid.Column="5" Classes="caption" Text="disabled" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="secondary" VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="1" Content="Reload" />
                            <Button Grid.Row="1" Grid.Column="2" Classes="forceHover" Content="Reload" />
                            <Button Grid.Row="1" Grid.Column="3" Classes="forcePressed" Content="Reload" />
                            <Button Grid.Row="1" Grid.Column="4" Classes="forceFocus" Content="Reload" />
                            <Button Grid.Row="1" Grid.Column="5" Content="Reload" IsEnabled="False" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="caption" Text="primary" VerticalAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="1" Classes="primary" Content="Add workspace" />
                            <Button Grid.Row="2" Grid.Column="2" Classes="primary forceHover" Content="Add workspace" />
                            <Button Grid.Row="2" Grid.Column="3" Classes="primary forcePressed" Content="Add workspace" />
                            <Button Grid.Row="2" Grid.Column="4" Classes="primary forceFocus" Content="Add workspace" />
                            <Button Grid.Row="2" Grid.Column="5" Classes="primary" Content="Add workspace" IsEnabled="False" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="caption" Text="neutral" VerticalAlignment="Center" />
                            <Button Grid.Row="3" Grid.Column="1" Classes="neutral" Content="Launch" />
                            <Button Grid.Row="3" Grid.Column="2" Classes="neutral forceHover" Content="Launch" />
                            <Button Grid.Row="3" Grid.Column="3" Classes="neutral forcePressed" Content="Launch" />
                            <Button Grid.Row="3" Grid.Column="4" Classes="neutral forceFocus" Content="Launch" />
                            <Button Grid.Row="3" Grid.Column="5" Classes="neutral" Content="Launch" IsEnabled="False" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Classes="caption" Text="ghost" VerticalAlignment="Center" />
                            <Button Grid.Row="4" Grid.Column="1" Classes="ghost" Content="Cancel" />
                            <Button Grid.Row="4" Grid.Column="2" Classes="ghost forceHover" Content="Cancel" />
                            <Button Grid.Row="4" Grid.Column="3" Classes="ghost forcePressed" Content="Cancel" />
                            <Button Grid.Row="4" Grid.Column="4" Classes="ghost forceFocus" Content="Cancel" />
                            <Button Grid.Row="4" Grid.Column="5" Classes="ghost" Content="Cancel" IsEnabled="False" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Classes="caption" Text="danger" VerticalAlignment="Center" />
                            <Button Grid.Row="5" Grid.Column="1" Classes="danger" Content="Remove" />
                            <Button Grid.Row="5" Grid.Column="2" Classes="danger forceHover" Content="Remove" />
                            <Button Grid.Row="5" Grid.Column="3" Classes="danger forcePressed" Content="Remove" />
                            <Button Grid.Row="5" Grid.Column="4" Classes="danger forceFocus" Content="Remove" />
                            <Button Grid.Row="5" Grid.Column="5" Classes="danger" Content="Remove" IsEnabled="False" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Classes="caption" Text="icon" VerticalAlignment="Center" />
                            <Button Grid.Row="6" Grid.Column="1" Classes="icon"
                                    ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
                                <ui:Icon Glyph="Cog" />
                            </Button>
                            <Button Grid.Row="6" Grid.Column="2" Classes="icon forceHover"
                                    ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
                                <ui:Icon Glyph="Cog" />
                            </Button>
                            <Button Grid.Row="6" Grid.Column="3" Classes="icon forcePressed"
                                    ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
                                <ui:Icon Glyph="Cog" />
                            </Button>
                            <Button Grid.Row="6" Grid.Column="4" Classes="icon forceFocus"
                                    ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
                                <ui:Icon Glyph="Cog" />
                            </Button>
                            <Button Grid.Row="6" Grid.Column="5" Classes="icon" IsEnabled="False"
                                    ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
                                <ui:Icon Glyph="Cog" />
                            </Button>

                            <!-- A button that stays down. Its live sample is really checked,
                                 so the row reads on then off rather than four of one. -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Classes="caption" Text="toggle" VerticalAlignment="Center" />
                            <ToggleButton Grid.Row="7" Grid.Column="1" Content="Create folder" IsChecked="True" />
                            <ToggleButton Grid.Row="7" Grid.Column="2" Classes="forceHover" Content="Create folder" />
                            <ToggleButton Grid.Row="7" Grid.Column="3" Classes="forcePressed" Content="Create folder" />
                            <ToggleButton Grid.Row="7" Grid.Column="4" Classes="forceFocus" Content="Create folder" />
                            <ToggleButton Grid.Row="7" Grid.Column="5" Content="Create folder" IsEnabled="False" />

                            <!-- Quiet until it is touched. The held columns are what this
                                 kind is for, since the whole point is that it is red in
                                 exactly two of the five states and grey in the rest. -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Classes="caption" Text="icon danger" VerticalAlignment="Center" />
                            <Button Grid.Row="8" Grid.Column="1" Classes="icon danger"
                                    ToolTip.Tip="Delete" AutomationProperties.Name="Delete">
                                <ui:Icon Glyph="Trash" />
                            </Button>
                            <Button Grid.Row="8" Grid.Column="2" Classes="icon danger forceHover"
                                    ToolTip.Tip="Delete" AutomationProperties.Name="Delete">
                                <ui:Icon Glyph="Trash" />
                            </Button>
                            <Button Grid.Row="8" Grid.Column="3" Classes="icon danger forcePressed"
                                    ToolTip.Tip="Delete" AutomationProperties.Name="Delete">
                                <ui:Icon Glyph="Trash" />
                            </Button>
                            <Button Grid.Row="8" Grid.Column="4" Classes="icon danger forceFocus"
                                    ToolTip.Tip="Delete" AutomationProperties.Name="Delete">
                                <ui:Icon Glyph="Trash" />
                            </Button>
                            <Button Grid.Row="8" Grid.Column="5" Classes="icon danger" IsEnabled="False"
                                    ToolTip.Tip="Delete" AutomationProperties.Name="Delete">
                                <ui:Icon Glyph="Trash" />
                            </Button>

                            <!-- The two toggle kinds. Both live samples are checked, so the
                                 row shows that a kind with no fill still takes one when it
                                 is on, which is the only thing saying it is on. -->
                            <TextBlock Grid.Row="9" Grid.Column="0" Classes="caption" Text="toggle ghost" VerticalAlignment="Center" />
                            <ToggleButton Grid.Row="9" Grid.Column="1" Classes="ghost" Content="Wireframe" IsChecked="True" />
                            <ToggleButton Grid.Row="9" Grid.Column="2" Classes="ghost forceHover" Content="Wireframe" />
                            <ToggleButton Grid.Row="9" Grid.Column="3" Classes="ghost forcePressed" Content="Wireframe" />
                            <ToggleButton Grid.Row="9" Grid.Column="4" Classes="ghost forceFocus" Content="Wireframe" />
                            <ToggleButton Grid.Row="9" Grid.Column="5" Classes="ghost" Content="Wireframe" IsEnabled="False" />

                            <TextBlock Grid.Row="10" Grid.Column="0" Classes="caption" Text="toggle icon" VerticalAlignment="Center" />
                            <ToggleButton Grid.Row="10" Grid.Column="1" Classes="icon" IsChecked="True"
                                          ToolTip.Tip="Sidebar" AutomationProperties.Name="Sidebar">
                                <ui:Icon Glyph="Columns" />
                            </ToggleButton>
                            <ToggleButton Grid.Row="10" Grid.Column="2" Classes="icon forceHover"
                                          ToolTip.Tip="Sidebar" AutomationProperties.Name="Sidebar">
                                <ui:Icon Glyph="Columns" />
                            </ToggleButton>
                            <ToggleButton Grid.Row="10" Grid.Column="3" Classes="icon forcePressed"
                                          ToolTip.Tip="Sidebar" AutomationProperties.Name="Sidebar">
                                <ui:Icon Glyph="Columns" />
                            </ToggleButton>
                            <ToggleButton Grid.Row="10" Grid.Column="4" Classes="icon forceFocus"
                                          ToolTip.Tip="Sidebar" AutomationProperties.Name="Sidebar">
                                <ui:Icon Glyph="Columns" />
                            </ToggleButton>
                            <ToggleButton Grid.Row="10" Grid.Column="5" Classes="icon" IsEnabled="False"
                                          ToolTip.Tip="Sidebar" AutomationProperties.Name="Sidebar">
                                <ui:Icon Glyph="Columns" />
                            </ToggleButton>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="SPLIT BUTTON AND DROPDOWN" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="Both open a real menu. Hover the caret and then the label to see each half take its own state without moving the other. The menu itself is not themed until stage 5." />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SplitButton Content="Run">
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Run and attach" />
                                        <MenuItem Header="Run without building" />
                                        <Separator />
                                        <MenuItem Header="Edit configuration" />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>

                            <SplitButton Classes="primary" Content="Open in Godot">
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Open project folder" />
                                        <MenuItem Header="Edit project.godot" />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>

                            <SplitButton Classes="neutral" Content="Launch">
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Launch and attach" />
                                        <MenuItem Header="Launch clean" />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>

                            <SplitButton Classes="warn" Content="Switch to 4.7.1" />

                            <SplitButton Classes="danger" Content="Install 4.7.1" />

                            <SplitButton Content="Run" IsEnabled="False" />

                            <DropDownButton Content="Godot 4.7.1" Width="170">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Godot 4.7.1" />
                                        <MenuItem Header="Godot 4.6.2" />
                                        <MenuItem Header="Godot 4.5.0" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <DropDownButton Content="Godot 4.7.1" Width="170" IsEnabled="False" />
                        </StackPanel>

                        <TextBlock Classes="note"
                                   Text="A dropdown that names a status carries the colour in front of the word, since the word alone is what the row is read for. The compact one is for an inspector row, where the label owns the left of the row and the value has what is left, and it takes the mono family when it holds a value rather than a name." />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <DropDownButton Width="170">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Classes="dot" Fill="{DynamicResource Ok}" />
                                    <TextBlock Text="Approved" />
                                </StackPanel>
                            </DropDownButton>

                            <DropDownButton Width="170">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Classes="dot" Fill="{DynamicResource Warn}" />
                                    <TextBlock Text="In review" />
                                </StackPanel>
                            </DropDownButton>

                            <DropDownButton Classes="compact" Content="Ilse" Width="110" />

                            <DropDownButton Classes="compact mono" Content="2048" Width="90" />

                            <DropDownButton Classes="compact mono" Content="PNG" Width="90" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="CHIPS" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="A chip says what is true. Removing it is the only thing that can be done to one, so the removable chips below really do go." />

                        <StackPanel Name="Chips" Orientation="Horizontal" Spacing="8">
                            <ui:Chip Content="machine" Mark="{DynamicResource Data}" IsRemovable="True" />
                            <ui:Chip Content="recipe" Mark="{DynamicResource Graph}" IsRemovable="True" />
                            <ui:Chip Content="attribute" Mark="{DynamicResource Warn}" IsRemovable="True" />
                            <ui:Chip Content="no mark" />
                            <ui:Chip Content="disabled" Mark="{DynamicResource Ok}" IsRemovable="True" IsEnabled="False" />
                        </StackPanel>

                        <TextBlock Classes="note"
                                   Text="The round mark says the chip names a label somebody applied, and the square one says it names a thing. That is the same split the badge draws with its dot. The accent chip is a filter that is in force rather than a fact about a thing, so it carries the colour that means selected everywhere else and no mark at all." />

                        <StackPanel Name="ChipKinds" Orientation="Horizontal" Spacing="8">
                            <ui:Chip Classes="dot" Content="environment" Mark="{DynamicResource Ok}" IsRemovable="True" />
                            <ui:Chip Classes="dot" Content="character" Mark="{DynamicResource Warn}" IsRemovable="True" />
                            <ui:Chip Classes="dot" Content="wip" Mark="{DynamicResource Accent}" />
                            <ui:Chip Classes="accent" Content="owner is Mara" IsRemovable="True" />
                            <ui:Chip Classes="accent" Content="type is texture" IsRemovable="True" />

                            <!-- A count inside a chip, for one that is true of some of a
                                 selection rather than all of it. -->
                            <ui:Chip Classes="dot" Mark="{DynamicResource Graph}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="lowpoly" />
                                    <TextBlock Classes="chipCount" Text="3" />
                                </StackPanel>
                            </ui:Chip>

                            <Button Theme="{StaticResource ChipAddButton}" Content="Add" />
                        </StackPanel>

                        <Button Classes="ghost" Content="Put them back" Click="OnRestoreChips"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="BADGES" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="A badge names something. It carries a word, an optional dot and no icon, which is what separates it from a status pill. If the colour is saying something the word does not, it is a status and belongs in a pill." />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:Badge Tier="Data" HasDot="True" Content=".NET" />
                            <ui:Badge Tier="Ok" Content="OPEN" />
                            <ui:Badge Tier="Modified" Content="READ ONLY" />
                            <ui:Badge Tier="Error" Content="MISSING" />
                            <ui:Badge Tier="Accent" HasDot="True" Content="PREVIEW" />
                            <ui:Badge Tier="Neutral" Content="LOCAL" />
                            <ui:Badge Tier="Ok" HasDot="True" Content="disabled" IsEnabled="False" />
                        </StackPanel>

                        <TextBlock Classes="note"
                                   Text="Laid over a picture. Every tier is a tint picked to read on a surface the theme knows, and a thumbnail is any colour at all, so the fill becomes a scrim and the tier says its piece through the dot alone. The two swatches below are standing in for a thumbnail." />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="128" Height="72" CornerRadius="{DynamicResource RadiusSurface}"
                                    Background="{DynamicResource Warn}">
                                <ui:Badge Classes="onMedia" Tier="Modified" HasDot="True" Content="IN REVIEW"
                                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" />
                            </Border>
                            <Border Width="128" Height="72" CornerRadius="{DynamicResource RadiusSurface}"
                                    Background="{DynamicResource SurfaceWell}">
                                <ui:Badge Classes="onMedia" Tier="Ok" HasDot="True" Content="APPROVED"
                                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="STATUS PILLS" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="Colour plus icon plus label, always. The tier chooses the colours and a default glyph, and naming a glyph overrides it. The last one shows that." />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:StatusPill Status="Ok" Text="synced" />
                            <ui:StatusPill Status="Modified" Text="modified" />
                            <ui:StatusPill Status="Error" Text="conflict" />
                            <ui:StatusPill Status="Accent" Text="checked out" />
                            <ui:StatusPill Status="Neutral" Text="archived" />
                            <ui:StatusPill Status="Ok" Text="main" Glyph="GitBranch" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="PROGRESS" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="One bar, two modes. The travelling fill is 30 percent of the track and sweeps edge to edge." />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressBar Name="Determinate" Width="260" Value="40" VerticalAlignment="Center" />
                            <TextBlock Name="DeterminateValue" Classes="caption" VerticalAlignment="Center" />
                            <Button Classes="icon" Click="OnLess"
                                    ToolTip.Tip="Less" AutomationProperties.Name="Less">
                                <ui:Icon Glyph="Minimize" />
                            </Button>
                            <Button Classes="icon" Click="OnMore"
                                    ToolTip.Tip="More" AutomationProperties.Name="More">
                                <ui:Icon Glyph="Plus" />
                            </Button>
                        </StackPanel>

                        <ProgressBar Width="260" IsIndeterminate="True" HorizontalAlignment="Left" />

                        <TextBlock Classes="note"
                                   Text="When the length is not known and there is no room for a bar, an icon turns instead. One turn every 1.1 seconds. Put it on the icon that names the work, so the row keeps its width." />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ui:Icon Glyph="RefreshCw" Classes="spin" Size="16"
                                     Foreground="{DynamicResource InkSecondary}" />
                            <ui:Icon Glyph="RefreshCw" Classes="spin" Size="20"
                                     Foreground="{DynamicResource Accent}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="ACTIVITY RAIL" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="The rail down the left of a window. A ListBox, so selection and keyboard navigation are Avalonia's. The first rail is live, so click it, hover it and tab into it. The rest are held so every state can be read at once, including the ones a pointer cannot reach: an open page under the cursor, and an item that is open but disabled." />

                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="caption" Text="live" HorizontalAlignment="Center" />
                                <ListBox Theme="{StaticResource ActivityRail}" SelectedIndex="0" Height="140">
                                    <ListBoxItem Theme="{StaticResource ActivityRailItem}"
                                                 ToolTip.Tip="Workspace" ToolTip.Placement="Right"
                                                 AutomationProperties.Name="Workspace">
                                        <ui:Icon Glyph="Window" Size="{DynamicResource IconSizeLarge}" />
                                    </ListBoxItem>
                                    <ListBoxItem Theme="{StaticResource ActivityRailItem}"
                                                 ToolTip.Tip="Godot engines" ToolTip.Placement="Right"
                                                 AutomationProperties.Name="Godot engines">
                                        <ui:Icon Glyph="Godot" Size="{DynamicResource IconSizeLarge}" />
                                    </ListBoxItem>
                                    <ListBoxItem Theme="{StaticResource ActivityRailItem}"
                                                 ToolTip.Tip="Settings" ToolTip.Placement="Right"
                                                 AutomationProperties.Name="Settings">
                                        <ui:Icon Glyph="Cog" Size="{DynamicResource IconSizeLarge}" />
                                    </ListBoxItem>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="caption" Text="unselected" HorizontalAlignment="Center" />
                                <ListBox Theme="{StaticResource ActivityRail}" SelectedIndex="-1" Height="140">
                                    <ListBoxItem Theme="{StaticResource ActivityRailItem}" Classes="forceHover">
                                        <ui:Icon Glyph="Window" Size="{DynamicResource IconSizeLarge}" />
                                    </ListBoxItem>
                                    <ListBoxItem Theme="{StaticResource ActivityRailItem}" Classes="forcePressed">
                                        <ui:Icon Glyph="Godot" Size="{DynamicResource IconSizeLarge}" />
                                    </ListBoxItem>
                                    <ListBoxItem Theme="{StaticResource ActivityRailItem}" Classes="forceFocus">
                                        <ui:Icon Glyph="Cog" Size="{DynamicResource IconSizeLarge}" />
                                    </ListBoxItem>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="caption" Text="selected" HorizontalAlignment="Center" />
                                <ListBox Theme="{StaticResource ActivityRail}" SelectionMode="Multiple" Height="140">
                                    <ListBoxItem Theme="{StaticResource ActivityRailItem}" IsSelected="True">
                                        <ui:Icon Glyph="Window" Size="{DynamicResource IconSizeLarge}" />
                                    </ListBoxItem>
                                    <ListBoxItem Theme="{StaticResource ActivityRailItem}" IsSelected="True" Classes="forceHover">
                                        <ui:Icon Glyph="Godot" Size="{DynamicResource IconSizeLarge}" />
                                    </ListBoxItem>
                                    <ListBoxItem Theme="{StaticResource ActivityRailItem}" IsSelected="True" Classes="forceFocus">
                                        <ui:Icon Glyph="Cog" Size="{DynamicResource IconSizeLarge}" />
                                    </ListBoxItem>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="caption" Text="disabled" HorizontalAlignment="Center" />
                                <ListBox Theme="{StaticResource ActivityRail}" SelectionMode="Multiple" Height="140">
                                    <ListBoxItem Theme="{StaticResource ActivityRailItem}" IsEnabled="False">
                                        <ui:Icon Glyph="Window" Size="{DynamicResource IconSizeLarge}" />
                                    </ListBoxItem>
                                    <ListBoxItem Theme="{StaticResource ActivityRailItem}" IsEnabled="False" Classes="forceHover">
                                        <ui:Icon Glyph="Godot" Size="{DynamicResource IconSizeLarge}" />
                                    </ListBoxItem>
                                    <ListBoxItem Theme="{StaticResource ActivityRailItem}" IsEnabled="False" IsSelected="True">
                                        <ui:Icon Glyph="Cog" Size="{DynamicResource IconSizeLarge}" />
                                    </ListBoxItem>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="STATUS BAR" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="A readout that does something, sized for the 32px row rather than for a form. Quiet at rest so the row reads as one strip. Its own theme rather than a class on the button, because the row has no space for a button's height." />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Theme="{StaticResource StatusBarButton}" ToolTip.Tip="Fetch, and pull when nothing has changed here">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <ui:Icon Glyph="RefreshCw" Size="{DynamicResource IconSizeStatus}"
                                             Foreground="{DynamicResource InkSecondary}" />
                                    <TextBlock Text="Update" VerticalAlignment="Center"
                                               Foreground="{DynamicResource InkPrimary}" />
                                </StackPanel>
                            </Button>

                            <Button Theme="{StaticResource StatusBarButton}" ToolTip.Tip="An update that is running">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <ui:Icon Glyph="RefreshCw" Classes="spin" Size="{DynamicResource IconSizeStatus}"
                                             Foreground="{DynamicResource InkSecondary}" />
                                    <TextBlock Text="Update" VerticalAlignment="Center"
                                               Foreground="{DynamicResource InkPrimary}" />
                                </StackPanel>
                            </Button>

                            <Button Theme="{StaticResource StatusBarButton}" Content="Held hover" Classes="forceHover" />
                            <Button Theme="{StaticResource StatusBarButton}" Content="Held pressed" Classes="forcePressed" />
                            <Button Theme="{StaticResource StatusBarButton}" Content="Held focus" Classes="forceFocus" />
                            <Button Theme="{StaticResource StatusBarButton}" Content="Disabled" IsEnabled="False" />
                        </StackPanel>

                        <TextBlock Classes="note"
                                   Text="The readouts beside it. Each one carries a glyph as well as a colour, so none of them says its meaning in hue alone, and a count that is zero is not drawn at all. A conflict leaves the row and takes a chip, because it blocks work where the others only report it." />

                        <Border Classes="statusBarRow">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <ui:Icon Glyph="GitBranch" Size="{DynamicResource IconSizeStatus}"
                                             Foreground="{DynamicResource InkSecondary}" />
                                    <TextBlock Classes="branch" Text="feature/heat-rebalance" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14"
                                            VerticalAlignment="Center">
                                    <StackPanel Classes="countReadout">
                                        <ui:Icon Classes="countMark" Glyph="Save"
                                                 Foreground="{DynamicResource Warn}" />
                                        <TextBlock Classes="count" Text="12" />
                                        <TextBlock Classes="countLabel" Text="modified" />
                                    </StackPanel>

                                    <StackPanel Classes="countReadout">
                                        <ui:Icon Classes="countMark" Glyph="Check"
                                                 Foreground="{DynamicResource Ok}" />
                                        <TextBlock Classes="count" Text="3" />
                                        <TextBlock Classes="countLabel" Text="staged" />
                                    </StackPanel>

                                    <Border Classes="conflictChip">
                                        <StackPanel Classes="countReadout">
                                            <ui:Icon Classes="countMark" Glyph="AlertTriangle"
                                                     Foreground="{DynamicResource Error}" />
                                            <TextBlock Classes="count" Text="1" />
                                            <TextBlock Classes="countLabel" Text="conflict" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="14"
                                            VerticalAlignment="Center">
                                    <StackPanel Classes="countReadout">
                                        <ui:Icon Classes="countMark" Glyph="ChevronUp"
                                                 Foreground="{DynamicResource InkSecondary}" />
                                        <TextBlock Classes="count" Text="2" />
                                        <TextBlock Classes="countLabel" Text="ahead" />
                                    </StackPanel>

                                    <StackPanel Classes="countReadout">
                                        <ui:Icon Classes="countMark" Glyph="ChevronDown"
                                                 Foreground="{DynamicResource InkSecondary}" />
                                        <TextBlock Classes="count" Text="3" />
                                        <TextBlock Classes="countLabel" Text="behind" />
                                    </StackPanel>

                                    <TextBlock Classes="updateAge" Text="Updated 4m ago" />

                                    <Button Theme="{StaticResource StatusBarButton}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <ui:Icon Glyph="RefreshCw" Size="{DynamicResource IconSizeStatus}"
                                                     Foreground="{DynamicResource InkSecondary}" />
                                            <TextBlock Text="Update" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource InkPrimary}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="OVERLAYS" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="Everything that floats shares one surface. Open a menu, a dropdown and a tooltip next to each other and the ground, the edge and the radius are the same. Right click the panel for a context menu." />

                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in new tab" InputGesture="Ctrl+Enter" />
                                <MenuItem Header="Duplicate" InputGesture="Ctrl+D" />
                                <MenuItem Header="Assign graph">
                                    <MenuItem Header="Pure graph" />
                                    <MenuItem Header="Exec graph" />
                                </MenuItem>
                                <MenuItem Header="Check in" InputGesture="Ctrl+K" />
                                <Separator />
                                <MenuItem Header="Delete recipe" InputGesture="Delete" Classes="danger" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Menu" ToolTip.Tip="A tooltip on the same surface">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Open in new tab" InputGesture="Ctrl+Enter" />
                                        <MenuItem Header="Duplicate" InputGesture="Ctrl+D" />
                                        <Separator />
                                        <MenuItem Header="Delete recipe" InputGesture="Delete" Classes="danger" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <Button Content="Popover">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="popover">
                                        <ui:Popover Width="320" Header="WORKSPACES">
                                            <StackPanel>
                                                <TextBlock Text="The launcher supplies the rows. This is the surface only."
                                                           Classes="note" Margin="13,10" />
                                            </StackPanel>
                                            <ui:Popover.Footer>
                                                <StackPanel>
                                                    <MenuItem Header="Add workspace from folder" />
                                                    <MenuItem Header="Clone workspace from git" />
                                                </StackPanel>
                                            </ui:Popover.Footer>
                                        </ui:Popover>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button Classes="ghost" Content="Hover me for a tooltip"
                                    ToolTip.Tip="Run all validators" />
                        </StackPanel>

                        <TextBlock Classes="note"
                                   Text="The same popover dropped into a panel loses its shadow and its surface and keeps its body. That is what lets a picker open in a popover and also sit inside a property panel." />

                        <ui:Popover Classes="inPanel" Header="IN A PANEL" HorizontalAlignment="Left" Width="320">
                            <TextBlock Text="Same body, no shadow, no surface of its own."
                                       Classes="note" Margin="13,10" />
                        </ui:Popover>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="INPUTS" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="Everything that takes a value sits in a well, which is darker than anything around it and stays that tone at any depth. A well answers the pointer on its own ramp, since the control hover would lighten it past the surface it sits on." />

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="FIELDS" Content="the design's pressed column is focus" />

                        <Grid ColumnDefinitions="86,Auto,Auto,Auto,Auto,Auto"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="10" RowSpacing="9">

                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="caption" Text="live" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Classes="caption" Text="hover" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Classes="caption" Text="focus" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Classes="caption" Text="error" />
                            <TextBlock Grid.Row="0" Grid.Column="5" Classes="caption" Text="disabled" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="text" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="128" PlaceholderText="Placeholder" />
                            <TextBox Grid.Row="1" Grid.Column="2" Width="128" PlaceholderText="Placeholder" Classes="forceHover" />
                            <TextBox Grid.Row="1" Grid.Column="3" Width="128" Text="Iron Plate" Classes="forceFocus" />
                            <TextBox Grid.Row="1" Grid.Column="4" Width="128" Text="Iron Plate" Classes="error" />
                            <TextBox Grid.Row="1" Grid.Column="5" Width="128" PlaceholderText="Placeholder" IsEnabled="False" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="caption" Text="search" VerticalAlignment="Center" />
                            <ui:SearchBox Grid.Row="2" Grid.Column="1" Width="128" PlaceholderText="Filter" />
                            <ui:SearchBox Grid.Row="2" Grid.Column="2" Width="128" PlaceholderText="Filter" Classes="forceHover" />
                            <ui:SearchBox Grid.Row="2" Grid.Column="3" Width="128" Text="heat" Classes="forceFocus" />
                            <ui:SearchBox Grid.Row="2" Grid.Column="4" Width="128" Text="heat" />
                            <ui:SearchBox Grid.Row="2" Grid.Column="5" Width="128" PlaceholderText="Filter" IsEnabled="False" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="caption" Text="masked" VerticalAlignment="Center" />
                            <MaskedTextBox Grid.Row="3" Grid.Column="1" Width="128" Mask="0000-00-00" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="4" Classes="note"
                                       Text="The clear button appears only once there is something to clear. The error column is what a field draws when its binding reports one, which a view model gets by implementing INotifyDataErrorInfo."
                                       VerticalAlignment="Center" />
                        </Grid>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="PROSE AND QUERIES" />

                        <TextBlock Classes="note"
                                   Text="Two fields that are not one line of a value. The notes field drops the fixed height for a floor and grows with what is typed into it. The query field takes the mono family, because a thing with a syntax is not prose, which is the same rule every value editor follows." />

                        <Grid ColumnDefinitions="86,340,*" RowDefinitions="Auto,Auto"
                              ColumnSpacing="14" RowSpacing="11">

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="notes"
                                       VerticalAlignment="Top" Margin="0,6,0,0" />
                            <TextBox Grid.Row="0" Grid.Column="1" Classes="notes"
                                     Text="Loop points sit on the bar line. Do not re encode, the crossfade at the seam is baked into the file."
                                     PlaceholderText="Say what the next person needs to know" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Classes="note"
                                       Text="Type into it and it grows. The well, the border and the focus ramp are the field's own, because a notes box is a field."
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="query"
                                       VerticalAlignment="Center" />
                            <ui:SearchBox Grid.Row="1" Grid.Column="1" Classes="query"
                                          Text="tag:character -status:raw"
                                          PlaceholderText="Search, or type tag: type: owner: to narrow" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Classes="note"
                                       Text="The placeholder stays Archivo whatever the value's family is, which the template pins rather than leaving to the control."
                                       VerticalAlignment="Center" />
                        </Grid>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="PATHS" Content="one path, or none" />

                        <TextBlock Classes="note"
                                   Text="A well holding one path with a browse button beside it. It holds exactly zero or one, so there is no list and no add button, and browsing again replaces what is there. The value is mono because it is a value, and the placeholder is Archivo because it is language. The first one below opens a real dialog." />

                        <Grid ColumnDefinitions="86,340,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="14" RowSpacing="11">

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="file"
                                       VerticalAlignment="Center" />
                            <ui:PathField Grid.Row="0" Grid.Column="1">
                                <ui:PathField.Filters>
                                    <ui:PathFilter Name="Data files" Extensions=".json, .csv" />
                                </ui:PathField.Filters>
                            </ui:PathField>
                            <TextBlock Grid.Row="0" Grid.Column="2" Classes="note"
                                       Text="Empty, and the placeholder names what will be picked. The hint is the filters said in words."
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="filled"
                                       VerticalAlignment="Center" />
                            <ui:PathField Grid.Row="1" Grid.Column="1"
                                          Path="/home/jason/Projects/game/data/items.json" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Classes="note"
                                       Text="The clear button appears only now. The design hides it again on focus, and it stays, because a press inside the well focuses the field and a button that went would go under its own press."
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="caption" Text="folder"
                                       VerticalAlignment="Center" />
                            <ui:PathField Grid.Row="2" Grid.Column="1" Target="Folder" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Classes="note"
                                       Text="The same glyph. The placeholder, the hint and the dialog it opens are what differ."
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="caption" Text="no typing"
                                       VerticalAlignment="Center" />
                            <ui:PathField Grid.Row="3" Grid.Column="1" Target="Folder"
                                          AllowsTyping="False"
                                          Path="/home/jason/Projects/game" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Classes="note"
                                       Text="The well drops to the chrome tone and takes no caret. This is not the disabled look: the text keeps its tone and browse and clear both still work."
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Classes="caption" Text="invalid"
                                       VerticalAlignment="Center" />
                            <ui:PathField Grid.Row="4" Grid.Column="1"
                                          Path="/home/jason/Projects/game/data/items.txt"
                                          Problem="Only .json and .csv files are accepted" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Classes="note"
                                       Text="Only reachable when typing is on. The message replaces the hint rather than adding a row."
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Classes="caption" Text="missing"
                                       VerticalAlignment="Center" />
                            <ui:PathField Grid.Row="5" Grid.Column="1"
                                          Path="/mnt/old/game/data/items.json"
                                          Problem="That file is not there any more"
                                          ProblemTier="Warn" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Classes="note"
                                       Text="A path that was good and no longer resolves is a warning. The value is kept so the drive can be fixed rather than the path retyped."
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Classes="caption" Text="compact"
                                       VerticalAlignment="Center" />
                            <ui:PathField Grid.Row="6" Grid.Column="1" Width="240"
                                          HorizontalAlignment="Left"
                                          IsCompact="True"
                                          Path="/home/jason/Projects/game" />
                            <TextBlock Grid.Row="6" Grid.Column="2" Classes="note"
                                       Text="The icon only form, for an inspector row or any column too narrow for the word."
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Classes="caption" Text="disabled"
                                       VerticalAlignment="Center" />
                            <ui:PathField Grid.Row="7" Grid.Column="1" IsEnabled="False"
                                          Path="/home/jason/Projects/game/data/items.json" />
                            <TextBlock Grid.Row="7" Grid.Column="2" Classes="note"
                                       Text="Both halves flatten and the clear button is dropped rather than greyed."
                                       VerticalAlignment="Center" />
                        </Grid>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="CHOICES" Content="mixed is real, not styled" />

                        <Grid ColumnDefinitions="86,60,60,60,60,Auto"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="10" RowSpacing="9">

                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="caption" Text="off" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Classes="caption" Text="on" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Classes="caption" Text="hover" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Classes="caption" Text="focus" />
                            <TextBlock Grid.Row="0" Grid.Column="5" Classes="caption" Text="disabled" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="checkbox" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="1" Grid.Column="1" />
                            <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="True" />
                            <CheckBox Grid.Row="1" Grid.Column="3" IsChecked="True" Classes="forceHover" />
                            <CheckBox Grid.Row="1" Grid.Column="4" Classes="forceFocus" />
                            <CheckBox Grid.Row="1" Grid.Column="5" IsChecked="True" IsEnabled="False" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="caption" Text="mixed" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="2" Grid.Column="1" IsThreeState="True" IsChecked="{x:Null}" />
                            <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" IsThreeState="True"
                                      IsChecked="{x:Null}" Content="Click through off, on and mixed" />
                            <CheckBox Grid.Row="2" Grid.Column="5" IsThreeState="True" IsChecked="{x:Null}" IsEnabled="False" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="caption" Text="radio" VerticalAlignment="Center" />
                            <RadioButton Grid.Row="3" Grid.Column="1" GroupName="galleryA" />
                            <RadioButton Grid.Row="3" Grid.Column="2" GroupName="galleryB" IsChecked="True" />
                            <RadioButton Grid.Row="3" Grid.Column="3" GroupName="galleryC" IsChecked="True" Classes="forceHover" />
                            <RadioButton Grid.Row="3" Grid.Column="4" GroupName="galleryD" Classes="forceFocus" />
                            <RadioButton Grid.Row="3" Grid.Column="5" GroupName="galleryE" IsChecked="True" IsEnabled="False" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Classes="caption" Text="toggle" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Row="4" Grid.Column="1" />
                            <ToggleSwitch Grid.Row="4" Grid.Column="2" IsChecked="True" />
                            <ToggleSwitch Grid.Row="4" Grid.Column="3" Classes="forceHover" />
                            <ToggleSwitch Grid.Row="4" Grid.Column="4" IsChecked="True" Classes="forceFocus" />
                            <ToggleSwitch Grid.Row="4" Grid.Column="5" IsChecked="True" IsEnabled="False" />
                        </Grid>

                        <TextBlock Classes="note"
                                   Text="The toggle knob travels in 140ms on the design's own curve. It is a transition on the part the control moves, because an animation would have to target a transform, and a key frame on RenderTransform throws while one on TransformOperations does nothing at all." />

                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <ui:Segmented>
                                <RadioButton GroupName="gallerySeg" Content="Table" IsChecked="True" />
                                <RadioButton GroupName="gallerySeg" Content="Grid" />
                                <RadioButton GroupName="gallerySeg" Content="Cards" />
                            </ui:Segmented>

                            <ui:Segmented>
                                <RadioButton GroupName="gallerySegHeld" Content="Table" IsChecked="True" />
                                <RadioButton GroupName="gallerySegHeld" Content="Grid" Classes="forceHover" />
                                <RadioButton GroupName="gallerySegHeld" Content="Cards" Classes="forceFocus" />
                            </ui:Segmented>

                            <ui:Segmented IsEnabled="False">
                                <RadioButton GroupName="gallerySegOff" Content="Table" IsChecked="True" />
                                <RadioButton GroupName="gallerySegOff" Content="Grid" />
                            </ui:Segmented>
                        </StackPanel>

                        <TextBlock Classes="note"
                                   Text="No option here has a fill, in any state. The thumb behind the row is the fill, and it takes both a position and a width, since the options are different widths. It moves in 200ms on the knob's curve, and it snaps rather than slides on a first load and on a resize. Hover and pressed are ink alone, so nothing else on the row is a raised surface while the thumb is moving." />

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="VALUES" Content="every value in mono" />

                        <Grid ColumnDefinitions="86,190,190,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="12" RowSpacing="10">

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="slider" VerticalAlignment="Center" />
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" Value="0.58" />
                            <Slider Grid.Row="0" Grid.Column="2" Minimum="0" Maximum="1" Value="0.58" IsEnabled="False" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="stepped" VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                                    TickFrequency="0.25" IsSnapToTickEnabled="True" TickPlacement="Outside" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Classes="note"
                                       Text="Ticks and snapping are settings rather than code."
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="caption" Text="range" VerticalAlignment="Center" />
                            <ui:RangeSlider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1"
                                            LowerValue="0.28" UpperValue="0.72" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Classes="note"
                                       Text="Drag either knob. Neither can pass the other."
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="caption" Text="spinbox" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="12.5" Increment="0.5"
                                           FormatString="0.0" HorizontalAlignment="Left" />
                            <NumericUpDown Grid.Row="3" Grid.Column="2" Value="12.5" Increment="0.5"
                                           FormatString="0.0" HorizontalAlignment="Left" IsEnabled="False" />
                        </Grid>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="COLOUR" Content="the swatch opens the picker" />

                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <ui:ColorField Name="Tint" Header="FILL COLOUR" />
                            <ui:ColorField Color="{Binding #Tint.Color, Mode=OneWay}" Classes="forceHover" />
                            <ui:ColorField Color="{Binding #Tint.Color, Mode=OneWay}" Classes="forceFocus" />
                            <ui:ColorField Color="{Binding #Tint.Color, Mode=OneWay}" IsEnabled="False" />
                        </StackPanel>

                        <TextBlock Classes="note"
                                   Text="The field holds one colour and opens the picker on it. Apply commits, and dismissing the popover leaves the field as it was. Six digits while the colour is opaque and eight when there is alpha to spell out." />

                        <TextBlock Classes="note"
                                   Text="The stepper sits inside the well behind a hairline rather than floating outside it, which is the rule every value editor follows. Nothing is built for it: a spinbox is a NumericUpDown over a ButtonSpinner over a text field, and only the frame is themed." />

                        <TextBlock Classes="note"
                                   Text="Drag the spinbox value sideways to scrub it. A click still puts the caret in, since nothing happens until the pointer has moved past a threshold." />

                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <ComboBox Width="150" PlaceholderText="Pick one">
                                <ComboBoxItem Content="Table" />
                                <ComboBoxItem Content="Grid" />
                                <ComboBoxItem Content="Cards" />
                            </ComboBox>
                            <ComboBox Width="150" SelectedIndex="0">
                                <ComboBoxItem Content="Machines" />
                                <ComboBoxItem Content="Recipes" />
                            </ComboBox>
                            <ComboBox Width="120" PlaceholderText="Off" IsEnabled="False" />
                            <HyperlinkButton Content="project.godot" />
                            <HyperlinkButton Content="project.godot" IsEnabled="False" />
                        </StackPanel>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="DATE AND TIME" Content="both read the culture" />

                        <TextBlock Classes="note"
                                   Text="Nothing here writes a day name, a month name, a field order or a time format. The culture decides all four, so en-US reads 7/28/2026 and starts its week on Sunday, de-DE reads 28.07.2026 and starts on Monday, and ja-JP reads 2026/07/28." />

                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <CalendarDatePicker Width="150" SelectedDate="2026-07-28" />
                            <CalendarDatePicker Width="150" IsEnabled="False" SelectedDate="2026-07-28" />
                            <TimePicker SelectedTime="14:05" />
                            <TimePicker IsEnabled="False" SelectedTime="14:05" />
                        </StackPanel>

                        <TextBlock Classes="note"
                                   Text="The calendar opens on the date the field holds, or on today when it holds none, and the field is only emptied by the Clear button in the popover. The clock follows the culture too. Avalonia defaults to twelve hours whatever the culture says, so it is asked instead: en-US reads 2:05 PM with a period column and hours 1 to 12, and de-DE reads 14:05 with hours 0 to 23. Its popover carries Set and Cancel as well as Now, because a working presenter only writes the time when it is accepted, where the design's popover is a picture." />
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="COLOUR PICKER" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="One body and two hosts. Floating it is a card with a shadow and a Cancel and Apply footer, dropped into a panel it gives up all three and the value applies live, and the footer reads back the line that will be written. Both are the same control and the same template." />

                        <StackPanel Orientation="Horizontal" Spacing="22">
                            <StackPanel Spacing="9">
                                <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                        Header="IN A PANEL" Content="applies live" />
                                <ui:ColorPicker Name="Bench" IsInPanel="True" Header="FILL COLOUR" />
                            </StackPanel>

                            <StackPanel Spacing="9" Width="320">
                                <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                        Header="FLOATING" Content="the same body" />

                                <TextBlock Classes="note"
                                           Text="The other host. The same control in a flyout, where it draws its own card and its own shadow and commits on Apply. This is what the colour field opens, written out by hand." />

                                <Button Name="Floater" Content="Open the picker" HorizontalAlignment="Left">
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="popover">
                                            <ui:ColorPicker Name="Floating" Header="TINT" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                        Header="THE SHAPES" Content="seven of them" />

                                <TextBlock Classes="note"
                                           Text="Godot's own set, chosen from the menu in the header. A saturation and value square with hue beside it, the same square inside a hue ring, a hue circle with value beside it, the perceptual circle with lightness beside it, two perceptual rectangles, and the rows on their own. The bar always carries whatever the shape does not, and the ring carries all three itself." />

                                <TextBlock Classes="note"
                                           Text="The three perceptual surfaces are painted a pixel at a time, since OKHSL is not a straight line in sRGB and no gradient can hold it. Godot uses a shader. Measured here: 9042 pixels in 3.2 ms, painted at half the size and scaled up, which cannot be told apart." />

                                <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                        Header="THE MODES" Content="four of them" />

                                <TextBlock Classes="note"
                                           Text="RGB and HSV read whole numbers, LINEAR reads the colour as light, and OKHSL is Ottosson's space, so a hue drag there keeps its lightness where the same drag in HSV does not. Every mode carries the I row, which is Godot's intensity: it multiplies in light, so one stop is twice as bright. Type 400 into red and the excess moves into that row, which is what Godot does." />

                                <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                        Header="THE EYEDROPPER" Content="the desktop's own" />

                                <TextBlock Classes="note"
                                           Text="The crosshair in the header hands the gesture to the desktop portal, which draws the magnifier and gives one colour back. It works the same on Wayland and X11 and on any desktop that implements the portal. It is drawn only where there is one, so on Windows there is no button at all." />

                                <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                        Header="SWATCHES" Content="empty until they are not" />

                                <TextBlock Classes="note"
                                           Text="Nothing is seeded. The add tile keeps today's colour, a right click takes one off, and the recent row fills itself as colours are picked. The gallery holds both lists, which is where an application would put its own." />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="PANELS" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="A panel takes one step down from whatever it is put inside, and nothing counts. The root tone belongs to the window and never appears again, so no panel can ever take it. This section is itself a surface, which is why the ladder below starts one step in." />

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="THE LADDER" Content="five deep" />

                        <ui:SurfacePanel Header="Dock" Footer="the same three tones, cycling">
                            <ui:SurfacePanel Header="Pane">
                                <ui:SurfacePanel Header="Effect graph">
                                    <ui:SurfacePanel Header="Node: yield curve">
                                        <ui:SurfacePanel Header="Inputs" Padding="10">
                                            <StackPanel Spacing="9">
                                                <TextBlock Classes="note"
                                                           Text="The deepest one here matches its great grandparent and neither of the two panels either side of it, which is the whole point of a cycle of three." />

                                                <!-- Controls are off the ramp. These sit four
                                                     steps down and are the same fill and the
                                                     same border they are at the top. -->
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Button Content="Still SurfaceNest2" />
                                                    <ui:Chip Content="so is this" />
                                                </StackPanel>
                                            </StackPanel>
                                        </ui:SurfacePanel>
                                    </ui:SurfacePanel>
                                </ui:SurfacePanel>
                            </ui:SurfacePanel>
                        </ui:SurfacePanel>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="HEADER, BODY AND FOOTER" />

                        <TextBlock Classes="note"
                                   Text="One tone throughout. The header and the footer are told apart from the body by a hairline alone, and that hairline is the seam belonging to the panel's own tone. A header takes whatever it is given, so a title keeps its actions on the right without a second slot for them." />

                        <ui:SurfacePanel Padding="10" Footer="RCP_IronPlate_T2">
                            <ui:SurfacePanel.Header>
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                                        <Button Classes="icon" ToolTip.Tip="Collapse all"
                                                AutomationProperties.Name="Collapse all">
                                            <ui:Icon Glyph="Minimize" />
                                        </Button>
                                        <Button Classes="icon" ToolTip.Tip="Add output"
                                                AutomationProperties.Name="Add output">
                                            <ui:Icon Glyph="Plus" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="Primary output" VerticalAlignment="Center" />
                                </DockPanel>
                            </ui:SurfacePanel.Header>

                            <StackPanel Spacing="9">
                                <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                        Header="OUTPUTS" Content="3 of 3 resolved" />
                                <TextBlock Classes="note"
                                           Text="A section label is a header over content, so the label is the header, the note is the content, and the rule fills what is left." />
                            </StackPanel>
                        </ui:SurfacePanel>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="COLLAPSIBLE" />

                        <Expander Header="Byproducts" IsExpanded="True">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="note" Text="The same shape with the header as the switch." />
                                <Expander Header="Nested, and one step further down">
                                    <TextBlock Classes="note" Text="Closed, the seam under the header rules off nothing, so it goes." />
                                </Expander>
                            </StackPanel>
                        </Expander>

                        <TextBlock Classes="note"
                                   Text="The caret moves to the end of the row for a header that reads as a setting, label on the left and today's answer on the right. A caret in front of the label would push the labels of a stack of these out of line with every other row in the panel. The value is content the view docks right inside the header." />

                        <Expander Classes="trailingCaret">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Classes="rowCount" Text="Web 2048" />
                                    <TextBlock Text="Export preset" VerticalAlignment="Center" />
                                </DockPanel>
                            </Expander.Header>
                            <TextBlock Classes="note" Text="What the preset holds goes here." />
                        </Expander>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="SPLITTER" Content="grab the seam" />

                        <TextBlock Classes="note"
                                   Text="At rest the splitter is the hairline itself, so the panes stay flush. Hover turns that one pixel accent and dragging widens it to three, centred, so nothing shifts. The reach is seven at every state, which is why it can be grabbed at all." />

                        <Grid ColumnDefinitions="*,Auto,*" Height="120">
                            <ui:SurfacePanel Grid.Column="0" Header="Left" />
                            <GridSplitter Grid.Column="1" />
                            <Grid Grid.Column="2" RowDefinitions="*,Auto,*">
                                <ui:SurfacePanel Grid.Row="0" Header="Top right" />
                                <GridSplitter Grid.Row="1" />
                                <ui:SurfacePanel Grid.Row="2" Header="Bottom right" />
                            </Grid>
                        </Grid>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="NOTHING IN IT YET" />

                        <ui:SurfacePanel Header="Graph" Height="128">
                            <StackPanel Classes="emptyState">
                                <ui:Icon Glyph="Workflow" />
                                <TextBlock Text="No graph assigned" />
                                <Button Content="Assign" />
                            </StackPanel>
                        </ui:SurfacePanel>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="A SIDEBAR THAT SLIDES AWAY" />

                        <TextBlock Classes="note"
                                   Text="A pane is chrome rather than a panel, so it keeps the root tone at any depth and never joins the ramp." />

                        <SplitView Name="Sidebar" Height="130" IsPaneOpen="True"
                                   DisplayMode="CompactInline" OpenPaneLength="180">
                            <SplitView.Pane>
                                <StackPanel Margin="8" Spacing="6">
                                    <Button Classes="icon" ToolTip.Tip="Toggle the pane"
                                            AutomationProperties.Name="Toggle the pane"
                                            Click="OnTogglePane">
                                        <ui:Icon Glyph="Layout" />
                                    </Button>

                                    <!-- Closed, the pane is a strip with room for the mark
                                         alone, so the label goes rather than being cut. -->
                                    <TextBlock Classes="caption" Text="Sidebar"
                                               IsVisible="{Binding #Sidebar.IsPaneOpen}" />
                                </StackPanel>
                            </SplitView.Pane>
                            <ui:SurfacePanel Header="Content" Margin="8">
                                <TextBlock Classes="note" Text="The pane reserves its room inline and floats over this in an overlay mode." />
                            </ui:SurfacePanel>
                        </SplitView>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="MOVING ONE" Content="the depth follows" />

                        <TextBlock Classes="note"
                                   Text="Docking reparents panels, so the tone cannot be worked out once and kept. Move this one between two grounds of different depth and it repaints itself and everything inside it." />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <ui:SurfacePanel Name="ShallowGround" Grid.Column="0" Header="A shallow ground">
                                <ui:SurfacePanel Name="Nomad" Header="Move me">
                                    <ui:SurfacePanel Header="And what is inside me" />
                                </ui:SurfacePanel>
                            </ui:SurfacePanel>

                            <ui:SurfacePanel Name="DeepGround" Grid.Column="1" Header="A deeper ground">
                                <ui:SurfacePanel Header="One deeper again" Name="DeeperGround" />
                            </ui:SurfacePanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Move it" Click="OnMovePanel" />
                            <TextBlock Name="NomadLevel" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="LISTS AND TREES" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="A row never carries both a fill and an outline. Hover and selection are fills, focus is the same halo every control draws, and a drop target is the only dashed edge in the theme." />

                        <Grid ColumnDefinitions="230,*" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Spacing="9">
                                <HeaderedContentControl Theme="{StaticResource SectionLabel}" Header="ROW STATES" />

                                <Border Classes="panel" Padding="5">
                                    <StackPanel>
                                        <ListBoxItem Content="Normal" />
                                        <ListBoxItem Content="Hover" Classes="forceHover" />
                                        <ListBoxItem Content="Pressed" Classes="forcePressed" />
                                        <ListBoxItem Content="Selected" IsSelected="True" />
                                        <ListBoxItem Content="Selected and focused" IsSelected="True" Classes="forceFocus" />
                                        <ListBoxItem Content="Modified" Classes="modified" />
                                        <ListBoxItem Content="Drop target" Classes="drop" />
                                        <ListBoxItem Content="Disabled" IsEnabled="False" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Classes="note"
                                           Text="Focus on a selected row is the halo over the tint, so neither one replaces the other." />

                                <HeaderedContentControl Theme="{StaticResource SectionLabel}" Header="ROW FURNITURE" />

                                <Border Classes="panel" Padding="5">
                                    <StackPanel>
                                        <ListBoxItem>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Classes="rowCount" Text="184" />
                                                <ui:Icon DockPanel.Dock="Left" Glyph="Package" Margin="0,0,9,0" />
                                                <TextBlock Text="Everything" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </ListBoxItem>
                                        <ListBoxItem IsSelected="True">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Classes="rowCount" Text="12" />
                                                <ui:Icon DockPanel.Dock="Left" Glyph="ArrowToBottom" Margin="0,0,9,0" />
                                                <TextBlock Text="Just arrived" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </ListBoxItem>
                                        <ListBoxItem>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Classes="rowCount" Text="31" />
                                                <Border DockPanel.Dock="Left" Classes="mark"
                                                        Background="{DynamicResource PinInt}" Margin="0,0,11,0" />
                                                <TextBlock Text="Ships in the demo" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </ListBoxItem>
                                        <ListBoxItem>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Classes="rowCount" Text="8" />
                                                <Ellipse DockPanel.Dock="Left" Classes="dot"
                                                         Fill="{DynamicResource Warn}" Margin="0,0,11,0" />
                                                <TextBlock Text="character" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </ListBoxItem>
                                    </StackPanel>
                                </Border>

                                <TextBlock Classes="note"
                                           Text="A count is a value, so it can only arrive as content, which is why it is a style a view applies rather than a part of the row. The square mark names a thing and the round one names a label somebody applied." />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="9">
                                <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                        Header="TREE" Content="click a caret" />

                                <Border Classes="panel" Padding="0" Height="266">
                                    <ui:Tree Name="SampleTree">
                                        <ui:Tree.ItemTemplate>
                                            <DataTemplate x:DataType="views:Node">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Classes="rowCount"
                                                               Text="{Binding Count}" />
                                                    <TextBlock Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ui:Tree.ItemTemplate>
                                    </ui:Tree>
                                </Border>

                                <TextBlock Classes="note"
                                           Text="A single click picks a row, a double click opens it, and a click on the caret opens it without changing what is picked. Left and right arrow do the same from the keyboard." />
                            </StackPanel>
                        </Grid>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="TEN THOUSAND ROWS" Content="the reason a tree is flat" />

                        <TextBlock Classes="note"
                                   Text="Avalonia has no virtualising tree, so this one is a flat list of the rows that can be seen and expanding edits the list. Open everything and the row count runs into five figures while the number of controls stays in two." />

                        <Border Classes="panel" Padding="0" Height="180">
                            <ui:Tree Name="BigTree">
                                <ui:Tree.ItemTemplate>
                                    <DataTemplate x:DataType="views:Node">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ui:Tree.ItemTemplate>
                            </ui:Tree>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Open everything" Click="OnExpandAll" />
                            <Button Classes="ghost" Content="Close everything" Click="OnCollapseAll" />
                            <Button Classes="ghost" Content="Count what is real" Click="OnCountRows" />
                            <TextBlock Name="RowCount" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="TEXT DIFF" Content="every kind, and the words that differ" />

                        <TextBlock Classes="note"
                                   Text="A diff is a document rather than a list of things, so its rows are flush and what tells one line from the next is the mark down its left. The three kinds every diff has are here with the four a merge adds. Changed words inside a line are worked out and lit, so a one character change in a long line is visible without reading it twice." />

                        <Border Classes="panel" Padding="0" Height="330">
                            <ui:TextDiff Name="SampleDiff" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Mark the words" Click="OnMarkWords" />
                            <Button Classes="ghost" Content="Leave them" Click="OnLeaveWords" />
                            <TextBlock Name="DiffCount" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}" Header="LIST" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <Border Grid.Column="0" Classes="panel" Padding="0" Height="172">
                                <ListBox Name="SampleList">
                                    <ListBoxItem Content="One" />
                                    <ListBoxItem Content="Two" />
                                    <ListBoxItem Content="Three" Classes="modified" />
                                    <ListBoxItem Content="Four" />
                                    <ListBoxItem Content="Five" IsEnabled="False" />
                                </ListBox>
                            </Border>

                            <TextBlock Grid.Column="1" Classes="note" VerticalAlignment="Center"
                                       Text="A list is the same row without the indent, the caret or the guides. It virtualises on its own, since ListBox is the one items control in Avalonia that replaces its panel with a virtualising one." />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="TABS" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="The open tab is the only one that takes the page's surface and the only one that draws the accent marker. Both together, since either alone would be saying it in colour." />

                        <!-- The library's own panel rather than the page's, since a strip that fills a rounded
                             frame corner to corner is the case that needs two borders. -->
                        <ui:SurfacePanel Padding="0" Height="150">
                            <TabControl>
                                <TabItem Header="one.toml">
                                    <TextBlock Classes="note" Margin="14"
                                               Text="A tab names a document, so its label is mono." />
                                </TabItem>
                                <TabItem Header="two.toml" Classes="modified">
                                    <TextBlock Classes="note" Margin="14"
                                               Text="This one has unsaved changes, which is the round mark at its end." />
                                </TabItem>
                                <TabItem Header="three.toml" IsEnabled="False" />
                            </TabControl>
                        </ui:SurfacePanel>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="DOCKING" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="Docking is Dock for Avalonia under a Slate theme. A document tab carries the top marker and a close, a tool tab is a flat label sharing its strip with the dock's own buttons, and every division between docks is the seam until a pointer is on it." />

                        <ui:SurfacePanel Padding="0" Height="452" ClipToBounds="True">
                            <DockControl Name="Docking" />
                        </ui:SurfacePanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Float the inspector" Click="OnFloatTool" />
                            <Button Content="Pin the explorer" Click="OnPinTool" />
                            <Button Content="Close every document" Click="OnCloseDocuments" />
                            <Button Content="Build the layout again" Click="OnResetDock" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="DATA GRID" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="A grid is the list underneath with a column layout over the top, so virtualisation, selection and the row states are the ones already built. Click a title to sort, drag the edge between two titles to resize, and double click a value to edit it in place. Escape puts the old one back." />

                        <TextBlock Classes="note"
                                   Text="Ten thousand rows, a hundred to a page. The Columns button hides one column, which is the whole of what a chooser would do." />

                        <ui:DataGrid Name="SampleGrid" Height="342" SelectionMode="Multiple">
                            <ui:DataGrid.Toolbar>
                                <DockPanel LastChildFill="False">
                                    <ui:SearchBox DockPanel.Dock="Left"
                                                  Width="220"
                                                  PlaceholderText="Filter rows" />

                                    <Button DockPanel.Dock="Right" Classes="primary" Content="New row" />

                                    <Button DockPanel.Dock="Right"
                                            Classes="ghost"
                                            Content="Columns"
                                            Margin="0,0,7,0"
                                            Click="OnHideColumn" />
                                </DockPanel>
                            </ui:DataGrid.Toolbar>

                            <ui:DataGrid.Columns>
                                <!-- The picker column. Bound to the row's own selection, so the
                                     box and the tint are the same thing being said. Its title
                                     is a control, which is all a header has to be. -->
                                <ui:GridColumn Width="34" MinWidth="34" CanResize="False" Alignment="Center">
                                    <ui:GridColumn.Header>
                                        <CheckBox Name="PickAll" Click="OnPickAll" />
                                    </ui:GridColumn.Header>

                                    <ui:GridColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:Entry">
                                            <CheckBox IsChecked="{Binding $parent[ui:DataGridRow].IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ui:GridColumn.CellTemplate>
                                </ui:GridColumn>

                                <ui:GridColumn Header="ID" Width="190" IsMono="True" IsStrong="True">
                                    <ui:GridColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:Entry">
                                            <TextBlock Text="{Binding Id}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ui:GridColumn.CellTemplate>
                                </ui:GridColumn>

                                <ui:GridColumn Header="NAME" MinWidth="120" IsStrong="True">
                                    <ui:GridColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:Entry">
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ui:GridColumn.CellTemplate>
                                </ui:GridColumn>

                                <ui:GridColumn Header="KIND" Width="150">
                                    <ui:GridColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:Entry">
                                            <TextBlock Text="{Binding Kind}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ui:GridColumn.CellTemplate>
                                </ui:GridColumn>

                                <ui:GridColumn Header="VALUE" Width="96" IsMono="True" Alignment="Right">
                                    <ui:GridColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:Entry">
                                            <TextBlock Text="{Binding Value}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ui:GridColumn.CellTemplate>

                                    <ui:GridColumn.EditTemplate>
                                        <DataTemplate x:DataType="views:Entry">
                                            <TextBox Classes="mono"
                                                     Text="{Binding Value, Mode=TwoWay}"
                                                     TextAlignment="Right" />
                                        </DataTemplate>
                                    </ui:GridColumn.EditTemplate>
                                </ui:GridColumn>

                                <ui:GridColumn Header="TIER" Width="104" IsMono="True">
                                    <ui:GridColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:Entry">
                                            <TextBlock Text="{Binding Tier}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ui:GridColumn.CellTemplate>
                                </ui:GridColumn>

                                <!-- A status cell is the stage four pill rather than a cell
                                     style of its own. Wide enough for the longest label at
                                     the roomier density, since a pinned width does not
                                     scale and a pill that does will clip inside one. -->
                                <ui:GridColumn Header="STATE" Width="140">
                                    <ui:GridColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:Entry">
                                            <ui:StatusPill Status="{Binding Status}"
                                                           Text="{Binding State}"
                                                           VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ui:GridColumn.CellTemplate>
                                </ui:GridColumn>
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>

                        <ui:GridPager Name="SamplePager" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="ghost" Content="Group by kind" Click="OnGroupGrid" />
                            <Button Classes="ghost" Content="Turn paging off" Click="OnPageGrid" />
                            <Button Classes="ghost" Content="Count what is real" Click="OnCountCells" />

                            <!-- Toggled on the grid above rather than drawn as a second one,
                                 so the two looks can be read against the same rows. -->
                            <ToggleButton Classes="ghost" Content="Plain" Click="OnPlainGrid" />

                            <TextBlock Name="GridCount" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Classes="note"
                                   Text="Plain is the other thing a table can be: a way of looking at a list that is already on a page, beside a second way of looking at the same list. It drops the rule under every row, the stripe and the header's fill, and its rows take the list's radius and spacing instead." />

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="TREE DATA GRID"
                                                Content="the same column model" />

                        <TextBlock Classes="note"
                                   Text="One column model, laid out by both grids. Only the leading column indents, and a branch row carries what its children add up to, so a closed branch still answers the question they would." />

                        <ui:TreeDataGrid Name="SampleTreeGrid" Height="250">
                            <ui:TreeDataGrid.Columns>
                                <ui:GridColumn Width="34" MinWidth="34" CanResize="False" Alignment="Center">
                                    <ui:GridColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:Aggregate">
                                            <CheckBox IsChecked="{Binding $parent[ui:TreeDataGridRow].IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ui:GridColumn.CellTemplate>
                                </ui:GridColumn>

                                <ui:GridColumn Header="NAME" MinWidth="140">
                                    <ui:GridColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:Aggregate">
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ui:GridColumn.CellTemplate>
                                </ui:GridColumn>

                                <ui:GridColumn Header="KIND" Width="150">
                                    <ui:GridColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:Aggregate">
                                            <TextBlock Text="{Binding Kind}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ui:GridColumn.CellTemplate>
                                </ui:GridColumn>

                                <ui:GridColumn Header="VALUE" Width="96" IsMono="True" Alignment="Right">
                                    <ui:GridColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:Aggregate">
                                            <TextBlock Text="{Binding Value}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ui:GridColumn.CellTemplate>
                                </ui:GridColumn>

                                <ui:GridColumn Header="TIER" Width="104" IsMono="True" Alignment="Right">
                                    <ui:GridColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:Aggregate">
                                            <TextBlock Text="{Binding Tier}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ui:GridColumn.CellTemplate>
                                </ui:GridColumn>

                                <ui:GridColumn Header="STATE" Width="118">
                                    <ui:GridColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:Aggregate">
                                            <TextBlock Text="{Binding State}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ui:GridColumn.CellTemplate>
                                </ui:GridColumn>
                            </ui:TreeDataGrid.Columns>
                        </ui:TreeDataGrid>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="TOASTS" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="A toast is a popover that nobody opened, so it takes the popover surface exactly. Raise one and it lands in the region chosen below. Hover a card to hold its timer, and watch the other regions keep counting." />

                        <TextBlock Classes="note"
                                   Text="Nothing on this page reaches for a global. The window is handed a toast service through its constructor, the way a tool would be." />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="caption" Text="region" VerticalAlignment="Center" />
                            <ComboBox Name="ToastRegions" Width="160" />
                            <Button Classes="ghost" Content="Clear them all" Click="OnToastClear" />
                        </StackPanel>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="KINDS"
                                                Content="four semantic, one busy" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Info" Click="OnToastInfo" />
                            <Button Content="Ok" Click="OnToastOk" />
                            <Button Content="Warning" Click="OnToastWarn" />
                            <Button Content="Error" Click="OnToastError" />
                            <Button Content="Busy" Click="OnToastProgress" />
                        </StackPanel>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="FORMS"
                                                Content="and what repeats do" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Compact" Click="OnToastCompact" />
                            <Button Content="Undo bar" Click="OnToastUndo" />
                            <Button Content="Press twice to group" Click="OnToastRepeat" />
                            <Button Content="Every region at once" Click="OnToastEveryRegion" />
                        </StackPanel>

                        <TextBlock Classes="note"
                                   Text="An error and anything still running have no timer bar, which is what says they will not go away by themselves. Four in one region shows three and counts the rest." />

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="A REGION OF ITS OWN"
                                                Content="clipped to the panel" />

                        <TextBlock Classes="note"
                                   Text="This panel owns a second toast service, so its cards are its own and stay inside it. That is what lets a tool panel report its own progress while the window reports a save." />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Report in the panel" Click="OnToastPanel" />
                        </StackPanel>

                        <ui:SurfacePanel Header="Pack" Height="150">
                            <Panel>
                                <TextBlock Classes="caption"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="the panel's own content" />
                                <ui:ToastHost Name="PanelToasts" />
                            </Panel>
                        </ui:SurfacePanel>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="ALERTS" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="Where a toast describes something that just happened, an alert describes the state of what is on screen. It has no shadow and no dwell, it sits in the layout until the condition goes away, and the same condition is never both." />

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="BLOCK"
                                                Content="the default" />

                        <StackPanel Spacing="10">
                            <ui:Alert Title="Changes here affect 34 recipes"
                                      Description="They will be revalidated when you save." />

                            <ui:Alert Tier="Ok" IsDismissable="True"
                                      Title="Schema is up to date"
                                      Description="Last migrated on 2026-07-22 by the 4.7 pack." />

                            <ui:Alert Tier="Warn"
                                      Title="2 machines have no recipe"
                                      Description="They will build but produce nothing at runtime.">
                                <ui:Alert.Actions>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Theme="{StaticResource CompactButton}" Classes="neutral" Content="Fix all" />
                                        <Button Theme="{StaticResource CompactButton}" Content="Show in Problems" />
                                        <HyperlinkButton Content="Ignore for this workspace" />
                                    </StackPanel>
                                </ui:Alert.Actions>
                            </ui:Alert>

                            <ui:Alert Tier="Error"
                                      Title="Cannot save while the graph has cycles"
                                      Description="Heat to Throughput to Heat. Break the cycle to continue.">
                                <ui:Alert.Actions>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Theme="{StaticResource CompactButton}" Classes="primary" Content="Reveal cycle" />
                                        <HyperlinkButton Content="Copy path" />
                                    </StackPanel>
                                </ui:Alert.Actions>
                            </ui:Alert>

                            <!-- The buttons an alert can carry instead of the neutral pair.
                                 The surface under them is already the warn tint, so the grey
                                 fill every other button takes reads as grey stuck on amber. -->
                            <ui:Alert Tier="Warn"
                                      Title="3 files are the same file"
                                      Description="They have different names and one hash.">
                                <ui:Alert.Actions>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Theme="{StaticResource CompactButton}" Classes="warn" Content="Keep one, link rest" />
                                        <Button Theme="{StaticResource CompactButton}" Classes="warnGhost" Content="Compare" />
                                    </StackPanel>
                                </ui:Alert.Actions>
                            </ui:Alert>
                        </StackPanel>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="STRIP"
                                                Content="full bleed under a header" />

                        <TextBlock Classes="note"
                                   Text="A strip replaces neither the title bar nor the status bar. It sits under the header of the thing it applies to and scrolls away with it, which is why it is square and draws only its own seam." />

                        <ui:SurfacePanel Header="Details" Padding="0">
                            <StackPanel>
                                <ui:Alert Form="Strip" Tier="Warn"
                                          Title="Read only, this record comes from an imported pack.">
                                    <ui:Alert.Actions>
                                        <HyperlinkButton Content="Override" />
                                    </ui:Alert.Actions>
                                </ui:Alert>

                                <StackPanel Margin="12,11" Spacing="10">
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="caption" Text="Display name" />
                                        <TextBox Text="Iron Plate, Reinforced" IsEnabled="False" />
                                    </StackPanel>

                                    <ui:Alert Title="Changes here affect 34 recipes"
                                              Description="They will be revalidated when you save." />
                                </StackPanel>
                            </StackPanel>
                        </ui:SurfacePanel>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="INLINE"
                                                Content="attached to one field" />

                        <TextBlock Classes="note"
                                   Text="Only an error recolours the control it is attached to, and it recolours the border and the text and never the label. A warning and a hint leave the field alone." />

                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <StackPanel Spacing="5" Width="200">
                                <TextBlock Classes="caption" Text="Base heat" />
                                <TextBox Classes="error mono" Text="12oo" Width="132" HorizontalAlignment="Left" />
                                <ui:Alert Form="Inline" Tier="Error"
                                          Title="Must be a number between 0 and 1200." />
                            </StackPanel>

                            <StackPanel Spacing="5" Width="200">
                                <TextBlock Classes="caption" Text="Base heat" />
                                <TextBox Classes="mono" Text="980" Width="132" HorizontalAlignment="Left" />
                                <ui:Alert Form="Inline" Tier="Warn"
                                          Title="Above the machine rating of 900." />
                            </StackPanel>

                            <StackPanel Spacing="5" Width="200">
                                <TextBlock Classes="caption" Text="Base heat" />
                                <TextBox Classes="mono" Text="420" Width="132" HorizontalAlignment="Left" />
                                <ui:Alert Form="Inline"
                                          Title="Inherited from Arc Furnace Mk1." />
                            </StackPanel>
                        </StackPanel>

                        <HeaderedContentControl Theme="{StaticResource SectionLabel}"
                                                Header="IN PLACE"
                                                Content="the empty state" />

                        <TextBlock Classes="note"
                                   Text="The fourth form is an alert that replaces the content entirely, and it is already built. It is the empty state, on the surface it stands on rather than on a tint, so nothing was added for it." />

                        <ui:SurfacePanel Height="150">
                            <StackPanel Classes="emptyState">
                                <ui:Icon Glyph="AlertCircle" />
                                <TextBlock Text="This graph has no output pin" />
                                <TextBlock Text="Nothing downstream can read it until one is added." />
                                <Button Classes="primary" Content="Add output pin" />
                            </StackPanel>
                        </ui:SurfacePanel>
                    </StackPanel>
                </Border>

                <!-- section -->
                <TextBlock Classes="section" Text="WINDOW AND DIALOG" />
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="note"
                                   Text="This window is the shell itself. Drag the bar to move it, double click it to maximise, drag any edge to resize, and click another window to watch the whole chrome drop to the muted tier." />

                        <TextBlock Classes="note"
                                   Text="A dialog's buttons carry a role rather than a handler, so the dialog closes itself and says which was pressed. Enter presses the accepting one and Escape the cancelling one, both of them Avalonia's own. This dialog marks Cancel as the one that is ready, because accepting it is the destructive answer, and that takes Enter off Remove." />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Open a dialog" Click="OnOpenDialog" />
                            <Button Classes="ghost" Content="Maximise this window" Click="OnMaximize" />
                            <TextBlock Name="DialogAnswer" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- The window's eight regions, over the page and under nothing. Row 1 rather than
             both rows, so the title bar and its caption buttons stay reachable. It draws
             last, which is what puts a card over the page rather than under it. -->
        <ui:ToastHost Grid.Row="1" Name="WindowToasts" />
    </Grid>
</ui:ChromelessWindow>

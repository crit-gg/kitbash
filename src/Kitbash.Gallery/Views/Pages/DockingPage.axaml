<views:GalleryPage xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Kitbash.Ui.Controls;assembly=Kitbash.Ui"
                   xmlns:views="clr-namespace:Kitbash.Gallery.Views"
                   x:Class="Kitbash.Gallery.Views.Pages.DockingPage">

    <views:GalleryPage.DataTemplates>
        <!-- What a docked thing draws. A dockable is a view model and the shell finds its
             view by type, so the harness says here what a tool and a document look like. -->
        <DataTemplate DataType="views:HarnessTool">
            <TextBlock Classes="caption" Margin="11,9" Text="{Binding Body}" />
        </DataTemplate>
        <DataTemplate DataType="views:HarnessDocument">
            <TextBlock Classes="caption" Margin="11,9" Text="{Binding Body}" />
        </DataTemplate>
    </views:GalleryPage.DataTemplates>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="20">

            <!-- section -->
            <TextBlock Classes="section" Text="TABS" />
            <Border Classes="panel">
                <StackPanel Spacing="14">
                    <TextBlock Classes="note"
                               Text="The open tab is the only one that takes the page's surface and the only one that draws the accent marker. Both together, since either alone would be saying it in colour." />

                    <!-- The library's own panel rather than the page's, since a strip that fills a rounded
                         frame corner to corner is the case that needs two borders. -->
                    <ui:SurfacePanel Padding="0" Height="150">
                        <TabControl>
                            <TabItem Header="one.toml">
                                <TextBlock Classes="note" Margin="14"
                                           Text="A tab names a document, so its label is mono." />
                            </TabItem>
                            <TabItem Header="two.toml" Classes="modified">
                                <TextBlock Classes="note" Margin="14"
                                           Text="This one has unsaved changes, which is the round mark at its end." />
                            </TabItem>
                            <TabItem Header="three.toml" IsEnabled="False" />
                        </TabControl>
                    </ui:SurfacePanel>
                </StackPanel>
            </Border>

            <!-- section -->
            <TextBlock Classes="section" Text="DOCKING" />
            <Border Classes="panel">
                <StackPanel Spacing="14">
                    <TextBlock Classes="note"
                               Text="Docking is Dock for Avalonia under a Slate theme. A document tab carries the top marker and a close, a tool tab is a flat label sharing its strip with the dock's own buttons, and every division between docks is the seam until a pointer is on it." />

                    <ui:SurfacePanel Padding="0" Height="452" ClipToBounds="True">
                        <DockControl Name="Docking" />
                    </ui:SurfacePanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Float the inspector" Click="OnFloatTool" />
                        <Button Content="Pin the explorer" Click="OnPinTool" />
                        <Button Content="Close every document" Click="OnCloseDocuments" />
                        <Button Content="Build the layout again" Click="OnResetDock" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</views:GalleryPage>

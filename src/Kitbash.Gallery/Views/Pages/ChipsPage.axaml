<views:GalleryPage xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:Kitbash.Ui.Controls;assembly=Kitbash.Ui"
                   xmlns:views="clr-namespace:Kitbash.Gallery.Views"
                   x:Class="Kitbash.Gallery.Views.Pages.ChipsPage">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="20">

            <!-- section -->
            <TextBlock Classes="section" Text="CHIPS" />
            <Border Classes="panel">
                <StackPanel Spacing="14">
                    <TextBlock Classes="note"
                               Text="A chip says what is true. Removing it is the only thing that can be done to one, so the removable chips below really do go." />

                    <StackPanel Name="Chips" Orientation="Horizontal" Spacing="8">
                        <ui:Chip Content="machine" Mark="{DynamicResource Data}" IsRemovable="True" />
                        <ui:Chip Content="recipe" Mark="{DynamicResource Graph}" IsRemovable="True" />
                        <ui:Chip Content="attribute" Mark="{DynamicResource Warn}" IsRemovable="True" />
                        <ui:Chip Content="no mark" />
                        <ui:Chip Content="disabled" Mark="{DynamicResource Ok}" IsRemovable="True" IsEnabled="False" />
                    </StackPanel>

                    <TextBlock Classes="note"
                               Text="The round mark says the chip names a label somebody applied, and the square one says it names a thing. That is the same split the badge draws with its dot. The accent chip is a filter that is in force rather than a fact about a thing, so it carries the colour that means selected everywhere else and no mark at all." />

                    <StackPanel Name="ChipKinds" Orientation="Horizontal" Spacing="8">
                        <ui:Chip Classes="dot" Content="environment" Mark="{DynamicResource Ok}" IsRemovable="True" />
                        <ui:Chip Classes="dot" Content="character" Mark="{DynamicResource Warn}" IsRemovable="True" />
                        <ui:Chip Classes="dot" Content="wip" Mark="{DynamicResource Accent}" />
                        <ui:Chip Classes="accent" Content="owner is Mara" IsRemovable="True" />
                        <ui:Chip Classes="accent" Content="type is texture" IsRemovable="True" />

                        <!-- A count inside a chip, for one that is true of some of a
                             selection rather than all of it. -->
                        <ui:Chip Classes="dot" Mark="{DynamicResource Graph}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="lowpoly" />
                                <TextBlock Classes="chipCount" Text="3" />
                            </StackPanel>
                        </ui:Chip>

                        <Button Theme="{StaticResource ChipAddButton}" Content="Add" />
                    </StackPanel>

                    <Button Classes="ghost" Content="Put them back" Click="OnRestoreChips"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- section -->
            <TextBlock Classes="section" Text="BADGES" />
            <Border Classes="panel">
                <StackPanel Spacing="14">
                    <TextBlock Classes="note"
                               Text="A badge names something. It carries a word, an optional dot and no icon, which is what separates it from a status pill. If the colour is saying something the word does not, it is a status and belongs in a pill." />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:Badge Tier="Data" HasDot="True" Content=".NET" />
                        <ui:Badge Tier="Ok" Content="OPEN" />
                        <ui:Badge Tier="Modified" Content="READ ONLY" />
                        <ui:Badge Tier="Error" Content="MISSING" />
                        <ui:Badge Tier="Accent" HasDot="True" Content="PREVIEW" />
                        <ui:Badge Tier="Neutral" Content="LOCAL" />
                        <ui:Badge Tier="Ok" HasDot="True" Content="disabled" IsEnabled="False" />
                    </StackPanel>

                    <TextBlock Classes="note"
                               Text="Laid over a picture. Every tier is a tint picked to read on a surface the theme knows, and a thumbnail is any colour at all, so the fill becomes a scrim and the tier says its piece through the dot alone. The two swatches below are standing in for a thumbnail." />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="128" Height="72" CornerRadius="{DynamicResource RadiusSurface}"
                                Background="{DynamicResource Warn}">
                            <ui:Badge Classes="onMedia" Tier="Modified" HasDot="True" Content="IN REVIEW"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" />
                        </Border>
                        <Border Width="128" Height="72" CornerRadius="{DynamicResource RadiusSurface}"
                                Background="{DynamicResource SurfaceWell}">
                            <ui:Badge Classes="onMedia" Tier="Ok" HasDot="True" Content="APPROVED"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- section -->
            <TextBlock Classes="section" Text="STATUS PILLS" />
            <Border Classes="panel">
                <StackPanel Spacing="14">
                    <TextBlock Classes="note"
                               Text="Colour plus icon plus label, always. The tier chooses the colours and a default glyph, and naming a glyph overrides it. The last one shows that." />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:StatusPill Status="Ok" Text="synced" />
                        <ui:StatusPill Status="Modified" Text="modified" />
                        <ui:StatusPill Status="Error" Text="conflict" />
                        <ui:StatusPill Status="Accent" Text="checked out" />
                        <ui:StatusPill Status="Neutral" Text="archived" />
                        <ui:StatusPill Status="Ok" Text="main" Glyph="GitBranch" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- section -->
            <TextBlock Classes="section" Text="PROGRESS" />
            <Border Classes="panel">
                <StackPanel Spacing="14">
                    <TextBlock Classes="note"
                               Text="One bar, two modes. The travelling fill is 30 percent of the track and sweeps edge to edge." />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressBar Name="Determinate" Width="260" Value="40" VerticalAlignment="Center" />
                        <TextBlock Name="DeterminateValue" Classes="caption" VerticalAlignment="Center" />
                        <Button Classes="icon" Click="OnLess"
                                ToolTip.Tip="Less" AutomationProperties.Name="Less">
                            <ui:Icon Glyph="Minimize" />
                        </Button>
                        <Button Classes="icon" Click="OnMore"
                                ToolTip.Tip="More" AutomationProperties.Name="More">
                            <ui:Icon Glyph="Plus" />
                        </Button>
                    </StackPanel>

                    <ProgressBar Width="260" IsIndeterminate="True" HorizontalAlignment="Left" />

                    <TextBlock Classes="note"
                               Text="When the length is not known and there is no room for a bar, an icon turns instead. One turn every 1.1 seconds. Put it on the icon that names the work, so the row keeps its width." />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ui:Icon Glyph="RefreshCw" Classes="spin" Size="16"
                                 Foreground="{DynamicResource InkSecondary}" />
                        <ui:Icon Glyph="RefreshCw" Classes="spin" Size="20"
                                 Foreground="{DynamicResource Accent}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</views:GalleryPage>

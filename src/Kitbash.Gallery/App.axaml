<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kitbash.Gallery.App"
             RequestedThemeVariant="Dark">

    <!-- The look is added in code rather than here. Parsing it is the slowest thing this
         app does before any window exists, and the splash needs none of it, so it is
         loaded after the splash is already on screen. App.axaml.cs has the order. -->

</Application>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Workbench.Gallery.App"
             RequestedThemeVariant="Dark">

    <!-- One line, the same one every tool takes. The gallery holds no palette of its
         own, so anything that looks wrong here is wrong in the library. -->
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Workbench.Ui/Themes/WorkbenchTheme.axaml" />
    </Application.Styles>

</Application>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Focus in this system is one thing: a 2px halo of the accent at 30 percent, outside the
         border and never in place of one. -->

    <Style Selector=":is(Control)">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <!-- A halo reaches 2px past its control and an ItemsControl clips to its bounds, so a
         field stretched across a form row loses its ring down both sides. A view that wants
         the clip back writes it, since a local value beats a style. -->
    <Style Selector="ItemsControl">
        <Setter Property="ClipToBounds" Value="False" />
    </Style>

</Styles>

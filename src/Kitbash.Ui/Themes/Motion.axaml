<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kitbash.Ui.Controls">

    <!-- Movement that anything may ask for by name. Styles rather than control themes,
         since an animation belongs to a class and not to a type. -->

    <!-- Something is running and nobody knows for how long. -->
    <Style Selector="ui|Icon.spin">
        <Style.Animations>
            <Animation Duration="0:0:1.1" IterationCount="Infinite" Easing="LinearEasing">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

</Styles>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The small pieces a view puts inside a row, so a sidebar, a tree and a dropdown all
         say the same thing the same way.

         These are styles and not template parts on purpose. A row's modified mark is in the
         ListBoxItem template because a class can turn it on, and a count cannot: it is a
         value, and a value can only arrive as content. So the library owns what a count
         looks like and the view owns where it is. -->

    <!-- What a row says there is more of. Always trailing, always mono, and a rung quieter
         than the label it follows, since a count is read after the name and never instead
         of it. Never draw a zero: a row saying nothing is there is a row saying nothing. -->
    <Style Selector="TextBlock.rowCount">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!-- A count inside a chip, which sits on a fill rather than on the row, so it takes the
         chip's own ink one step down instead of the row ramp. -->
    <Style Selector="TextBlock.chipCount">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The two mark shapes, and the split between them is the one the chip and the badge
         already draw. Round is a label somebody applied, such as a tag or a status. Square
         names a thing, such as a kind or a collection. A view sets the colour, because the
         colour is the whole point of a mark and only the view knows it. -->
    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="{DynamicResource SizeMark}" />
        <Setter Property="Height" Value="{DynamicResource SizeMark}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.mark">
        <Setter Property="Width" Value="{DynamicResource SizeMark}" />
        <Setter Property="Height" Value="{DynamicResource SizeMark}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMark}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</Styles>

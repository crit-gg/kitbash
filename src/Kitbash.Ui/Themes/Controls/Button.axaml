<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Five button kinds, one control theme. The resting look is the setters, the kinds and
         the states are the nested styles, and nothing here is a plain type selector. -->

    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource HeightControl}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="BorderThickness" Value="1" />

        <!-- ContentControl clips to its bounds by default in Avalonia 12, which would cut the
             focus halo off flush with the border and leave a hard ring instead of one hugging the
             control. -->
        <Setter Property="ClipToBounds" Value="False" />

        <!-- Secondary is what a button is when it is not told otherwise. -->
        <Setter Property="Background" Value="{DynamicResource SurfaceNest2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />

        <Setter Property="Template">
            <ControlTemplate>
                <!-- The halo is a sibling with a negative margin rather than a border
                     around the frame, so focus costs no layout and the button stays the
                     height it was asked for. A Panel does not clip, so it draws. -->
                <Panel>
                    <Border Name="PART_Focus"
                            Margin="{DynamicResource FocusHaloReach}"
                            BorderThickness="{DynamicResource FocusHaloThickness}"
                            BorderBrush="Transparent"
                            CornerRadius="{DynamicResource RadiusControlHalo}"
                            IsHitTestVisible="False" />

                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            ClipToBounds="True">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- Secondary states. -->
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
        </Style>

        <!-- Primary, the one accent flood in the system. -->
        <Style Selector="^.primary">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
        </Style>

        <Style Selector="^.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
        </Style>

        <Style Selector="^.primary:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressed}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentInkPressed}" />
        </Style>

        <!-- The second lead. -->
        <Style Selector="^.neutral">
            <Setter Property="Background" Value="{DynamicResource Neutral}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NeutralLine}" />
            <Setter Property="Foreground" Value="{DynamicResource NeutralInk}" />
        </Style>

        <!-- The border holds through every live state, unlike primary and danger where it
             tracks the fill, so neither state below touches it. -->
        <Style Selector="^.neutral:pointerover">
            <Setter Property="Background" Value="{DynamicResource NeutralHover}" />
        </Style>

        <Style Selector="^.neutral:pressed">
            <Setter Property="Background" Value="{DynamicResource NeutralPressed}" />
        </Style>

        <!-- Ghost carries no fill and no border. The background is still set, because a
             control with none is not hit tested and the hover could never be reached. -->
        <Style Selector="^.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
        </Style>

        <Style Selector="^.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^.ghost:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <!-- Danger is the one solid fill outside primary. -->
        <Style Selector="^.danger">
            <Setter Property="Background" Value="{DynamicResource Destructive}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Destructive}" />
            <Setter Property="Foreground" Value="{DynamicResource DestructiveInk}" />
        </Style>

        <Style Selector="^.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource DestructiveHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DestructiveHover}" />
        </Style>

        <Style Selector="^.danger:pressed">
            <Setter Property="Background" Value="{DynamicResource DestructivePressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DestructivePressed}" />
            <Setter Property="Foreground" Value="{DynamicResource DestructiveInkPressed}" />
        </Style>

        <!-- Icon only. The size is the hit area, not the glyph, and the glyph takes its
             colour from here by inheritance. A tooltip and an accessible name are
             required on the view, since nothing here can supply the word. -->
        <Style Selector="^.icon">
            <Setter Property="Width" Value="{DynamicResource SizeIconButton}" />
            <Setter Property="Height" Value="{DynamicResource SizeIconButton}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
        </Style>

        <Style Selector="^.icon:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^.icon:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <!-- Focus is a halo outside the border, never in place of one. It answers the
             keyboard only, so clicking a button does not ring it. -->
        <Style Selector="^:focus-visible /template/ Border#PART_Focus">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>

        <!-- Disabled keeps the shape and flattens the fill. Never opacity. Declared
             last, so it beats every kind above it. -->
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>

        <!-- A kind with no fill has none to flatten, so it dims its text and stays flat
             rather than growing a box it never had. -->
        <Style Selector="^.ghost:disabled, ^.icon:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </ControlTheme>

    <!-- A button that stays down. Derived from the secondary button rather than read, since
         the design draws the kind once, and checked takes the pressed fill so a toggle that
         is on reads as a control held in rather than as a second kind of button. -->
    <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
        <Setter Property="Height" Value="{DynamicResource HeightControl}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="{DynamicResource SurfaceNest2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
        <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Focus"
                            Margin="{DynamicResource FocusHaloReach}"
                            BorderThickness="{DynamicResource FocusHaloThickness}"
                            BorderBrush="Transparent"
                            CornerRadius="{DynamicResource RadiusControlHalo}"
                            IsHitTestVisible="False" />

                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            ClipToBounds="True">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
        </Style>

        <Style Selector="^:checked">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource Neutral}" />
        </Style>

        <Style Selector="^:checked:pressed">
            <Setter Property="Background" Value="{DynamicResource NeutralHover}" />
        </Style>

        <Style Selector="^:focus-visible /template/ Border#PART_Focus">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>
    </ControlTheme>

    <!-- The short button, for the row of actions on a toast or an alert. -->
    <ControlTheme x:Key="CompactButton" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource HeightControlSmall}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource PaddingControlSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="{DynamicResource SurfaceNest3}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineControlDeep}" />
        <Setter Property="Foreground" Value="{DynamicResource InkChip}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Focus"
                            Margin="{DynamicResource FocusHaloReach}"
                            BorderThickness="{DynamicResource FocusHaloThickness}"
                            BorderBrush="Transparent"
                            CornerRadius="{DynamicResource RadiusControlHalo}"
                            IsHitTestVisible="False" />

                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            ClipToBounds="True">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
        </Style>

        <!-- The one accent button, and only where pressing it without reading the rest of
             the card is safe. -->
        <Style Selector="^.primary">
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
        </Style>

        <Style Selector="^.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
        </Style>

        <Style Selector="^.primary:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressed}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentInkPressed}" />
        </Style>

        <!-- The second lead, at 24px. Derived rather than read, since the design draws no neutral
             button on a toast or an alert. -->
        <Style Selector="^.neutral">
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            <Setter Property="Background" Value="{DynamicResource Neutral}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NeutralLine}" />
            <Setter Property="Foreground" Value="{DynamicResource NeutralInk}" />
        </Style>

        <Style Selector="^.neutral:pointerover">
            <Setter Property="Background" Value="{DynamicResource NeutralHover}" />
        </Style>

        <Style Selector="^.neutral:pressed">
            <Setter Property="Background" Value="{DynamicResource NeutralPressed}" />
        </Style>

        <!-- Accent text with a hover fill and no border, for the one action an undo bar
             carries. It is not a HyperlinkButton, which has no height and no fill of its
             own, because this sits in a row of 24px controls. -->
        <Style Selector="^.link">
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="^.link:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
        </Style>

        <Style Selector="^.link:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPressed}" />
        </Style>

        <Style Selector="^:focus-visible /template/ Border#PART_Focus">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>

        <Style Selector="^.link:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </ControlTheme>

</ResourceDictionary>

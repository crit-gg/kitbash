<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Kitbash.Ui.Controls">

    <!-- A word in a pill. Monospace, because a badge names a version, a runtime or an access
         rather than saying a sentence. -->
    <ControlTheme x:Key="{x:Type ui:Badge}" TargetType="ui:Badge">
        <Setter Property="Height" Value="{DynamicResource HeightPill}" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <!-- Centred so the tile kind puts its letter in the middle of a square.
                         A badge sizes to its content, so this changes nothing for one. -->
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Name="PART_Dot"
                                 Width="{DynamicResource SizeMark}"
                                 Height="{DynamicResource SizeMark}"
                                 VerticalAlignment="Center"
                                 IsVisible="{TemplateBinding HasDot}" />

                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Quieter than the status pill's neutral. A badge sits beside a name. -->
        <Style Selector="^.neutral">
            <Setter Property="Background" Value="{DynamicResource SurfaceNest2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
        </Style>

        <Style Selector="^.neutral /template/ Ellipse#PART_Dot">
            <Setter Property="Fill" Value="{DynamicResource InkSecondary}" />
        </Style>

        <Style Selector="^.ok">
            <Setter Property="Background" Value="{DynamicResource OkSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OkLine}" />
            <Setter Property="Foreground" Value="{DynamicResource OkInk}" />
        </Style>

        <Style Selector="^.ok /template/ Ellipse#PART_Dot">
            <Setter Property="Fill" Value="{DynamicResource Ok}" />
        </Style>

        <Style Selector="^.modified">
            <Setter Property="Background" Value="{DynamicResource WarnSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarnLine}" />
            <Setter Property="Foreground" Value="{DynamicResource WarnInk}" />
        </Style>

        <Style Selector="^.modified /template/ Ellipse#PART_Dot">
            <Setter Property="Fill" Value="{DynamicResource Warn}" />
        </Style>

        <Style Selector="^.error">
            <Setter Property="Background" Value="{DynamicResource ErrorSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorLine}" />
            <Setter Property="Foreground" Value="{DynamicResource ErrorInk}" />
        </Style>

        <Style Selector="^.error /template/ Ellipse#PART_Dot">
            <Setter Property="Fill" Value="{DynamicResource Error}" />
        </Style>

        <Style Selector="^.accent">
            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintLine}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTintInk}" />
        </Style>

        <Style Selector="^.accent /template/ Ellipse#PART_Dot">
            <Setter Property="Fill" Value="{DynamicResource Accent}" />
        </Style>

        <!-- Data names a fact rather than a judgement, which is why it is a tier here and
             not on the status pill. Its text is the mark colour itself, since the family
             carries no separate ink. -->
        <Style Selector="^.data">
            <Setter Property="Background" Value="{DynamicResource DataSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DataLine}" />
            <Setter Property="Foreground" Value="{DynamicResource Data}" />
        </Style>

        <Style Selector="^.data /template/ Ellipse#PART_Dot">
            <Setter Property="Fill" Value="{DynamicResource Data}" />
        </Style>

        <Style Selector="^.graph">
            <Setter Property="Background" Value="{DynamicResource GraphSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GraphLine}" />
            <Setter Property="Foreground" Value="{DynamicResource GraphInk}" />
        </Style>

        <Style Selector="^.graph /template/ Ellipse#PART_Dot">
            <Setter Property="Fill" Value="{DynamicResource Graph}" />
        </Style>

        <!-- Laid over a picture. Every tier above is a tint picked to read on a known
             surface, and a thumbnail is any colour at all, so the fill becomes a scrim and
             the tier is left to say its piece through the dot alone. Declared after the
             tiers, so a badge keeps its dot and loses its tint. -->
        <Style Selector="^.onMedia">
            <Setter Property="Background" Value="{DynamicResource ScrimMedia}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <!-- The square mark at the head of a row, carrying an initial rather than a word.
             It is the tiers again at a size the eye can run down a list on, so it takes
             the UI family where a badge takes mono: a letter standing for a name is not a
             value. Geometry and type only, so every tier still reaches it. -->
        <Style Selector="^.tile">
            <Setter Property="Width" Value="{DynamicResource SizeProjectTile}" />
            <Setter Property="Height" Value="{DynamicResource SizeProjectTile}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>

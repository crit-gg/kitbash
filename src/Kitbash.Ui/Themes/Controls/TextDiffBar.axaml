<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Kitbash.Ui.Controls">

    <!-- The buttons over a picked run of lines. It floats above the diff rather than sitting
         in it, so it takes the floating shadow and the popup's own fill, and it stands to the
         right where the text has run out. -->
    <ControlTheme x:Key="{x:Type ui:TextDiffBar}" TargetType="ui:TextDiffBar">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsVisible" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource SurfaceNest2}"
                        BorderBrush="{DynamicResource LineControl}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusControl}"
                        BoxShadow="{DynamicResource ShadowFloating}"
                        Margin="{DynamicResource MarginDiffBar}">
                    <StackPanel Orientation="Horizontal">
                        <Button Name="PART_Stage" Theme="{StaticResource CompactButton}" Content="Stage" />
                        <Button Name="PART_Unstage" Theme="{StaticResource CompactButton}" Content="Unstage" />
                        <Button Name="PART_Discard" Theme="{StaticResource CompactButton}" Content="Discard" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Throwing work away is the one that cannot be undone, so it is the one that reads
             as a warning under the pointer. -->
        <Style Selector="^ /template/ Button#PART_Discard:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource ErrorInk}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>

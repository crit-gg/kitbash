<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Kitbash.Ui.Controls">

    <!-- The remove button inside a chip. It is smaller than the icon button kind, since
         the chip it sits in is 21px and a 24px hit area would not fit. -->
    <ControlTheme x:Key="ChipRemoveButton" TargetType="Button">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMark}" />
        <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ui:Icon Glyph="X" Size="10" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ui:Chip}" TargetType="ui:Chip">
        <Setter Property="Height" Value="{DynamicResource HeightChip}" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SurfaceNest3}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineControlDeep}" />
        <Setter Property="Foreground" Value="{DynamicResource InkChip}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- A chip with no mark shows none rather than a blank square. -->
                        <Border Name="PART_Mark"
                                Width="{DynamicResource SizeMark}"
                                Height="{DynamicResource SizeMark}"
                                CornerRadius="{DynamicResource RadiusMark}"
                                Background="{TemplateBinding Mark}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding $parent[ui:Chip].Mark, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" />

                        <Button Name="PART_RemoveButton"
                                Theme="{StaticResource ChipRemoveButton}"
                                VerticalAlignment="Center"
                                IsVisible="{TemplateBinding IsRemovable}"
                                Command="{TemplateBinding RemoveCommand}"
                                CommandParameter="{TemplateBinding RemoveCommandParameter}"
                                ToolTip.Tip="Remove"
                                AutomationProperties.Name="Remove" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- A round mark. The square one says the chip names a thing, such as a machine or
             a file kind, and the round one says it names a label somebody applied. That is
             the same split the badge already draws with its dot. RadiusDot is half of
             SizeMark, so the square becomes a circle and nothing else moves. -->
        <Style Selector="^.dot /template/ Border#PART_Mark">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusDot}" />
        </Style>

        <!-- A filter that is in force, rather than a fact about a thing. It is the one chip
             a click removes something with, so it takes the accent the rest of the app uses
             for what is selected, and it carries no mark: the label is the whole of it. -->
        <Style Selector="^.accent">
            <Setter Property="Background" Value="{DynamicResource AccentTint}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTintLine}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTintInk}" />
        </Style>

        <Style Selector="^.accent /template/ Button#PART_RemoveButton">
            <Setter Property="Foreground" Value="{DynamicResource AccentTintInk}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>
    </ControlTheme>

    <!-- The chip shaped button that adds one. It is a Button and not a Chip, because a chip
         says what is true and this does something, which is the line the Chip doc draws.
         Everything about its box matches the chip beside it so a row of them stays even. -->
    <ControlTheme x:Key="ChipAddButton" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource HeightChip}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <!-- A rung below the chips beside it, which sit on SurfaceNest3, so it reads as the
             empty slot at the end of the row rather than as another value. It is the fill
             every control takes, which is what keeps it visible on a panel at any depth. -->
        <Setter Property="Background" Value="{DynamicResource SurfaceNest2}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Focus"
                            Margin="{DynamicResource FocusHaloReach}"
                            BorderThickness="{DynamicResource FocusHaloThickness}"
                            BorderBrush="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius, Converter={x:Static ui:HaloRadius.Grown}}"
                            IsHitTestVisible="False" />

                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            ClipToBounds="True">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ui:Icon Glyph="Plus"
                                     Size="{DynamicResource IconSizeCompact}"
                                     VerticalAlignment="Center" />

                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:focus-visible /template/ Border#PART_Focus">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kitbash.Ui.Controls">

    <Styles.Resources>

    <!-- What a control looks like when it is the whole content of a cell. Not new controls:
         each of these is a keyed theme over one the library already has, so a view writes
         Theme="{StaticResource GridCellText}" in its cell template and nothing else.

         Three rules hold the whole set together, and they are what to check a ninth type
         against:

         1. The cell owns every piece of chrome. A control in here draws no border, no
            radius, no padding and no fill of its own, because the cell is already drawing
            the hint, the ring and the well. Two frames inside a 31px row is what this
            avoids.
         2. Nothing inside a cell takes the control radius. The only radius left is on a
            chip and a checkbox, which are content rather than chrome.
         3. Alignment follows the column and the affordance takes the opposite edge, so a
            chevron never lands between two numbers.

         Every cell is 31px and flush to its column edges. Nothing is inset, so the hit
         target is the cell and never a smaller shape drawn inside it. -->

    <!-- boolean. A tick and never a labelled box, since the column title is the label. The
         box keeps its own radius because it is content. -->
    <ControlTheme x:Key="GridCellCheckBox" TargetType="CheckBox"
                  BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </ControlTheme>

    <!-- text. Nothing at all at rest, so a column of them reads as data. The cell's own ring
         is the only promise that a click puts a caret here. -->
    <ControlTheme x:Key="GridCellText" TargetType="TextBox"
                  BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </ControlTheme>

    <!-- number. Right aligned mono so the decimal points stack down the column. The stepper
         is the cell's, not this control's, so the spinner never comes on. -->
    <ControlTheme x:Key="GridCellNumber" TargetType="NumericUpDown"
                  BasedOn="{StaticResource {x:Type NumericUpDown}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ShowButtonSpinner" Value="False" />
    </ControlTheme>

    <!-- enum. Plain text with no frame. The chevron is the cell's, so this draws none of
         its own and the values still line up down the column. -->
    <ControlTheme x:Key="GridCellChoice" TargetType="ComboBox"
                  BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </ControlTheme>

    <!-- ratio. The bar is a cell background, edge to edge and square, so it never reads as
         a widget sitting on the value. ui:GridRatioCell is the whole cell. -->
    <ControlTheme x:Key="GridCellRatio" TargetType="ProgressBar"
                  BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0" />
    </ControlTheme>

    <!-- colour. Square and cell height less the padding, so the column reads as a strip of
         colour down the grid. No border at rest: the ring arrives with the pointer. -->
    <ControlTheme x:Key="GridCellColor" TargetType="ui:ColorField"
                  BasedOn="{StaticResource {x:Type ui:ColorField}}">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{DynamicResource SizeGridCellSwatch}" />
        <Setter Property="Height" Value="{DynamicResource SizeGridCellSwatch}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </ControlTheme>

    <!-- reference. A quiet button with no frame, for a view that wants the jump as a real
         button rather than as the cell's own mark. ui:GridRefCell is the whole cell. -->
    <ControlTheme x:Key="GridCellJump" TargetType="Button"
                  BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="{DynamicResource SizeGridCellJump}" />
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Opacity" Value="0" />

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
        </Style>
    </ControlTheme>

    <!-- tags. A chip keeps its own pill radius, because a chip is content and not chrome.
         Overflow counts rather than wraps, since the row height is fixed. -->
    <ControlTheme x:Key="GridCellTags" TargetType="ItemsControl">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="True" />

        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="5" />
            </ItemsPanelTemplate>
        </Setter>

        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- The three cell contents. A keyed theme cannot supply content, and these three types
         are content: a mark beside a name, a bar behind a value, chips with a count after
         them. Everything else in a cell is still a theme over a control. -->

    <!-- reference. A type mark and the name. The mark is 7px square at a 2px radius, which
         is the row mark's shape rather than a dot, so it reads as a kind and not a state. -->
    <ControlTheme x:Key="{x:Type ui:GridRefCell}" TargetType="ui:GridRefCell">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />

        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel LastChildFill="True">
                    <Border Name="PART_Mark"
                            DockPanel.Dock="Left"
                            Width="{DynamicResource SizeGridRefMark}"
                            Height="{DynamicResource SizeGridRefMark}"
                            Margin="0,0,7,0"
                            CornerRadius="{DynamicResource RadiusMark}"
                            VerticalAlignment="Center"
                            Background="{TemplateBinding Mark}"
                            IsVisible="{TemplateBinding Mark, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <TextBlock Text="{TemplateBinding Text}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ratio. The bar is the cell's background, edge to edge and square, and the value sits
         on it right aligned so a column of them still scans as numbers. -->
    <ControlTheme x:Key="{x:Type ui:GridRatioCell}" TargetType="ui:GridRatioCell">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Fill" Value="{DynamicResource Data}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- A progress bar rather than a border with a computed width, so the
                         fraction is laid out by the control that already does that. -->
                    <ProgressBar Name="PART_Bar"
                                 Theme="{StaticResource GridCellRatio}"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{TemplateBinding Reach}"
                                 Background="Transparent"
                                 Foreground="{TemplateBinding Fill}"
                                 Opacity="{DynamicResource OpacityGridRatioBar}"
                                 IsHitTestVisible="False" />

                    <TextBlock Text="{TemplateBinding Text}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- tags. Chips keep their pill radius because they are content, and what does not fit
         is counted rather than wrapped, since the row height is fixed. -->
    <ControlTheme x:Key="{x:Type ui:GridTagsCell}" TargetType="ui:GridTagsCell">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />

        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{TemplateBinding Drawn}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="ui:GridTag">
                                <ui:Chip Content="{Binding Text}" Classes.accent="{Binding IsLead}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Name="PART_Overflow"
                               Text="{TemplateBinding Overflow}"
                               FontFamily="{DynamicResource FontFamilyMono}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               FontWeight="{DynamicResource FontWeightMedium}"
                               Foreground="{DynamicResource InkMuted}"
                               VerticalAlignment="Center"
                               IsVisible="{TemplateBinding Overflow, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    </Styles.Resources>

    <!-- The cell is the shape now, so nothing inside one keeps a frame, a radius, padding or
         a focus halo of its own.

         These are set on the controls and not on their template parts. Every field draws its
         frame through a TemplateBinding and a TemplateBinding outranks a Style, so a rule
         aimed at PART_Frame is accepted and does nothing. The inner types are named as well
         as the outer ones, since a NumericUpDown holds a ButtonSpinner holding a TextBox and
         each one carries its own. -->
    <Style Selector=":is(ui|DataGridCell) TextBox,
                    :is(ui|DataGridCell) ComboBox,
                    :is(ui|DataGridCell) ButtonSpinner,
                    :is(ui|DataGridCell) NumericUpDown">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- No focus halo either. The cell already rings itself in the accent while it is being
         edited, and a halo outside that ring lands on the cells beside it. The halo's own
         thickness is a literal in each template, so what is taken away is its colour.

         Each state is named rather than left off. A style carrying a pseudo class is a
         trigger and outranks a plain style whatever the file order, so a stateless rule here
         is accepted and loses to the very rules it is meant to replace. -->
    <Style Selector=":is(ui|DataGridCell) TextBox:focus-within /template/ Border#PART_Halo,
                    :is(ui|DataGridCell) ComboBox:focus-within /template/ Border#PART_Halo,
                    :is(ui|DataGridCell) ButtonSpinner:focus-within /template/ Border#PART_Halo,
                    :is(ui|DataGridCell) NumericUpDown:focus-within /template/ Border#PART_Halo,
                    :is(ui|DataGridCell) TextBox:focus-visible /template/ Border#PART_Halo,
                    :is(ui|DataGridCell) ComboBox:focus-visible /template/ Border#PART_Halo,
                    :is(ui|DataGridCell) ButtonSpinner:focus-visible /template/ Border#PART_Halo,
                    :is(ui|DataGridCell) NumericUpDown:focus-visible /template/ Border#PART_Halo,
                    :is(ui|DataGridCell) CheckBox:focus-visible /template/ Border#PART_Focus,
                    :is(ui|DataGridCell) Button:focus-visible /template/ Border#PART_Focus">
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- The chevron is the cell's, so the field draws none of its own and there is never a
         pair of them on one edge. -->
    <Style Selector=":is(ui|DataGridCell) ComboBox /template/ ui|Icon#PART_Chevron">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- The bar steps up with the row, so a hovered row reads as one thing rather than as a
         value that brightened over a bar that did not. -->
    <Style Selector="ui|DataGridRow:pointerover ui|GridRatioCell /template/ ProgressBar#PART_Bar,
                     ui|TreeDataGridRow:pointerover ui|GridRatioCell /template/ ProgressBar#PART_Bar">
        <Setter Property="Opacity" Value="{DynamicResource OpacityGridRatioBarHover}" />
    </Style>

    <!-- A read only reference keeps its name and loses the colour of its kind, since the
         kind is still true and the row is not something that can be opened. -->
    <Style Selector=":is(ui|DataGridCell):not(:editable) ui|GridRefCell /template/ Border#PART_Mark">
        <Setter Property="Background" Value="{DynamicResource LineWellOff}" />
    </Style>

    <!-- A chip inside a cell is shorter than one on a page, since a row is 31px and two of
         them plus the cell padding have to sit inside it. -->
    <Style Selector=":is(ui|DataGridCell) ui|Chip">
        <Setter Property="Height" Value="{DynamicResource HeightGridCellChip}" />
    </Style>

    <!-- The box brightens under the pointer, which is the only step a tick has, since it
         has no text to lift and no frame to close. -->
    <Style Selector=":is(ui|DataGridCell):pointerover CheckBox:checked /template/ Border#PART_Box">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
    </Style>

    <!-- The swatch takes a ring on cell hover and the accent while the picker is open, since
         a square of colour has no other way to say it can be changed. -->
    <Style Selector=":is(ui|DataGridCell):pointerover ui|ColorField">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineWell}" />
    </Style>

    <Style Selector=":is(ui|DataGridCell):editing ui|ColorField">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <!-- Text in a cell trims rather than clipping mid glyph, whatever a view wrote, since a
         column is a fixed width and a value is not, and what was trimmed is in the tooltip.
         A view that wants wrapping says so on its own TextBlock, which outranks this.
         :is, because a tree grid's cell is a DataGridCell of its own kind. -->
    <Style Selector=":is(ui|DataGridCell) TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="(ui:TextTip.Shows)" Value="True" />
    </Style>

    <!-- Error beats trimmed, the way it beats focus for the ring. The cell carries the
         error's tooltip and an inner one on the text would win over it, so the text gives
         its up while the cell has something wrong to say. -->
    <Style Selector=":is(ui|DataGridCell):error TextBlock">
        <Setter Property="(ui:TextTip.Shows)" Value="False" />
    </Style>

    <!-- Trimming only. A title sits in a row of furniture that hands it infinite width, so it
         is the cell's ClipToBounds that cuts it and nothing here can tell that it happened. -->
    <Style Selector="ui|DataGridHeaderCell TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

</Styles>

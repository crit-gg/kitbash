<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Kitbash.Ui.Controls">

    <!-- A ramp in a well. It is a button, so it takes the field's frame and the button's
         own live states, and its editor opens over it rather than in a window. -->
    <ControlTheme x:Key="{x:Type ui:CurveField}" TargetType="ui:CurveField">
        <Setter Property="Height" Value="{DynamicResource HeightControl}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SurfaceWell}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Halo"
                            Margin="{DynamicResource FocusHaloReach}"
                            BorderThickness="{DynamicResource FocusHaloThickness}"
                            BorderBrush="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius, Converter={x:Static ui:HaloRadius.Grown}}"
                            IsHitTestVisible="False" />

                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Panel Margin="1">
                            <!-- The stops, when there are any. -->
                            <Border Name="PART_Wash" Background="{TemplateBinding Wash}" />

                            <!-- The line through the points otherwise. Only one of the two
                                 is ever there, since the control draws whichever it holds. -->
                            <Path Name="PART_Trace"
                                  Data="{TemplateBinding Trace}"
                                  Stroke="{DynamicResource CurveLine}"
                                  StrokeThickness="{DynamicResource ThicknessCurveLine}"
                                  StrokeJoin="Round"
                                  StrokeLineCap="Round" />
                        </Panel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#PART_Frame">
            <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
        </Style>

        <Style Selector="^:focus-visible /template/ Border#PART_Halo">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#PART_Frame">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlOff}" />
        </Style>

        <Style Selector="^:disabled /template/ Path#PART_Trace">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

</ResourceDictionary>

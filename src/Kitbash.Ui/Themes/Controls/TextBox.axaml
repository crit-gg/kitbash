<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kitbash.Ui.Controls">

    <Styles.Resources>

    <!-- Every field that takes typing. A well is darker than everything around it and does not
         ride the depth ramp, so it reads as recessed at any level. -->

    <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
        <Setter Property="Height" Value="{DynamicResource HeightControl}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Background" Value="{DynamicResource SurfaceWell}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource InkMuted}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="IBeam" />

        <!-- The row tint and its ink, so a selection matches the rest of the system. -->
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentTint}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelectionInk}" />

        <!-- Off, so the focus halo is not cut flush with the border. -->
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- The halo's radius is grown from the control's rather than named,
                         so a field with a wider radius keeps a ring concentric with it.
                         The search field is 8 where every other field is 5. -->
                    <Border Name="PART_Halo"
                            Margin="{DynamicResource FocusHaloReach}"
                            BorderThickness="{DynamicResource FocusHaloThickness}"
                            BorderBrush="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius, Converter={x:Static ui:HaloRadius.Grown}}"
                            IsHitTestVisible="False" />

                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <DockPanel LastChildFill="True">
                            <ContentPresenter Name="PART_InnerLeft"
                                              DockPanel.Dock="Left"
                                              Content="{TemplateBinding InnerLeftContent}"
                                              VerticalAlignment="Center" />

                            <ContentPresenter Name="PART_InnerRight"
                                              DockPanel.Dock="Right"
                                              Content="{TemplateBinding InnerRightContent}"
                                              VerticalAlignment="Center" />

                            <Panel Margin="{TemplateBinding Padding}">
                                <!-- A placeholder is language, not a value, so it stays in
                                     the UI family even where the value is mono. -->
                                <TextBlock Name="PART_Placeholder"
                                           Text="{TemplateBinding PlaceholderText}"
                                           Foreground="{TemplateBinding PlaceholderForeground}"
                                           FontFamily="{DynamicResource FontFamilyUi}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center"
                                           IsVisible="False"
                                           IsHitTestVisible="False" />

                                <ScrollViewer Name="PART_ScrollViewer"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden">
                                    <TextPresenter Name="PART_TextPresenter"
                                                   Text="{TemplateBinding Text, Mode=TwoWay}"
                                                   CaretIndex="{TemplateBinding CaretIndex}"
                                                   CaretBrush="{TemplateBinding CaretBrush}"
                                                   SelectionStart="{TemplateBinding SelectionStart}"
                                                   SelectionEnd="{TemplateBinding SelectionEnd}"
                                                   SelectionBrush="{TemplateBinding SelectionBrush}"
                                                   SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                                   PasswordChar="{TemplateBinding PasswordChar}"
                                                   RevealPassword="{TemplateBinding RevealPassword}"
                                                   TextAlignment="{TemplateBinding TextAlignment}"
                                                   TextWrapping="{TemplateBinding TextWrapping}"
                                                   LineHeight="{TemplateBinding LineHeight}"
                                                   VerticalAlignment="Center" />
                                </ScrollViewer>
                            </Panel>
                        </DockPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- The control says when it holds nothing, so the placeholder needs no converter. -->
        <Style Selector="^:empty /template/ TextBlock#PART_Placeholder">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
        </Style>

        <!-- focus-within rather than focus, since what actually takes focus is the
             presenter inside the template. -->
        <Style Selector="^:focus-within">
            <Setter Property="Background" Value="{DynamicResource SurfaceWellFocus}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControl}" />
        </Style>

        <Style Selector="^:focus-within /template/ Border#PART_Halo">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>

        <!-- A plain field holds language, so it takes the UI family. -->
        <Style Selector="^.mono">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        </Style>

        <!-- What a field looks like when what is in it will not do. -->
        <Style Selector="^[(DataValidationErrors.HasErrors)=True]">
            <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
            <Setter Property="Foreground" Value="{DynamicResource Error}" />
        </Style>

        <Style Selector="^.error">
            <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
            <Setter Property="Foreground" Value="{DynamicResource Error}" />
        </Style>

        <!-- The value is allowed and the world is wrong, so the text stays readable and only
             the edge says so. -->
        <Style Selector="^.warn">
            <Setter Property="BorderBrush" Value="{DynamicResource Warn}" />
        </Style>

        <!-- A field nothing can be typed into. It is not the disabled look: the text keeps
             its tone and anything beside the field still works. -->
        <Style Selector="^[IsReadOnly=True]">
            <Setter Property="Background" Value="{DynamicResource SurfaceWellOff}" />
            <Setter Property="CaretBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
            <Setter Property="PlaceholderForeground" Value="{DynamicResource InkDisabled}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <!-- A control theme is found by the exact type and never falls back to a base one, so
         a derived text box needs its own even when it wants the same look. -->
    <ControlTheme x:Key="{x:Type MaskedTextBox}" TargetType="MaskedTextBox"
                  BasedOn="{StaticResource {x:Type TextBox}}" />

    <!-- The one field with a wider radius in the design, which is what makes a filter read
         as a filter rather than as another property. The mark and the clear button live in
         the template rather than in the view, so every search field carries both. -->
    <ControlTheme x:Key="{x:Type ui:SearchBox}" TargetType="ui:SearchBox"
                  BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />

        <Setter Property="InnerLeftContent">
            <Template>
                <ui:Icon Glyph="Search"
                         Size="{DynamicResource IconSizeField}"
                         Margin="9,0,0,0"
                         VerticalAlignment="Center" />
            </Template>
        </Setter>

        <Setter Property="InnerRightContent">
            <Template>
                <Button Name="PART_Clear"
                        Theme="{StaticResource FieldButton}"
                        Margin="0,0,4,0"
                        ToolTip.Tip="Clear"
                        AutomationProperties.Name="Clear">
                    <ui:Icon Glyph="X" Size="{DynamicResource IconSizeCompact}" />
                </Button>
            </Template>
        </Setter>
    </ControlTheme>

    <!-- A mark inside a well that can be pressed. Keyed rather than a class on the button
         theme, for the reason the caption buttons are keyed: this is smaller than any
         button in the system and would inherit every height that theme gains. -->
    <ControlTheme x:Key="FieldButton" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMark}" />
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Arrow" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MarkOff}" />
        </Style>
    </ControlTheme>

    <!-- One path or none, with a browse button beside it. Here rather than in a file of its
         own, because it is a well and it shares the clear button above. -->
    <ControlTheme x:Key="{x:Type ui:PathField}" TargetType="ui:PathField">
        <Setter Property="HorizontalAlignment" Value="Stretch" />

        <!-- A templated control clips to its bounds in Avalonia 12, which would cut the
             well's focus halo off flush with its edge. -->
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Panel Grid.Column="0">
                            <TextBox Name="PART_Field"
                                     Classes="mono"
                                     Classes.error="{TemplateBinding IsInvalid}"
                                     Classes.warn="{TemplateBinding IsWarned}"
                                     Text="{Binding Path, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                     PlaceholderText="{TemplateBinding Prompt}"
                                     IsReadOnly="{TemplateBinding IsLocked}"
                                     ToolTip.Tip="{TemplateBinding Tip}">
                                <TextBox.InnerRightContent>
                                    <!-- Inner content is not a template child, so this
                                         button is shown from a plain style below. -->
                                    <Button Name="PART_Clear"
                                            Theme="{StaticResource FieldButton}"
                                            Margin="0,0,4,0"
                                            ToolTip.Tip="Clear"
                                            AutomationProperties.Name="Clear">
                                        <ui:Icon Glyph="X" Size="{DynamicResource IconSizeCompact}" />
                                    </Button>
                                </TextBox.InnerRightContent>
                            </TextBox>

                            <!-- Over the well rather than beside it, so the field says what a
                                 drop would do instead of showing a path that is about to go. -->
                            <Panel Name="PART_Drop" IsVisible="{TemplateBinding IsDropping}">
                                <Border Background="{DynamicResource SurfaceDrop}"
                                        CornerRadius="{DynamicResource RadiusControl}" />

                                <!-- A Border cannot draw a dashed edge, so the outline is a
                                     Rectangle over the fill. -->
                                <Rectangle Stroke="{DynamicResource Accent}"
                                           StrokeThickness="1"
                                           StrokeDashArray="3,2"
                                           RadiusX="{DynamicResource SizeRadiusControl}"
                                           RadiusY="{DynamicResource SizeRadiusControl}" />

                                <TextBlock Text="{TemplateBinding DropWord}"
                                           Margin="9,0"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource AccentTintInk}"
                                           VerticalAlignment="Center" />
                            </Panel>
                        </Panel>

                        <Button Name="PART_Browse" Grid.Column="1"
                                AutomationProperties.Name="Browse">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:Icon Glyph="FolderOpen" Size="{DynamicResource IconSizeField}" />
                                <TextBlock Name="PART_Word" Text="Browse"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- The problem replaces the hint rather than adding a second line. -->
                    <DockPanel Name="PART_Note" IsVisible="{TemplateBinding HasNote}">
                        <ui:Icon Name="PART_NoteMark" DockPanel.Dock="Left"
                                 Glyph="AlertCircle"
                                 Size="{DynamicResource IconSizeStatus}"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 IsVisible="False" />

                        <TextBlock Name="PART_NoteText"
                                   Text="{TemplateBinding Note}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource InkMuted}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.error /template/ ui|Icon#PART_NoteMark">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Glyph" Value="AlertCircle" />
            <Setter Property="Foreground" Value="{DynamicResource Error}" />
        </Style>

        <Style Selector="^.error /template/ TextBlock#PART_NoteText">
            <Setter Property="Foreground" Value="{DynamicResource ErrorInk}" />
        </Style>

        <Style Selector="^.warn /template/ ui|Icon#PART_NoteMark">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Glyph" Value="AlertTriangle" />
            <Setter Property="Foreground" Value="{DynamicResource Warn}" />
        </Style>

        <Style Selector="^.warn /template/ TextBlock#PART_NoteText">
            <Setter Property="Foreground" Value="{DynamicResource WarnInk}" />
        </Style>

        <!-- The word goes where the column is too narrow for it, such as an inspector row. -->
        <Style Selector="^.compact /template/ Button#PART_Browse">
            <Setter Property="Width" Value="{DynamicResource HeightControl}" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="^.compact /template/ TextBlock#PART_Word">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>

    </Styles.Resources>

    <!-- A field that takes prose. Every other field is one line of a value, and this one is a
         paragraph, so it drops the fixed height for a floor and grows downward. The well, the
         border and the focus ramp are the field's own, because a notes box is a field. -->
    <Style Selector="TextBox.notes">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinHeight" Value="{DynamicResource HeightNotes}" />
        <Setter Property="Padding" Value="{DynamicResource PaddingNotes}" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- TextWrapping on its own does nothing here. The template's scroll viewer is written
         Hidden rather than Disabled, which still scrolls, so it measures the presenter at
         infinite width and no line ever runs out of room. Disabled is what constrains it. -->
    <Style Selector="TextBox.notes /template/ ScrollViewer#PART_ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- The presenter is centred by a constant in the template, so a paragraph in a box that
         has grown would float in the middle of it. A class carries an activator and a
         constant does not, which is the only reason this can reach past it. -->
    <Style Selector="TextBox.notes /template/ TextPresenter#PART_TextPresenter">
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- A search field holding a query language rather than words. The mono family is the
         same rule every value editor follows: a thing with a syntax is not prose. -->
    <Style Selector="ui|SearchBox.query">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
    </Style>

    <!-- Nothing to clear, so nothing to press. Out here rather than inside the theme, and both
         halves of that are forced. -->
    <Style Selector="ui|SearchBox:empty Button#PART_Clear">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- The path field's clear button, out here for the same reason. There is something to
         clear, the field is not being typed in, and the control is on. -->
    <Style Selector="ui|PathField Button#PART_Clear">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ui|PathField.clearable Button#PART_Clear">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Every field that takes typing, including the ones inside a spinner and a picker.
         :is, so a derived field is covered without a style of its own. -->
    <Style Selector=":is(TextBox)">
        <Setter Property="(ui:TextMenu.Shows)" Value="True" />
    </Style>

</Styles>

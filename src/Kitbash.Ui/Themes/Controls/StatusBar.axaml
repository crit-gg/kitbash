<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kitbash.Ui.Controls">

    <Styles.Resources>

    <!-- The status bar is 32px including its seam, so nothing in it can be the 26px a control
         is everywhere else. -->

    <!-- A readout that does something. The update action, and anything else the row gains.
         Quiet at rest, so the row reads as one strip rather than a line of buttons, and it
         lifts on hover the way every other surface does. -->
    <ControlTheme x:Key="StatusBarButton" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource HeightTooltip}" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SurfaceNest2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineSeam}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Foreground" Value="{DynamicResource InkChip}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Arrow" />

        <!-- Off, so the focus halo is not cut flush with the border. -->
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_Halo"
                            Margin="{DynamicResource FocusHaloReach}"
                            BorderThickness="{DynamicResource FocusHaloThickness}"
                            BorderBrush="Transparent"
                            CornerRadius="{DynamicResource RadiusControlHalo}" />

                    <Border Name="PART_Root"
                            ClipToBounds="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource StateHover}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource StatePressed}" />
        </Style>

        <Style Selector="^:focus-visible /template/ Border#PART_Halo">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusHalo}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceControlOff}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineControlOff}" />
            <Setter Property="Foreground" Value="{DynamicResource InkDisabled}" />
        </Style>
    </ControlTheme>

    </Styles.Resources>

    <!-- The readouts along the row. -->
    <Style Selector="StackPanel.countReadout">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Where you are. A readout and nothing else: no border, no chevron and no hover,
         because changing branch belongs to a git tool and this only reports. -->
    <Style Selector="TextBlock.branch">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Beside the update action, saying when it last looked rather than what it does. -->
    <Style Selector="TextBlock.updateAge">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ui|Icon.countMark">
        <Setter Property="Size" Value="{DynamicResource IconSizeStatus}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.count">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource InkPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.countLabel">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The one readout that has to be noticed rather than read. Everything else in a status
         bar is worth knowing, a conflict blocks work, so it leaves the row of counts and
         takes a tinted chip. Still only a readout: it says a thing, it does not do one. -->
    <Style Selector="Border.conflictChip">
        <Setter Property="Height" Value="{DynamicResource HeightTooltip}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="{DynamicResource ErrorSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSurface}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.conflictChip TextBlock.count">
        <Setter Property="Foreground" Value="{DynamicResource ErrorInk}" />
    </Style>

    <Style Selector="Border.conflictChip TextBlock.countLabel">
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorInk}" />
    </Style>

</Styles>

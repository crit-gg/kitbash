<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
                    xmlns:ui="clr-namespace:Kitbash.Ui.Controls">

    <!-- A diff is a document rather than a list of things, so the rows are flush against each
         other and against the frame: no radius, no gap, no rule. What tells one line from the
         next is the mark down its left and the fill behind it.

         The editor's own theme draws the frame and the text. Everything below is either a
         token over it or one of the eight kinds, and a kind is always four things together:
         the fill, the mark, the ink and what a changed word sits on. -->
    <ControlTheme x:Key="{x:Type ui:TextDiff}" TargetType="ui:TextDiff"
                  BasedOn="{StaticResource {x:Type ae:TextEditor}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource PaddingDiff}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}" />
        <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
        <Setter Property="NumberInk" Value="{DynamicResource InkDisabled}" />
        <Setter Property="MarkWidth" Value="{DynamicResource WidthDiffMark}" />
        <Setter Property="LineHeightFactor" Value="{DynamicResource FactorDiffLine}" />

        <!-- Selection is what a person is about to act on, so it beats the kind's own fill.
             The mark stays, since it still says what the line is. -->
        <Setter Property="SelectionFill" Value="{DynamicResource AccentTintStrong}" />
        <Setter Property="SelectionInk" Value="{DynamicResource SelectionInk}" />

        <Setter Property="ContextStyle">
            <ui:TextDiffKindStyle Ink="{StaticResource InkSecondary}" />
        </Setter>

        <Setter Property="AddedStyle">
            <ui:TextDiffKindStyle Fill="{StaticResource OkSurface}"
                                  Mark="{StaticResource Ok}"
                                  Ink="{StaticResource OkInk}"
                                  Highlight="{StaticResource OkLine}" />
        </Setter>

        <Setter Property="RemovedStyle">
            <ui:TextDiffKindStyle Fill="{StaticResource ErrorSurface}"
                                  Mark="{StaticResource Error}"
                                  Ink="{StaticResource ErrorInk}"
                                  Highlight="{StaticResource ErrorLine}" />
        </Setter>

        <Setter Property="OursStyle">
            <ui:TextDiffKindStyle Fill="{StaticResource AccentTint}"
                                  Mark="{StaticResource Accent}"
                                  Ink="{StaticResource AccentTintInk}"
                                  Highlight="{StaticResource AccentTintStrong}" />
        </Setter>

        <Setter Property="TheirsStyle">
            <ui:TextDiffKindStyle Fill="{StaticResource WarnSurface}"
                                  Mark="{StaticResource Warn}"
                                  Ink="{StaticResource WarnInk}"
                                  Highlight="{StaticResource WarnLine}" />
        </Setter>

        <!-- A decision somebody made, which reads as settled rather than as either side. -->
        <Setter Property="ChosenStyle">
            <ui:TextDiffKindStyle Fill="{StaticResource OkSurface}"
                                  Mark="{StaticResource Ok}"
                                  Ink="{StaticResource OkInk}" />
        </Setter>

        <!-- Settled without asking, so it is there to be read past rather than read. -->
        <Setter Property="SettledStyle">
            <ui:TextDiffKindStyle Mark="{StaticResource LineSeam}"
                                  Ink="{StaticResource InkMuted}" />
        </Setter>

        <!-- The heading over a run. Not a line of the file, so it carries no number. -->
        <Setter Property="HeadingStyle">
            <ui:TextDiffKindStyle Fill="{StaticResource SurfaceNest1}"
                                  Ink="{StaticResource InkDisabled}" />
        </Setter>
    </ControlTheme>

</ResourceDictionary>

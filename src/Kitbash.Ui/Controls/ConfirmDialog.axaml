<ui:DialogWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:Kitbash.Ui.Controls"
                 x:Class="Kitbash.Ui.Controls.ConfirmDialog"
                 Width="440" SizeToContent="Height"
                 FontFamily="{StaticResource FontFamilyUi}"
                 FontSize="{StaticResource FontSizeBody}">

    <ui:DialogWindow.Styles>
        <Style Selector="ui|Icon.mark">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="ui|Icon.mark.grave">
            <Setter Property="Foreground" Value="{DynamicResource Error}" />
        </Style>
    </ui:DialogWindow.Styles>

    <!-- A question and its two answers. The glyph carries how much is at stake, so the
         wording does not have to shout it. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <ui:WindowTitleBar Grid.Row="0" Title="{Binding $parent[Window].Title}" />

        <Grid Grid.Row="1" ColumnDefinitions="20,*" ColumnSpacing="11" Margin="16,16,16,15">
            <ui:Icon Grid.Column="0" Name="Mark" Classes="mark" Glyph="InfoCircle" Size="20"
                     VerticalAlignment="Top" />

            <StackPanel Grid.Column="1" Spacing="7">
                <TextBlock Name="Heading"
                           FontSize="{DynamicResource FontSizeSubhead}"
                           FontWeight="{DynamicResource FontWeightStrong}"
                           Foreground="{DynamicResource InkPrimary}"
                           TextWrapping="Wrap" />

                <TextBlock Name="Detail"
                           Foreground="{DynamicResource InkSecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <ui:DialogFooter Grid.Row="2">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Name="Otherwise" Content="" IsVisible="False" ui:Dialog.Role="Alternate" />
                <Button Name="Refuse" Content="Cancel" ui:Dialog.Role="Cancel" />
                <Button Name="Accept" Classes="primary" Content="Continue" ui:Dialog.Role="Accept" />
            </StackPanel>
        </ui:DialogFooter>
    </Grid>
</ui:DialogWindow>

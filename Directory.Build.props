<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- A placeholder for local builds only. A release version is worked out from git
         history by CI and arrives as KITBASH_VERSION. Velopack refuses a fourth part. -->
    <Version>0.0.1-alpha</Version>
    <!-- The first covers the compilers, the second covers every other task,
         which is what turns an Avalonia XAML or a NuGet warning into a failure. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
